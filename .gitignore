# Build artifacts
/target/
/target-llvm/
**/target/
**/build/
# Source-tree subcommand directories that collide with the cargo build-dir
# patterns above. Add a negative rule for each subcommand directory under
# `compiler/oric/src/commands/` whose name matches `target` or `build`.
# Without these, `git add` silently ignores newly-added files in these
# directories, requiring `-f` and confusing contributors.
!compiler/oric/src/commands/build/
!compiler/oric/src/commands/target/

# Cargo lock for libraries (keep for binaries)
# Cargo.lock  # We keep this since we have a binary

# Reference repos (local development only)
/_repos/
/REFERENCE/
/reference/

# Comparison/benchmark data (local development)
/comparison/
/samples/
/examples/*.si
!/examples/

# Editor and IDE
*.swp
*.swo
*~
.idea/
*.iml
.vscode/
.vs/
*.sublime-*
.project
.settings/
.vim/
.helix/
.zed/

# OS files
.DS_Store
desktop.ini
Thumbs.db

# Rust specific
**/*.rs.bk
*.pdb
librust_out.a
rust_out.lib

# Local configuration
.cargo/
.env
.env.*
!.env.example

# Test artifacts
*.profraw
*.profdata
/test_cast*

# Generated files
*.generated.*

# ICE reports
rustc-ice-*.txt

# Temporary files
*.tmp
*.log
!std.log/
*.temp

# Debug/IR dump files (from ORI_DUMP_AFTER_*, manual debugging)
*.ll
*.bc
*.dump
*.ir
*.llvm-ir
/llvm_dump*

# One-off scratch files at repo root
/test_*.py
/test_*.sh
/scratch.*
/scratch_*
/temp.*
/temp_*
/tmp.*
/tmp_*
/hack.*
/hack_*
/wip.*
/wip_*

# Build artifacts outside target/
/*.o
/*.a
/*.so
/*.dylib

# Core dumps
core
core.*

# Editor merge/backup artifacts
*.orig
*.bak
*.rej

# Python
__pycache__/
*.pyc
venv/
.venv/

#claude
.claude/discussions
.claude/worktrees/
scratchpad