@gcd (a: int, b: int) -> int = {
    if b == 0 then a else gcd(a: b, b: a % b)
};

@main () -> int = {
    let r = 0;
    if gcd(a: 48, b: 18) != 6 then r = 1;
    if gcd(a: 100, b: 75) != 25 then r = 1;
    if gcd(a: 17, b: 13) != 1 then r = 1;
    if gcd(a: 0, b: 5) != 5 then r = 1;
    if gcd(a: 7, b: 0) != 7 then r = 1;
    r
}
