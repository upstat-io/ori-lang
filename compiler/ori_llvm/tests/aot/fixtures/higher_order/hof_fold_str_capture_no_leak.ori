// Higher-order fold with str capture no-leak.
// `xs.fold(initial:, op: lambda)` invokes op N times via ApplyIndirect.
// Strongest stress test on the multi-call closure path because fold
// threads through every list element. Captured str + closure environment
// must show zero leaks under ORI_CHECK_LEAKS=1 post-fix.
@main () -> int = {
    let captured = "captured_heap_string_for_fold";
    let lambda = (acc: int, x: int) -> int = if captured.contains(substr: "fold") then acc + x else acc;
    let xs: [int] = [1, 2, 3, 4, 5];
    let total = xs.iter().fold(0, lambda);
    if total == 15 then 0 else 1
}
