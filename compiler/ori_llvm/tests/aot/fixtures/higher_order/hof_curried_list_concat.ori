// Root Cause F regression: curried lambda with list `+` (ori_list_concat_cow).
// Previously segfaulted when type selection picked wrong concrete type.

@main () -> int = {
    let $app = a -> b -> a + b;
    let $result = app([1, 2, 3])([4, 5, 6]);
    if result == [1, 2, 3, 4, 5, 6] then 0 else 1
}
