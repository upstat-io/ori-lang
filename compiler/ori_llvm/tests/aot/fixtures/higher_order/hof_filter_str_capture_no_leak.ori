// BUG-04-106 §03:69 — higher-order filter with str capture no-leak.
// `xs.filter(predicate: lambda)` invokes the predicate N times via
// ApplyIndirect, exercising the multi-call closure path. Captured str +
// closure environment must show zero leaks under ORI_CHECK_LEAKS=1
// post-fix.
@main () -> int = {
    let captured = "captured_heap_string_for_filter";
    let lambda = (x: int) -> bool = if captured.contains(substr: "filter") then x > 2 else false;
    let xs: [int] = [1, 2, 3, 4, 5];
    let ys: [int] = xs.iter().filter(lambda).collect();
    if len(collection: ys) == 3 then 0 else 1
}
