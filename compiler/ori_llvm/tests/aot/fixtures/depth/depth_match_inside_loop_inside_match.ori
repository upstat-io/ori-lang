@main () -> int = {
    let result = match true {
        true -> {
            let sum = 0;
            for i in 0..5 do {
                let contribution = match i % 3 {
                    0 -> 1,
                    1 -> 10,
                    _ -> 100,
                };
                sum = sum + contribution
            };
            sum
        },
        false -> -1,
    };
    // i=0: 1, i=1: 10, i=2: 100, i=3: 1, i=4: 10 → 122
    if result == 122 then 0 else 1
}
