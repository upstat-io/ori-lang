@classify (n: int) -> int = match n {
    0 -> 100,
    1 -> 101,
    2 -> 102,
    3 -> 103,
    4 -> 104,
    5 -> 105,
    6 -> 106,
    7 -> 107,
    8 -> 108,
    9 -> 109,
    10 -> 110,
    11 -> 111,
    12 -> 112,
    13 -> 113,
    14 -> 114,
    15 -> 115,
    16 -> 116,
    17 -> 117,
    18 -> 118,
    19 -> 119,
    _ -> 0,
};

@main () -> int = {
    let ok1 = classify(n: 0) == 100;
    let ok2 = classify(n: 9) == 109;
    let ok3 = classify(n: 19) == 119;
    let ok4 = classify(n: 50) == 0;
    if ok1 && ok2 && ok3 && ok4 then 0 else 1
}
