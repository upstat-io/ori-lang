@main () -> int = {
    let x = 42;
    let result = if x > 0 then {
        if x > 10 then {
            if x > 20 then {
                if x > 30 then {
                    if x > 40 then 5
                    else 4
                } else 3
            } else 2
        } else 1
    } else 0;
    if result == 5 then 0 else 1
}
