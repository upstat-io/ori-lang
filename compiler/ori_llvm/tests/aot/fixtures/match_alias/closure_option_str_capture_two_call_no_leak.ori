// Closure captures `Option<str>` (cross-type matrix).
// Pins zero leaks for Option<str> capture invoked twice via ApplyIndirect.
// Stress-tests the inline-enum + heap-payload combination through the
// closure environment.
@main () -> int = {
    let captured: Option<str> = Some("captured_option_str_payload");
    let lookup = () -> {
        match captured {
            Some(s) -> s,
            None -> "none_branch",
        }
    };
    let first = lookup();
    let second = lookup();
    let h1 = first.contains(substr: "option");
    let h2 = second.contains(substr: "payload");
    if h1 && h2 then 0 else 1
}
