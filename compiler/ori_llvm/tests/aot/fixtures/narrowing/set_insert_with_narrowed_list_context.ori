// Workaround for BUG-04-024: assert_eq from std.testing silently dropped in AOT.
// Uses exit-code-based assertions instead.
@main () -> int = {
    let xs: [int] = [10, 20, 30];
    let s: Set<int> = [10, 20].iter().collect();
    let s2 = s.insert(value: 30);
    if s2.len() != 3 then 1
    else if !s2.contains(value: 30) then 2
    // Original set unchanged
    else if s.len() != 2 then 3
    else 0
}
