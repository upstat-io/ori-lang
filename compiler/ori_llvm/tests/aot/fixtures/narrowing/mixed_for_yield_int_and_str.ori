// Workaround for BUG-04-024: assert_eq from std.testing silently dropped in AOT.
// Uses exit-code-based assertions instead.
@main () -> int = {
    let xs: [int] = [1, 2, 3];
    // Int for-yield — safe to narrow
    let doubled: [int] = for x in xs.iter() yield x * 2;
    // Str for-yield — must NOT narrow
    let names: [str] = for x in xs.iter() yield if x == 1 then `one` else `other`;
    if doubled[0] != 2 then 1
    else if doubled[2] != 6 then 2
    else if names[0] != `one` then 3
    else if names[1] != `other` then 4
    else 0
}
