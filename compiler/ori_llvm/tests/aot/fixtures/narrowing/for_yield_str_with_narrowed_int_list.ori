// Workaround for BUG-04-024: assert_eq from std.testing silently dropped in AOT.
// Uses exit-code-based assertions instead.
@main () -> int = {
    // Narrowed [int] literal (all values fit in i8)
    let xs: [int] = [1, 2, 3];
    if xs[0] != 1 then 1
    else {
        // for-yield producing [str] — must NOT use narrowed elem_size
        let ys: [str] = for x in xs.iter() yield if x == 1 then `a` else `bb`;
        if ys[0] != `a` then 2
        else if ys[1] != `bb` then 3
        else if ys[2] != `bb` then 4
        else 0
    }
}
