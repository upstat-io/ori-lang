// Workaround for BUG-04-024: assert_eq from std.testing silently dropped in AOT.
// Uses exit-code-based assertions instead.
@main () -> int = {
    let xs: [int] = [1, 2, 3];
    let ys: [int] = for x in xs.iter() yield x * 2;
    if ys[0] != 2 then 1
    else if ys[1] != 4 then 2
    else if ys[2] != 6 then 3
    else 0
}
