// Workaround for BUG-04-024: assert_eq from std.testing silently dropped in AOT.
// Uses exit-code-based assertions instead.
@main () -> int = {
    // List gets narrowed (all values fit in i8)
    let xs: [int] = [1, 2, 3, 4, 5];
    if xs[0] != 1 then 1
    else if xs[4] != 5 then 2
    else {
        // Set uses canonical sizes (not narrowed)
        let s: Set<int> = [1, 2, 3, 4, 5].iter().collect();
        if !s.contains(value: 1) then 3
        else if !s.contains(value: 5) then 4
        else if s.contains(value: 6) then 5
        else if s.len() != 5 then 6
        // Cross-check: list element lookup in set
        else if !s.contains(value: xs[2]) then 7
        else 0
    }
}
