// Regression: after transitive generic-call closure discovers
// `assert_eq<Box<int>>`, its `T: Debug` bound must publish the exact derived
// `Box<int>.debug` specialization. Without producer-owned bound closure, the
// shared executable census reaches `assert_eq$m$...Box` but cannot resolve its
// nested `debug` call. The interpreter's dynamic dispatch masks that omission.
use std.testing { assert_eq }

#derive(Eq, Debug)
type Box<T> = { item: T }

@check_box<T: Eq + Debug> (a: Box<T>, b: Box<T>) -> void = assert_eq(actual: a, expected: b);

@main () -> int = {
    check_box(a: Box { item: 1 }, b: Box { item: 1 });
    0
}
