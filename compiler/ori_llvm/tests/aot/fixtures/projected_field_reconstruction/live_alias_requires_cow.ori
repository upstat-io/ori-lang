type Box = { rows: [int], tags: [int] }

@update_with_live_alias (box: Box) -> bool = {
    let original = box;
    let updated = Box { rows: box.rows.push(value: 5), tags: box.tags };

    original.rows.len() == 2
        && updated.rows.len() == 3
        && original.tags.len() == 2
        && updated.tags.len() == 2
}

@main () -> void = {
    let box = Box { rows: [1, 2], tags: [3, 4] };
    let preserved = update_with_live_alias(box:);
    print(msg: preserved.to_str())
}
