@classify (n: int) -> int = match n {
    1 | 2 | 3 -> 10,
    4 | 5 | 6 -> 20,
    7 | 8 | 9 -> 30,
    _ -> 0,
};

@main () -> int = {
    let a = classify(n: 2);
    let b = classify(n: 5);
    let c = classify(n: 8);
    let d = classify(n: 100);
    if a == 10 && b == 20 && c == 30 && d == 0 then 0 else 1
}
