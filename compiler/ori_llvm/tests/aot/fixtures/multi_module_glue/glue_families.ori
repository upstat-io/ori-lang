@main () -> void = {
    let $e = Error(msg: "audit");
    let $errs = [Error(msg: "a"), Error(msg: "b")];
    let $eq = [1, 2] == [1, 2];
    let $r = catch(expr: 4 / 2);
    let $v = match r {
        Ok(v) -> v,
        Err(_) -> 0,
    };
    let $base = 10;
    let $f = (x: int) -> x + base;
    let $m = {"k": [1], "j": [2]};
    let $s: Set<str> = ["a", "b"].iter().collect();
    let $small = [1, 2, 3];
    let $doubled = small.iter().map(f).collect();
    let $joined = ["x", "y"].join(sep: ",");
    print(msg: `{e.message} {errs.len()} {eq} {v} {f(1)} {m.len()} {s.len()} {doubled.len()} {joined}`);
}
