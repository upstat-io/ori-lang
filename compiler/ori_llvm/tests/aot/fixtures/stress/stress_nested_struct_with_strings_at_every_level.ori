type A = { name: str, val: int }
type B = { a: A, desc: str }
type C = { b: B, info: str }

@main () -> int = {
    let c = C {
        b: B {
            a: A { name: "inner", val: 7 },
            desc: "middle",
        },
        info: "outer",
    };
    let ok1 = c.b.a.name == "inner";
    let ok2 = c.b.a.val == 7;
    let ok3 = c.b.desc == "middle";
    let ok4 = c.info == "outer";
    if ok1 && ok2 && ok3 && ok4 then 0 else 1
}
