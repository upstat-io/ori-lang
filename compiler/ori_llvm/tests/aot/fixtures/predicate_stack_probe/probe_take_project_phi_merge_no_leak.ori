type MaybeIter = Empty | Holds(it: Iterator<int>);

@main () -> int = {
    let a: MaybeIter = Holds(it: [1, 2, 3].iter());
    let b: MaybeIter = Holds(it: [4, 5, 6].iter());
    let pick = false;
    let result = if pick then
        match a {
            Empty -> 0,
            Holds(it) -> it.count()
        }
    else
        match b {
            Empty -> 0,
            Holds(it) -> it.count()
        };
    result - 3
}
