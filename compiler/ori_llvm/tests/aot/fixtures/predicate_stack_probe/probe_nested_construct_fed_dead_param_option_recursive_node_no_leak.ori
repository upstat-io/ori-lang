use std.testing { assert_eq }
type Node = { value: int, next: Option<Node> }

@main () -> void = {
    let n2 = Node { value: 2, next: None };
    let n1 = Node { value: 1, next: Some(n2) };
    let o: Option<Node> = Some(n1);
    let v = match o {
        Some(node) -> node.value,
        None -> 0,
    };
    assert_eq(actual: v, expected: 1);
    ()
}
