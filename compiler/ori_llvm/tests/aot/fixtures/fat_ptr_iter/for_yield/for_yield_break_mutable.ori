@main () -> int = {
    let count = 0;
    let result = for x in [10, 20, 30, 40, 50] yield {
        count = count + 1;
        if x == 30 then break;
        x
    };
    // result = [10, 20], count = 3 (incremented before break check)
    let ok = result.length() == 2;
    if ok then {
        ok = count == 3
    };
    if ok then 0 else 1
}
