// BUG-04-077 semantic pin: collected List<int> with mapped values
// must equal the equivalent literal list. Verifies that collect
// writes at the correct (narrowed) stride so list equality reads
// matching data.
@main () -> int = {
    let mapped = [1, 2, 3].iter().map(x -> x * 1000).collect();
    let literal = [1000, 2000, 3000];
    if mapped == literal then 0 else 1
}
