#derive(Clone)
type Wrapper = { s: str, n: int }

@main () -> int = {
    let text = "this is a long string exceeding SSO by a large amount,and this second part also exceeds it";
    let parts = text.split(sep: ",");
    let total = 0;
    for p in parts do {
        let w = Wrapper { s: p, n: p.len() };
        let copy = w.clone();
        total = total + copy.n;
    };
    // 53 + 36 = 89
    if total == 89 then 0 else 1
}
