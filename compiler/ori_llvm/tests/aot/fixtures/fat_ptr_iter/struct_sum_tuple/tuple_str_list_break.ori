@main () -> int = {
    let items = [
        ("this is a very long string that exceeds SSO threshold", 1),
        ("stop marker string that is also long enough to be heap", 2),
        ("third long string not visited because we broke early ok", 3)
    ];
    let total = 0;
    for (s, n) in items do {
        if n == 2 then break;
        total = total + s.len();
    };
    // Only first tuple: 53
    if total == 53 then 0 else 1
}
