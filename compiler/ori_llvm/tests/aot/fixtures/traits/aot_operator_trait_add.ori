type Point = { x: int, y: int }

impl Add for Point {
    type Output = Point;
    @add (self, rhs: Point) -> Point = Point {
        x: self.x + rhs.x,
        y: self.y + rhs.y,
    }
}

@main () -> int = {
    let a = Point { x: 1, y: 2 };
    let b = Point { x: 3, y: 4 };
    let c = a + b;
    if c.x == 4 && c.y == 6 then 0 else 1
}
