trait Calculator {
    @add (self, n: int) -> int
    @double (self) -> int
}

type Num = { value: int }

impl Calculator for Num {
    @add (self, n: int) -> int = self.value + n;
    @double (self) -> int = self.value * 2;
}

@main () -> int = {
    let n = Num { value: 5 };
    let ok1 = n.add(n: 3) == 8;
    let ok2 = n.double() == 10;
    if ok1 && ok2 then 0 else 1
}
