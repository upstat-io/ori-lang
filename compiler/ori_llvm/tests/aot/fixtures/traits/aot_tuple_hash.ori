@main () -> int = {
    let a = (1, 2, 3);
    let b = (1, 2, 3);
    let c = (3, 2, 1);
    let h1 = a.hash();
    let h2 = b.hash();
    let h3 = c.hash();
    // Same tuple → same hash
    let r1 = h1 == h2;
    // Different tuple → different hash
    let r2 = h1 != h3;
    if r1 && r2 then 0 else 1
}
