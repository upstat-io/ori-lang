@main () -> int = {
    let a = (1, 2);
    let b = (1, 3);
    let c = (1, 2);
    let d = (2, 0);
    // (1,2) < (1,3) — lexicographic on second field
    let r1 = a.compare(b).is_less();
    // (1,2) == (1,2)
    let r2 = a.compare(c).is_equal();
    // (2,0) > (1,3) — first field decides
    let r3 = d.compare(b).is_greater();
    if r1 && r2 && r3 then 0 else 1
}
