// Polymorphic identity lambda in the host module with an imported
// `assert_eq<int>` call — pins imported-generic monomorphization against a
// poly-lambda-inferred scalar (i64) result type.

use std.testing { assert_eq }

@main () -> int = {
    let $id = x -> x;
    assert_eq(actual: id(42), expected: 42);
    0
}
