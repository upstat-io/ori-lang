// AOT integration test for plans/empty-container-typeck-phase-contract §08.2 —
// polymorphic-lambda host module with imported `assert_eq<str>` call.
//
// Pairs with the int variant to pin dual-execution parity across type widths
// (scalar i64 vs fat-pointer {i64,i64,ptr}) through the same producer-side
// leak path. The str variant additionally exercises RC management on the
// assertion failure message build-up (`+` concat, `.debug()`) — any
// downstream RC regression tied to the §08.3 fix surfaces here first.

use std.testing { assert_eq }

@main () -> int = {
    let $id = x -> x;
    assert_eq(actual: id("hello"), expected: "hello");
    0
}
