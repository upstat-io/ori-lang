// Polymorphic identity lambda in the host module with an imported
// `assert_eq<str>` call — pairs with the int variant to pin both type widths
// (scalar i64 vs fat-pointer {i64,i64,ptr}) plus RC management on the
// assertion-failure message build-up.

use std.testing { assert_eq }

@main () -> int = {
    let $id = x -> x;
    assert_eq(actual: id("hello"), expected: "hello");
    0
}
