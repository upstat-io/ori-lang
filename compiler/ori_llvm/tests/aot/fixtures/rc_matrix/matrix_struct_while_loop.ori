type Record = { name: str, values: [int] }

@main () -> int = {
    let r = Record { name: "initial_name_for_heap", values: [1, 2, 3] };
    let i = 0;
    loop {
        if i >= 30 then break;
        r = Record { name: r.name + "x", values: r.values.push(i) };
        i = i + 1;
    };
    if r.values.len() == 33 then 0 else 1
}
