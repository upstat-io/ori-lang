type List = Nil | Cons(head: int, tail: List);

@build (n: int) -> List = {
    if n <= 0 then Nil
    else Cons(head: n, tail: build(n: n - 1))
};

@list_sum (list: List) -> int = match list {
    Nil -> 0,
    Cons(h, t) -> h + list_sum(list: t),
};

@main () -> int = {
    let $list = build(n: 100);
    if list_sum(list: list) == 5050 then 0 else 1
}
