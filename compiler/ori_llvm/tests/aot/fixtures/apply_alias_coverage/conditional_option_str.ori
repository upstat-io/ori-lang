// Apply-alias Conditional shape (multi-param path-conditional alias) over
// Option<str> elements. Exercises the sum-type-wrapped heap payload through
// the path-conditional candidate set. Runs under ORI_CHECK_LEAKS.

@select<T> (pick_first: bool, a: T, b: T) -> T = if pick_first then a else b;

@main () -> int = {
    let x = Some("alpha");
    let y = Some("beta value");
    let chosen = select(pick_first: true, a: x, b: y);
    let n = match chosen {
        Some(s) -> s.len(),
        None -> 0,
    };
    if n == 5 then 0 else 1
}
