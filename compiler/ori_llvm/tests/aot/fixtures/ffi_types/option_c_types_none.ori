    let a: Option<CPtr> = None;
    let b: Option<c_int> = None;
    let c: Option<c_float> = None;
    let d: Option<c_long> = None;
    let e: Option<c_double> = None;
    let f: Option<c_char> = None;
    let g: Option<c_size> = None;
    0
}
