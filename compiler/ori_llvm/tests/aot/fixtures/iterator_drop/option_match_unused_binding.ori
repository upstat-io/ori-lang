// TPR-07-013 matrix pin: Option<Iterator<int>> case. Same as
// enum_match_unused_binding but through the built-in Option sum type.

@main () -> int = {
    let x: Option<Iterator<int>> = Some([1, 2, 3].iter());
    let n = match x {
        None -> 0,
        Some(it) -> 42
    };
    if n == 42 then 0 else 1
}
