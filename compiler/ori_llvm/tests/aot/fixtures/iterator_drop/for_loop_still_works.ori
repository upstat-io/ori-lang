// TPR-07-008 regression guard: for-loop iterator cleanup must still
// work after the iterator-drop architectural fix. No double-free
// (would corrupt heap), no leak (would exit 2 under ORI_CHECK_LEAKS).

@main () -> int = {
    let sum = 0;
    for x in [1, 2, 3, 4, 5].iter() do sum = sum + x;
    if sum == 15 then 0 else 1
}
