// TPR-07-011 matrix pin: dynamic Holds/Empty selection with
// match-and-consume. The user picks at runtime whether the enum
// carries an iterator. The take-project move suppression must be
// path-sensitive — the Holds branch consumes the iterator via
// count(), the Empty branch never has an iterator to drop. This
// exercises the full control-flow diamond: Construct → Switch →
// {Holds→project→count, Empty→0} → merge → return.
//
// This is a stricter test than the bare match_consume: the compiler
// cannot constant-fold the match away, so both branches are live
// and the drop analysis must be correct across both.

type MaybeIter = Empty | Holds(it: Iterator<int>);

@build (use_holds: bool) -> MaybeIter =
    if use_holds then Holds(it: [1, 2, 3].iter()) else Empty;

@main () -> int = {
    let x = build(use_holds: true);
    let n = match x {
        Empty -> 0,
        Holds(it) -> it.count()
    };
    if n == 3 then 0 else 1
}
