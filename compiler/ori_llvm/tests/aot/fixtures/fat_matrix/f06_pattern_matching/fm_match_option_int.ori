@unwrap_or (opt: Option<int>, default: int) -> int =
    match opt {
        Some(v) -> v,
        None -> default,
    };

@main () -> int = {
    let a = unwrap_or(opt: Some(42), default: 0);
    let b = unwrap_or(opt: None, default: 99);
    if a == 42 then {
        if b == 99 then 0 else 1
    } else 2
}
