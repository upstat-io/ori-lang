#derive(Eq, Clone)
type Inner = { name: str }
#derive(Eq, Clone)
type Outer = { inner: Inner, count: int }

@main () -> int = {
    let a = Outer { inner: Inner { name: "alice" }, count: 5 };
    let b = a.clone();
    if a == b then {
        if b.inner.name.length() == 5 then 0 else 1
    } else 2
}
