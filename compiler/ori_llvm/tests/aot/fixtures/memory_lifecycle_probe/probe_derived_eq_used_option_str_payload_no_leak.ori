#derive(Eq)
type Holder = { maybe: Option<str> }

@main () -> int = {
    let a = Holder { maybe: Some("abcdefghijklmnopqrstuvwxyz1234") };
    let b = Holder { maybe: Some("abcdefghijklmnopqrstuvwxyz1234") };
    let c = Holder { maybe: None };
    if a == b then {
        if a != c then 0 else 1
    } else 2
}
