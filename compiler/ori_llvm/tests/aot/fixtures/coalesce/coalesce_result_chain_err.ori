// Regression: BUG-02-002 — Result<int, str> ?? Result<int, str> when LHS is Err
// Falls through to RHS
@main () -> int = {
    let a: Result<int, str> = Err("first");
    let b: Result<int, str> = Ok(2);
    let c: Result<int, str> = a ?? b;
    match c {
        Ok(v) -> if v == 2 then 0 else 1,
        Err(e) -> 2,
    }
}
