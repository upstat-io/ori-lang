#derive(Eq)
type Dir = North | South | East | West;

@main () -> int = {
    let n1 = North;
    let n2 = North;
    let s = South;
    let e = East;
    let w = West;
    // Same variant == same variant
    let ok1 = n1 == n2;
    // Different variants != each other
    let ok2 = n1 != s;
    let ok3 = s != e;
    let ok4 = e != w;
    let ok5 = w != n1;
    if ok1 && ok2 && ok3 && ok4 && ok5 then 0 else 1
}
