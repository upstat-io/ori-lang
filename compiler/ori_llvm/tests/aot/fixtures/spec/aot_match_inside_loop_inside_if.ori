@main () -> int = {
    let sum = 0;
    if true then {
        let i = 0;
        loop {
            if i >= 5 then break;
            let contribution = match i % 3 {
                0 -> 1,
                1 -> 2,
                _ -> 3,
            };
            sum = sum + contribution;
            i = i + 1
        }
    } else ();
    if sum == 9 then 0 else 1
}
