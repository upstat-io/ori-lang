@main () -> int = {
    let fns = [x -> x + 1, x -> x * 2, x -> x - 1];
    let idx = 0;
    let results = for f in fns yield {
        if idx == 1 then {
            idx = idx + 1;
            continue 0;
        };
        let r = f(10);
        idx = idx + 1;
        r
    };
    if results.length() == 3 then 0 else 1
}
