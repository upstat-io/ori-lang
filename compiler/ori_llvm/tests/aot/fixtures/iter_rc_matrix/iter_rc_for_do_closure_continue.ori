@main () -> int = {
    let fns = [x -> x + 1, x -> x * 2, x -> x - 1];
    let count = 0;
    let idx = 0;
    for f in fns do {
        if idx == 1 then {
            idx = idx + 1;
            continue;
        };
        count = count + 1;
        idx = idx + 1;
    };
    if count == 2 then 0 else 1
}
