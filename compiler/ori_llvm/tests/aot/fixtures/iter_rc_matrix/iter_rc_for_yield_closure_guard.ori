@main () -> int = {
    let fns = [x -> x + 1, x -> x * 2, x -> x - 1];
    let idx = 0;
    let results = for f in fns yield {
        let r = f(idx);
        idx = idx + 1;
        r
    };
    // f(0)=0+1=1, f(1)=1*2=2, f(2)=2-1=1 → sum=4
    let sum = 0;
    for n in results do sum = sum + n;
    if sum == 4 then 0 else 1
}
