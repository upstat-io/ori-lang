@main () -> int = {
    let fns = [x -> x + 1, x -> x * 2, x -> x - 1];
    let result = catch(expr: () -> {
        let idx = 0;
        for f in fns do {
            if idx == 1 then panic(msg: "test unwind closure");
            idx = idx + 1;
        };
        0
    });
    match result {
        Ok(_) -> 1,
        Err(_) -> 0,
    }
}
