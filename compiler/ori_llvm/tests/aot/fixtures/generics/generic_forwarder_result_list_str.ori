// BUG-04-090 cross-type: Result<[int], str> — two-constructor
// sum-type with heap payloads on BOTH arms. Both Ok and
// Err carry heap allocations; the param-return-alias rule fires on the
// Result, propagating to whichever arm's payload is live.
@id <T> (x: T) -> T = x;

@main () -> int = {
    let r: Result<[int], str> = Ok([10, 20, 30]);
    let r2 = id(x: r);
    match r2 {
        Ok(xs) -> if xs.len() == 3 && xs[1] == 20 then 0 else 1,
        Err(_) -> 2,
    }
}
