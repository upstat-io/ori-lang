// (Cross-pattern) Loop body Let-alias: borrowed [int] param + Let-alias
// inside a `for` loop body + Return. Verifies the pre-compute set tracks
// the borrow across loop iterations (each iteration creates a fresh alias
// without inflating dec coverage).

@borrow_loop_alias_then_return (xs: [int]) -> [int] = {
    for _i in 0..3 do {
        let inner_alias = xs;
        print(msg: `iter-{_i}: {inner_alias.len()}`)
    };
    xs
};

@main () -> int = {
    let original = [60, 70, 80];
    let returned = borrow_loop_alias_then_return(xs: original);
    if returned.len() == 3 && returned[0] == 60 && returned[2] == 80 then 0 else 1
}
