// Inherent method on a generic type (`impl<T> Box<T> { @unwrap (self) -> T }`)
// called on a concretely-instantiated receiver (`Box<int>`). Before per-receiver
// mono dispatch, this raised "unresolved function `unwrap` in apply — missing
// mono instance" at codegen; the receiver-shell-keyed dispatch table now
// resolves the inherent method's specialization and lowers its body.
//
// Two call sites on the same `Box<int>` receiver share one specialization
// (mangled-name dedup); both must reach the same lowered `unwrap` body.

type Box<T> = { value: T };

impl<T> Box<T> {
    @unwrap (self) -> T = self.value;
}

@unbox (b: Box<int>) -> int = b.unwrap();

@main () -> int = {
    let a = Box { value: 42 };
    let b = Box { value: 100 };
    if unbox(b: a) == 42 && unbox(b: b) == 100 then 0 else 1
}
