// BUG-04-090 §03 forwarder shape: inherent method `self`-returning.
// Verifies the `self` param triggers the same param-return-alias rule
// as a free-function generic param. Wrapper is a heap struct (carries
// [int] field); `self` is Owned; flows directly to Return.
type Wrapper = { items: [int] };

impl Wrapper {
    @inner (self) -> Wrapper = self;
}

@main () -> int = {
    let w = Wrapper { items: [5, 6, 7] };
    let w2 = w.inner();
    if w2.items.len() == 3 && w2.items[2] == 7 then 0 else 1
}
