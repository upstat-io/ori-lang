// (B-1) Return-as-transfer extension: borrowed [int] param + 2 borrow uses
// + return. Extends the str-flavored borrowed-param-keeps-rc.use_twice
// snapshot to [int] element type to verify the bug shape generalizes.

@use_twice (xs: [int]) -> [int] = {
    print(msg: `len: {xs.len()}`);
    print(msg: `first: {xs[0]}`);
    xs
};

@main () -> int = {
    let original = [10, 20, 30];
    let returned = use_twice(xs: original);
    if returned.len() == 3 && returned[0] == 10 && returned[2] == 30 then 0 else 1
}
