// Two mutually-recursive generics — same SCC, each recursive call
// across the SCC is a deferred mono resolution.
@ping <T> (x: T, n: int) -> T =
    if n == 0 then x else pong(x: x, n: n - 1);

@pong <T> (x: T, n: int) -> T =
    if n == 0 then x else ping(x: x, n: n - 1);

@main () -> int = {
    let n = ping(x: 42, n: 4);
    if n == 42 then 0 else 1
}
