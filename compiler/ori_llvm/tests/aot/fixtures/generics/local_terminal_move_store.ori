// Local terminal-move store: `w` is a fresh local read once (borrow
// projection) and then STORED into Holder as its terminal use. The store IS
// the move — the Holder owns the allocation, and `h`'s release is the
// single release of the whole tree. No scope-exit release for `w` may fire
// on top of the transfer (over-release double-free).
type Wrapper = { items: [int] };
type Holder = { kept: Wrapper };

@main () -> int = {
    let w = Wrapper { items: [5, 6, 7] };
    let $n = w.items.len();
    let h = Holder { kept: w };

    if h.kept.items.len() == 3 && n == 3 then 0 else 1
}
