// Inherent method on a generic type taking a closure parameter (`f: T -> T`)
// whose body has an internal `let` binding; exercises body lowering of a
// monomorphized method with both a closure-typed parameter and locals
// (`Holder<int>.map`).

type Holder<T> = { val: T };

impl<T> Holder<T> {
    @map (self, f: (T) -> T) -> T = {
        let t = self.val;
        f(t)
    };
}

@apply (h: Holder<int>) -> int = h.map(f: (x -> x + 1));

@main () -> int = {
    let h = Holder { val: 99 };
    if apply(h: h) == 100 then 0 else 1
}
