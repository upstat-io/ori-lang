// BUG-04-090 §03 edge: TRMC tail-recursive forwarder. Per gemini's Plan
// TPR consensus: TRMC uses internal jumps, not Return terminators, so
// the param-return-alias rule is bypassed. TRMC functions must be
// unaffected by the fix.
//
// Self-recursive forwarder: x is forwarded through n iterations,
// reaching the base case where it flows directly to Return. With TRMC
// the recursion lowers to a goto inside the function; the param-Return
// edge fires only at the final base case.
@chain_self <T> (x: T, n: int) -> T = if n == 0 then x else chain_self(x: x, n: n - 1);

@main () -> int = {
    let xs = chain_self(x: [101, 202, 303], n: 5);
    if xs.len() == 3 && xs[1] == 202 then 0 else 1
}
