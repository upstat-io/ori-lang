// BUG-04-090 §03 path-sensitivity: NEGATIVE PIN.
// Stress-test that exercises `select<T>` over [int] across many call
// sites with mixed path selection — under a naive global-suppression
// implementation (the rejected approach per Plan TPR Round-0 codex +
// gemini), every call leaks the not-returned param's heap allocation.
// Under the correct path-sensitive fix, RC is balanced and the
// program runs cleanly with ORI_CHECK_LEAKS=1.
//
// This fixture is the negative pin: it surfaces leak-detection
// failures under naive global-suppression but passes under the
// correct fix. The Phase 5 leak-check verification step exercises it
// with `ORI_CHECK_LEAKS=1`; for Phase 3, the AOT pipeline running
// the program is already enough to surface the use-after-free under
// the current bug (which over-decrements rather than under-).
@select <T> (cond: bool, x: T, y: T) -> T = if cond then x else y;

@main () -> int = {
    let r1 = select(cond: true, x: [1, 2], y: [10, 20]);
    let r2 = select(cond: false, x: [3, 4], y: [30, 40]);
    let r3 = select(cond: true, x: [5, 6], y: [50, 60]);
    let r4 = select(cond: false, x: [7, 8], y: [70, 80]);
    if r1[0] == 1 && r2[0] == 30 && r3[0] == 5 && r4[0] == 70 then 0 else 1
}
