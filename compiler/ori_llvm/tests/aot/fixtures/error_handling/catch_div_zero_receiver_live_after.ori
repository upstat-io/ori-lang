// Over-fire guard: a value live AFTER a caught checked-op panic
// must not be released on the unwind edge (receiver-live
// guard). xs is read after the catch succeeds.
@main () -> int = {
    let xs = [10, 20, 30];
    let r = catch(expr: 1 / 0);
    let n = xs.len();
    if r.is_err() then n - 3 else 1
}
