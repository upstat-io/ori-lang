// Regression: BUG-04-159 — same-frame catch of integer-overflow implicit panic
// (spec 17-errors-and-panics §17.2.1). Same emit_panic_block carrier via
// emit_checked_binop overflow path.
@main () -> int = {
    let big = 9223372036854775807;
    let result = catch(expr: big + 1);
    if result.is_err() then 0 else 1
}
