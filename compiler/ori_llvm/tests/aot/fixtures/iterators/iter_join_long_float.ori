// AOT test for iter_join with long float strings (exceeds 23-byte SSO).
// Exercises: heap-backed OriStr path in the to_str trampoline.
// Regression: heap-backed temporaries leaked without ori_str_rc_dec.

@main () -> int = {
    let result = [-2.2250738585072014e-308].iter().join(separator: ", ");
    // The exact string representation is implementation-defined,
    // but it must be non-empty and not crash.
    if result.len() > 0 then 0 else 1
}
