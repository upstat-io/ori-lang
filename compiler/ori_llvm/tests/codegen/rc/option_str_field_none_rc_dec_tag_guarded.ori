// FileCheck IR-shape pin: a None-bearing Option<str> struct field walked for
// RC dec must load the discriminant and switch BEFORE touching the payload —
// the tag-aware emit_inline_enum_rc_core path. The tag-blind bypass arm emitted
// an un-guarded payload extract (named %rc_dec.opt_inner = extractvalue ..., 1)
// feeding ori_str_rc_dec with no preceding tag switch, reading field 1 of a
// None (uninitialized) as a live RC pointer.
//
// CHECK-LABEL: define void @_ori_main
// CHECK: switch
// CHECK-NOT: opt_inner

type Holder = { f: Option<str> }

@mk (b: bool) -> Option<str> = if b then Some("hi") else None;

@consume (h: Holder) -> void = {
    print(msg: "c")
}

@main () -> void = {
    let h = Holder { f: mk(b: false) };
    consume(h: h)
}
