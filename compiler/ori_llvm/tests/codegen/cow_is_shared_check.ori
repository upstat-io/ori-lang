// FileCheck test: shared list mutation uses COW push with RC setup.
// A list with RC > 1 (shared via let ys = xs) forces the COW
// shared-mutation path. The RC increment (ori_list_rc_inc) sets up
// sharing before ori_list_push_cow handles the mutation.
//
// CHECK-LABEL: define void @_ori_main
// CHECK: ori_list_rc_inc
// CHECK: ori_list_push_cow

@main () -> void = {
    let xs = [1, 2, 3];
    let ys = xs;
    ys.push(value: 42);
    print(msg: ys.len().to_str());
    print(msg: xs.len().to_str())
}
