// FileCheck test: list mutation uses COW push operation.
// Rewritten from xs[0] = 42 (E4003 ARC error) to .push() which
// correctly exercises the COW code path via ori_list_push_cow.
//
// CHECK: ori_list_push_cow

@main () -> void = {
    let xs = [1, 2, 3];
    xs.push(value: 42);
    print(msg: xs.len().to_str())
}
