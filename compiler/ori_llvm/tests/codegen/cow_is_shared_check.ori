// FileCheck test: shared list mutation uses COW push with double RC setup.
// A list with RC > 1 (shared via let ys = xs) produces two ori_list_rc_inc
// calls before ori_list_push_cow — one for each alias. The unique-owner
// path only has one inc, so requiring two in exact mode distinguishes them.
//
// CHECK-LABEL: define void @_ori_main
// CHECK: ori_list_rc_inc
// CHECK: ori_list_rc_inc
// CHECK: ori_list_push_cow

@main () -> void = {
    let xs = [1, 2, 3];
    let ys = xs;
    ys.push(value: 42);
    print(msg: ys.len().to_str());
    print(msg: xs.len().to_str())
}
