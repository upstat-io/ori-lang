// FileCheck test: shared list mutation uses COW push with RC setup.
// A list shared via `let ys = xs` carries an ori_list_rc_inc for the alias
// before ori_list_push_cow, so the runtime sees RC > 1 and copies. The
// unique-owner path carries no alias inc before the push.
//
// CHECK-LABEL: define void @_ori_main
// CHECK: ori_list_rc_inc
// CHECK: ori_list_push_cow

@main () -> void = {
    let xs = [1, 2, 3];
    let ys = xs;
    ys.push(value: 42);
    print(msg: ys.len().to_str());
    print(msg: xs.len().to_str())
}
