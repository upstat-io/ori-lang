// FileCheck test: chain needs no LLVM-side ownership-provenance argument.
// Runtime iterator state identifies and releases each dynamic yield.
//
// CHECK-LABEL: define void @_ori_main
// CHECK: ptr null, i64 24, ptr %join.out)

@main () -> void = {
    let $left = ["eta-eta-eta-eta-eta-eta-eta-eta"]
        .iter()
        .map(transform: (s: str) -> str = s + "-suffix-suffix-suffix-suffix");
    let $joined = ["theta-theta-theta-theta-theta"]
        .iter()
        .chain(other: left)
        .join(separator: ", ");
    print(msg: joined)
}
