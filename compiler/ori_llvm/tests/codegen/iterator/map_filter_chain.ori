// FileCheck test: chained iterator methods produce filter + collect operations.
// filter() creates a filtered iterator (ori_iter_filter) and collect()
// materializes it (ori_iter_collect).
//
// CHECK-LABEL: define void @_ori_main
// CHECK: ori_iter_filter
// CHECK: ori_iter_collect

@main () -> void = {
    let xs = [1, 2, 3, 4, 5];
    let ys = xs.iter().filter(predicate: x -> x > 2).collect();
    print(msg: ys.len().to_str())
}
