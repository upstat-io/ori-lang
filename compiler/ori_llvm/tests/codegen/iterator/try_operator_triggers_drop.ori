// FileCheck test: early exit via ? operator still triggers iter_drop.
// When a for loop exits early via the ? operator (error propagation),
// the iterator must still be cleaned up via ori_iter_drop.
// Companion to break_triggers_drop.ori (which tests break).
//
// @function: _ori_process
// CHECK: ori_iter_drop

@process (xs: [int]) -> Result<void, str> = {
    for x in xs do {
        if x < 0 then Err("negative")?
    };
    Ok(())
}

@main () -> void = {
    let result = process(xs: [1, 2, -1, 3]);
    match result {
        Ok(_) -> print(msg: "ok"),
        Err(e) -> print(msg: e)
    }
}
