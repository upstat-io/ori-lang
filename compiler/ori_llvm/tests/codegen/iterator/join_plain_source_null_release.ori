// FileCheck test: join over a plain source passes a null consumed-element
// release fn — the source buffer owns its elements; releasing them at join
// would double-free.
//
// CHECK-LABEL: define void @_ori_main
// CHECK: i64 24, ptr null, ptr %join.out
//
// The list literal's own buffer header still gets a dec thunk stored; the
// assertion above pins only the JOIN call's release slot.

@main () -> void = {
    let $plain = ["gamma-gamma-gamma-gamma-gamma", "delta-delta-delta-delta-delta"]
        .iter()
        .join(separator: ", ");
    print(msg: plain)
}
