// FileCheck test: COW push inside a closure capturing a list.
// A closure that captures a list and pushes to it exercises the
// COW + closure env interaction — env allocation (ori_rc_alloc)
// must be present for the captured list.
//
// CHECK-LABEL: define void @_ori_main
// CHECK: ori_rc_alloc

@main () -> void = {
    let xs = [1, 2, 3];
    let mutator = () -> void = {
        xs.push(value: 4);
        print(msg: xs.len().to_str())
    };
    mutator()
}
