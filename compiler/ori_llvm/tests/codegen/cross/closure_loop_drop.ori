// FileCheck test: closure capturing a value, created inside a loop.
// Each loop iteration creates a new closure env (ori_rc_alloc).
// The iterator lifecycle (ori_iter_drop) must also be present.
//
// CHECK-LABEL: define void @_ori_main
// CHECK: ori_rc_alloc
// CHECK: ori_iter_drop

@main () -> void = {
    let names = ["alice", "bob"];
    for name in names do {
        let greet = () -> str = `hello {name}`;
        print(msg: greet())
    }
}
