// FileCheck test: multiple params with mixed types.
// Function with int (i64), str (ptr), and bool (i1) parameters.
// Verifies the concrete parameter types on the define line.
// Uses .matches mode — the full signature is checked on one line
// to avoid i1 matching a branch instruction instead of the parameter.
//
// @function: _ori_mixed
// The `str` param is reference-class. RL-31 `noalias` (Spec: Annex E §AIMS
// RL-31 (P2)) requires BOTH the type-level facet (b) AND the per-call-site
// provenance facet (a); facet (a) is unshipped, so `noalias` is OMITTED on the
// pointer param. The body only reads the borrowed string, so it keeps
// readonly/nonnull/dereferenceable without acquiring noalias.
// CHECK: define fastcc void @_ori_mixed(i64 noundef %0, ptr noundef nonnull readonly dereferenceable(24) %1, i1 noundef %2)

@mixed (n: int, s: str, b: bool) -> void = {
    if b then print(msg: s) else print(msg: n.to_str())
}

@main () -> void = mixed(n: 42, s: "hello", b: true);
