// FileCheck test: unique owner mutation via .push() does not memcpy (negative pin).
// When a list has only one owner, .push() COW fast-path should not copy the buffer.
//
// CHECK-LABEL: define void @_ori_main
// CHECK: ori_list_push_cow
// CHECK-NOT: memcpy

@main () -> void = {
    let xs = [1, 2, 3];
    xs.push(value: 4);
    print(msg: xs.len().to_str())
}
