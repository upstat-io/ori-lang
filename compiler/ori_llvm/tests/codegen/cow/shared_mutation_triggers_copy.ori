// FileCheck test: shared value mutation triggers COW cleanup for both owners.
// When a list is shared and one copy is mutated, both owners require
// independent cleanup via ori_buffer_rc_dec.
//
// CHECK-LABEL: define void @_ori_main
// CHECK: ori_buffer_rc_dec

@main () -> void = {
    let xs = [1, 2, 3];
    let ys = xs;
    ys[0] = 42;
    print(msg: ys[0].to_str());
    print(msg: xs[0].to_str())
}
