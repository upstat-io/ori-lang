---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/landing/Hero.astro';
import Features from '../components/landing/Features.astro';
import VirtuousCycle from '../components/landing/VirtuousCycle.astro';
import GetStarted from '../components/landing/GetStarted.astro';
import Playground from '../components/playground/Playground.svelte';

// Homepage-specific structured data for FAQ
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is Ori programming language?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Ori is a statically-typed programming language with value semantics, explicit effects, and smart testing. Eight compiler optimizations turn functional code into in-place mutations — no garbage collector, no borrow checker, no manual memory management.'
      }
    },
    {
      '@type': 'Question',
      name: 'How does testing work in Ori?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Ori has smart, dependency-aware testing built into the compiler. Tests live in the dependency graph — change a function and every affected test runs automatically. Test enforcement is configurable per project: off (default), warn, or error. Mocking is trivial thanks to the capability system.'
      }
    },
    {
      '@type': 'Question',
      name: 'What are capabilities in Ori?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Capabilities are Ori\'s effect system. Functions declare what effects they can perform (like Http, FileSystem, or Clock) using the "uses" keyword. This makes side effects explicit and mocking trivial for testing.'
      }
    },
    {
      '@type': 'Question',
      name: 'How does Ori handle memory management?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Ori uses Automatic Reference Counting (ARC) with value semantics — no garbage collector, no borrow checker, no manual allocation. The compiler stacks eight optimization layers that turn functional code into in-place mutations: type classification skips RC for scalars, interprocedural borrow inference eliminates RC at call sites, Perceus-style insertion places RC at last-use points, reset/reuse converts drop+allocate into in-place reuse, and static uniqueness analysis eliminates runtime checks entirely.'
      }
    },
    {
      '@type': 'Question',
      name: 'Is Ori free and open source?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, Ori is completely free and open source under the MIT license. You can find the source code, contribute, and report issues on GitHub at github.com/upstat-io/ori-lang.'
      }
    }
  ]
};
---

<BaseLayout
  title="Ori — Functional Code. Imperative Speed."
  description="Ori is a statically-typed language where functional code compiles to imperative speed. No garbage collector, no borrow checker — eight stacked optimizations turn value-semantic code into in-place mutations. Effects you can see. Testing that knows your code. Free and open source."
  keywords="Ori programming language, ARC memory management, value semantics, no garbage collector, no borrow checker, smart testing, dependency-aware testing, configurable test enforcement, static typing, type inference, effect system, capabilities, functional programming, in-place mutation, open source programming language"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <Hero>
    <Playground
      client:visible
      config={{
        showToolbar: true,
        showOutput: true,
        height: '100%',
        enableShare: false,
        enableExamples: true,
        readUrlHash: false,
        fontSize: 13,
        layout: 'vertical',
        maxFormatWidth: 50,
      }}
    />
  </Hero>
  <Features />
  <VirtuousCycle />
  <GetStarted />
</BaseLayout>
