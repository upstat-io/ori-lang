        Row J7: per_dim_advance_uniqueness —
                similar for Uniqueness; (P5) per-dim pin
        Row J8: per_dim_advance_may_share —
                join((..., false), (..., true)) =
                (..., true); (P6) OR pin
        Row J9: commutativity_pin —
                join(p, q) = join(q, p) on randomized
                ParamContract pairs; (P7) pin
        Row J10: associativity_pin —
                 join(join(p, q), r) = join(p, join(q, r)) on
                 randomized triples; (P8) pin
        Row J11: monotonicity_pin —
                 p ≤ q ⟹ join(p, r) ≤ join(q, r) on
                 randomized triples; (P9) pin
