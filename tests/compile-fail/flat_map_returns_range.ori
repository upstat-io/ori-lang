// Regression: flat_map closure must return Iterator<U>, not Range.
// The closure here returns `Range<int>` (i.e., `0..10`) instead of
// `Iterator<int>`. The diagnostic SHOULD suggest `.iter()` (Range is in the
// suggestion-friendly set per Plan TPR finding A12).
// See:

#[compile_fail(code: "E2001", message: "Iterator")]
@bad_flat_map_range tests _ () -> void = {
    let _: [int] = [1, 2, 3].iter()
        .flat_map(transform: (x: int) -> Range<int> = 0..x)
        .collect();
    ()
}
