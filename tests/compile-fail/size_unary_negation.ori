// Spec: 06-types.md § Size Type
// Unary negation (-) is not permitted on Size. It is a compile-time error.

#[compile_fail("cannot apply operator `-` to type `size`")]
@test_size_negation_error tests _ () -> void = {
    let s = 100b;
    // This should fail to compile: Size cannot be negated
    let neg = -s;
    ()
}
