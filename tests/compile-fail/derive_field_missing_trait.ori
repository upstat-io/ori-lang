// Spec: §3.15 — Derived Traits Formal Semantics
// Field type must implement the derived trait (E2032)

type FileHandle = { fd: int }

#[derive(Eq)]
type Container = { data: FileHandle }

// E2032 fires at the `#[derive(Eq)]` declaration above (field `FileHandle` lacks `Eq`),
// independent of any use site. The empty body keeps the in-test-span error set empty so
// the harness matches the module-level derive error; a `==` use site here would instead
// raise an in-span E2020 (operator requires `Eq`) and mask the derive error this test pins.
#[compile_fail(code: "E2032")]
@test_field_missing tests _ () -> void = {
    ()
}
