// Test that closure self-capture is detected on an annotated let-binding
// Spec: Clause 21.6
//
// An annotated let-binding (`let f: T = ...`) must report the same cycle
// diagnostic as the unannotated form when its initializer self-references
// the binding's own name.

#[compile_fail("closure cannot capture itself")]
@test_self_capture_annotated tests _ () -> void = {
    let f: (int) -> int = x -> f(x);
    ()
}
