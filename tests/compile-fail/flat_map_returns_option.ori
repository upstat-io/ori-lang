// Regression: flat_map closure must return Iterator<U>, not Option.
// The closure here returns `Option<int>` instead of `Iterator<int>`. The
// diagnostic SHOULD suggest `.iter()` (Option is in the suggestion-friendly set).
// See: bug-tracker/plans/BUG-02-013/

#[compile_fail(code: "E2001", message: "Iterator")]
@bad_flat_map_option tests _ () -> void = {
    let _ = [1, 2, 3].iter()
        .flat_map(transform: (x: int) -> Option<int> = Some(x))
        .collect();
    ()
}
