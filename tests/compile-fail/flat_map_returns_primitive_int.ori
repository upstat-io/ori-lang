// Regression: flat_map closure must return Iterator<U>, not a primitive.
// The closure here returns `int` instead of `Iterator<int>`. The diagnostic
// must NOT suggest `.iter()` (int is in the generic-fallback set).
// See: bug-tracker/plans/BUG-02-013/

#[compile_fail(code: "E2001", message: "Iterator")]
@bad_flat_map_int tests _ () -> void = {
    let _: [int] = [1, 2, 3].iter()
        .flat_map(transform: (x: int) -> int = x * 10)
        .collect();
    ()
}
