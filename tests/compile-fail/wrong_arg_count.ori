// Test that wrong argument count is detected
// Spec: 09-expressions.md § Function Calls
// Design: 02-syntax/02-functions.md § Call Syntax
//
// Function calls must provide the correct number of arguments.

@add (a: int, b: int) -> int = a + b;

#[compile_fail("function `add` expects 2 arguments")]
@test_wrong_arg_count tests _ () -> void = {
    let result = add(a: 1);
    ()
}
