// Regression: flat_map closure must return Iterator<U>, not Set.
// The closure here returns `Set<int>` instead of `Iterator<int>`.
// See:

#[compile_fail(code: "E2001", message: "Iterator")]
@bad_flat_map_set tests _ () -> void = {
    let _: [int] = [1, 2, 3].iter()
        .flat_map(transform: (x: int) -> Set<int> = Set([x, x * 10]))
        .collect();
    ()
}
