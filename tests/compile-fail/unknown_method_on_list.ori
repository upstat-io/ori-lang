// Spec: typeck §PC-2 — an unknown method on a concrete builtin receiver must be
// REJECTED at typecheck (registry+trait+field-callable miss = genuine absence),
// not silently deferred to a runtime E6024.
// Regression: bug-tracker/plans/BUG-02-041/

#[compile_fail("nonexistent_method")]
@unknown_method_on_list tests _ () -> void = {
    let _x = [1, 2, 3].nonexistent_method();
    ()
}
