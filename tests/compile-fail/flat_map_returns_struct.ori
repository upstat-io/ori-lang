// Regression: flat_map closure must return Iterator<U>, not a struct.
// The closure here returns a struct value instead of `Iterator<U>`.
// See: bug-tracker/plans/BUG-02-013/

type Pair = { a: int, b: int }

#[compile_fail(code: "E2001", message: "Iterator")]
@bad_flat_map_struct tests _ () -> void = {
    let _ = [1, 2, 3].iter()
        .flat_map(transform: (x: int) -> Pair = Pair { a: x, b: x * 10 })
        .collect();
    ()
}
