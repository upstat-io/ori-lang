// Regression: flat_map closure must return Iterator<U>, not Map.
// The closure here returns `{int: int}` instead of `Iterator<U>`.
// See: bug-tracker/plans/BUG-02-013/

#[compile_fail(code: "E2001", message: "Iterator")]
@bad_flat_map_map tests _ () -> void = {
    let _ = [1, 2, 3].iter()
        .flat_map(transform: (x: int) -> {int: int} = {x: x * 10})
        .collect();
    ()
}
