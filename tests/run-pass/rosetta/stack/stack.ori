// Rosetta Code: Stack
// Task: Implement a LIFO (Last In First Out) stack

// Create an empty stack
@empty_stack () -> [int] = [];

// Check if stack is empty
@stack_is_empty (stack: [int]) -> bool = len(collection: stack) == 0;

// Push an element onto the stack (returns new stack)
@push (stack: [int], value: int) -> [int] = stack.push(value);

// Get the top element without removing it
// TODO: Use stack[# - 1] when # syntax is implemented
@peek (stack: [int]) -> int = stack[len(collection: stack) - 1];

// Pop the top element (returns new stack without top)
// Note: list.pop() returns Option<T> (the element), not the truncated list.
// To get the stack without the top, we remove the last element.
@pop (stack: [int]) -> [int] = stack.remove(len(collection: stack) - 1);

// Get stack size
@size (stack: [int]) -> int = len(collection: stack);
