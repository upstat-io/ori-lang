use "../001_100_doors" { open_doors, simulate }
use std.testing { assert_eq }

@test_open_doors_returns_perfect_squares tests _ () -> void = {
    assert_eq(
        actual: open_doors(),
        expected: [1, 4, 9, 16, 25, 36, 49, 64, 81, 100]
    )
}

#skip("BUG-07-016: index assignment (list[i] = x) not implemented in evaluator — spec says it desugars to .updated()")
@test_simulate_returns_perfect_squares tests _ () -> void = {
    assert_eq(
        actual: simulate(),
        expected: [1, 4, 9, 16, 25, 36, 49, 64, 81, 100]
    )
}

#skip("BUG-07-016: index assignment (list[i] = x) not implemented in evaluator — blocked by simulate()")
@test_both_approaches_agree tests _ () -> void = {
    assert_eq(actual: open_doors(), expected: simulate())
}

@test_exactly_ten_doors_open tests _ () -> void = {
    assert_eq(actual: len(collection: open_doors()), expected: 10)
}

@test_first_open_door_is_1 tests _ () -> void = {
    let $doors = open_doors();
    assert_eq(actual: doors[0], expected: 1)
}

@test_last_open_door_is_100 tests _ () -> void = {
    let $doors = open_doors();
    assert_eq(actual: doors[9], expected: 100)
}

#skip("BUG-07-016: index assignment (list[i] = x) not implemented in evaluator — blocked by simulate()")
@test_non_square_doors_are_closed tests _ () -> void = {
    let $doors = simulate();
    assert_eq(actual: doors.contains(value: 2), expected: false);
    assert_eq(actual: doors.contains(value: 3), expected: false);
    assert_eq(actual: doors.contains(value: 5), expected: false);
    assert_eq(actual: doors.contains(value: 99), expected: false)
}
