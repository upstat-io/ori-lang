// Benchmark: Recursion-heavy
// Exercises: deep recursion, tree-like patterns, recursive data processing
// Measures: call overhead, tail-call optimization, stack frame management

@ackermann (m: int, n: int) -> int =
    if m == 0 then n + 1
    else if n == 0 then ackermann(m: m - 1, n: 1)
    else ackermann(m: m - 1, n: ackermann(m: m, n: n - 1));

@tak (x: int, y: int, z: int) -> int =
    if y >= x then z
    else tak(
        x: tak(x: x - 1, y: y, z: z),
        y: tak(x: y - 1, y: z, z: x),
        z: tak(x: z - 1, y: x, z: y),
    );

@fib_recursive (n: int) -> int =
    if n < 2 then n
    else fib_recursive(n: n - 1) + fib_recursive(n: n - 2);

@sum_recursive (n: int) -> int =
    if n == 0 then 0
    else n + sum_recursive(n: n - 1);

@power (base: int, exp: int) -> int =
    if exp == 0 then 1
    else if exp % 2 == 0 then {
        let half = power(base: base, exp: exp / 2);
        half * half
    } else base * power(base: base, exp: exp - 1);

@main () -> int = {
    // Ackermann — exponential recursion (3,7 is tractable)
    let ack = ackermann(m: 3, n: 7);

    // Takeuchi — triply recursive
    let tak_result = tak(x: 24, y: 16, z: 8);

    // Naive fibonacci — exponential tree recursion
    let fib = fib_recursive(n: 38);

    // Deep linear recursion (many times)
    let sum_total = 0;
    for _ in 0..100000 do {
        sum_total = sum_total + sum_recursive(n: 100);
    };

    // Fast exponentiation
    let pow_total = 0;
    for _ in 0..1000000 do {
        pow_total = pow_total + power(base: 2, exp: 30);
    };

    if ack == 1021 && tak_result >= 0 && fib == 39088169 && sum_total > 0 && pow_total > 0 then 0 else 1
}
