// Benchmark: List push (shared — COW slow path)
// Exercises: COW slow path — every push copies because snapshot forces RC > 1
// Expected: O(n^2) total time — this is the worst case for COW
// Purpose: Quantify the cost of sharing vs unique ownership

@main () -> int = {
    let n = 1000;
    let list: [int] = [];
    let total_snapshot_len = 0;
    let i = 0;
    loop {
        if i >= n then break;
        let snapshot = list;           // Share: forces COW on next push
        list = list.push(i);          // COW: copies because RC > 1
        total_snapshot_len = total_snapshot_len + snapshot.len();
        i = i + 1;
    };
    // Verify: list has all elements, snapshot lengths summed correctly
    let expected = n * (n - 1) / 2;
    if list.len() == n && total_snapshot_len == expected
        then 0 else 1
}
