// Golden test: per-backend #skip(backend: ..., reason: ...) round-trip
// Spec: 08-declarations.md § Test Declarations
// Regression: the per-backend skip attribute must format->reparse faithfully,
// and a test may stack one skip per backend.

#skip(backend: "llvm", reason: "FastISel struct-load mismatch")
@t_skip_llvm tests _ () -> void = 42;

#skip(backend: "interpreter", reason: "slow interpreter path")
@t_skip_interpreter tests _ () -> void = 42;

#skip(backend: "llvm", reason: "a")
#skip(backend: "interpreter", reason: "b")
@t_skip_both_backends tests _ () -> void = 42;
