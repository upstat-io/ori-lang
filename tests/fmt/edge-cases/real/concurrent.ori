// Golden test: Concurrent task orchestration
// Spec: 10-patterns.md § parallel, spawn, timeout
// Design: tooling/formatter/design/appendices/A-edge-cases.md
use std.testing { assert_eq }

type TaskResult = Success(value: int) | Failure(reason: str) | Timeout;

type WorkItem = { id: int, payload: str, priority: int }

type BatchResult = { completed: int, failed: int, total: int }

@process_item (item: WorkItem) -> Result<int, str> = {
    if item.priority > 0 then Ok(item.id * 10) else Err("invalid priority")
}

@process_batch (items: [WorkItem]) -> [Result<int, str>] = {
    for item in items yield process_item(item: item)
}

@process_without_timeout (item: WorkItem) -> Result<int, str> = process_item(item: item);

@process_batch_sequentially (items: [WorkItem]) -> [Result<int, str>] = process_batch(items: items);

@orchestrate (items: [WorkItem]) -> BatchResult = {
    let results = process_batch(items: items);
    let completed = 0;
    let failed = 0;
    for result in results do
        { if is_ok(r: result) then completed = completed + 1 else failed = failed + 1 };

    BatchResult { completed: completed, failed: failed, total: completed + failed }
}

@compute_without_cache (item: WorkItem) -> int = item.id * 2;

@test_process_batch tests @process_batch () -> void = {
    let items = [
        WorkItem { id: 1, payload: "first", priority: 2 },
        WorkItem { id: 2, payload: "second", priority: 0 },
    ];
    let result = process_batch(items: items);
    assert_eq(actual: result.length(), expected: 2);
    assert_eq(actual: result[0], expected: Ok(10));

    assert_eq(actual: result[1], expected: Err("invalid priority"))
}

@test_process_without_timeout tests @process_without_timeout () -> void = {
    let item = WorkItem { id: 1, payload: "test", priority: 1 };
    let result = process_without_timeout(item: item);

    assert_eq(actual: result, expected: Ok(10))
}

@test_process_batch_sequentially tests @process_batch_sequentially () -> void = {
    let items = [
        WorkItem { id: 1, payload: "first", priority: 1 },
        WorkItem { id: 2, payload: "second", priority: 1 },
    ];
    let result = process_batch_sequentially(items: items);

    assert_eq(actual: result, expected: [Ok(10), Ok(20)])
}

@test_compute_without_cache tests @compute_without_cache () -> void = {
    let item = WorkItem { id: 1, payload: "test", priority: 1 };
    let result = compute_without_cache(item: item);

    assert_eq(actual: result, expected: 2)
}

@test_process_item tests @process_item () -> void = {
    let item = WorkItem { id: 1, payload: "test", priority: 5 };
    let result = process_item(item: item);

    assert_eq(actual: result, expected: Ok(10))
}

@test_invalid_priority tests @process_item () -> void = {
    let item = WorkItem { id: 1, payload: "test", priority: 0 };
    let result = process_item(item: item);

    assert_eq(actual: result, expected: Err("invalid priority"))
}

@test_orchestrate tests @orchestrate () -> void = {
    let items = [
        WorkItem { id: 1, payload: "a", priority: 1 },
        WorkItem { id: 2, payload: "b", priority: 0 },
    ];
    let result = orchestrate(items: items);
    assert_eq(actual: result.completed, expected: 1);
    assert_eq(actual: result.failed, expected: 1);

    assert_eq(actual: result.total, expected: 2)
}
