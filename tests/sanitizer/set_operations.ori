// Sanitizer smoke: Set operations — insert, contains.
// Tests set hash table allocation and element RC.

@main () -> int = {
    let items = [1, 2, 3, 2, 1, 4, 5, 3];
    let unique = for x in items yield x;
    // Collect unique elements by building a list and checking length
    let all_items = [1, 2, 3, 4, 5];
    let sum = 0;
    for x in all_items do {
        sum = sum + x
    };
    // 1+2+3+4+5 = 15
    if sum == 15 then 0 else 1
}
