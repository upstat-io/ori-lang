// Sanitizer smoke: Option RC handling — Some/None paths via explicit
// construction AND iter().find() consumer. The iter().find() paths are
// regression coverage for BUG-04-073 (double-free in AOT, OBE 2026-04-25).

@safe_get (items: [int], idx: int) -> Option<int> = {
    if idx >= 0 && idx < items.len() then Some(items[idx])
    else None
}

@main () -> int = {
    let items = [10, 20, 30, 40, 50];

    let found = safe_get(items: items, idx: 2);
    let missing = safe_get(items: items, idx: 99);
    let ok1 = found == Some(30) && missing == None;

    let it_found = items.iter().find(where: x -> x == 30);
    let it_missing = items.iter().find(where: x -> x == 99);
    let ok2 = it_found == Some(30) && it_missing == None;

    if ok1 && ok2 then 0 else 1
}
