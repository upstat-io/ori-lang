// Spec: §07.2 Niche Filling — Result<bool, Ordering> niche optimization
// Regression: repr-opt section-07 — niche-encoded Result match correctness
// Result<bool, Ordering> uses niche encoding when both types have available niches.

use std.testing { assert_eq }

@test_result_ok_true tests @result_ok_true () -> void = {
    assert_eq(actual: result_ok_true(), expected: "ok:true")
}

@result_ok_true () -> str = {
    let $x: Result<bool, Ordering> = Ok(true);
    match x {
        Ok(v) -> `ok:{v}`,
        Err(e) -> match e {
            Less -> "err:Less",
            Equal -> "err:Equal",
            Greater -> "err:Greater"
        }
    }
}

@test_result_ok_false tests @result_ok_false () -> void = {
    assert_eq(actual: result_ok_false(), expected: "ok:false")
}

@result_ok_false () -> str = {
    let $x: Result<bool, Ordering> = Ok(false);
    match x {
        Ok(v) -> `ok:{v}`,
        Err(e) -> match e {
            Less -> "err:Less",
            Equal -> "err:Equal",
            Greater -> "err:Greater"
        }
    }
}

@test_result_err_less tests @result_err_less () -> void = {
    assert_eq(actual: result_err_less(), expected: "err:Less")
}

@result_err_less () -> str = {
    let $x: Result<bool, Ordering> = Err(Less);
    match x {
        Ok(v) -> `ok:{v}`,
        Err(e) -> match e {
            Less -> "err:Less",
            Equal -> "err:Equal",
            Greater -> "err:Greater"
