// === All five values are distinct ===

@test_result_all_distinct tests @result_all_distinct () -> void = {
    assert_eq(actual: result_all_distinct(), expected: true)
}

@result_all_distinct () -> bool = {
    let $ok_t: Result<bool, Ordering> = Ok(true);
    let $ok_f: Result<bool, Ordering> = Ok(false);
    let $err_l: Result<bool, Ordering> = Err(Less);
    let $err_e: Result<bool, Ordering> = Err(Equal);
    let $err_g: Result<bool, Ordering> = Err(Greater);
    is_ok(result: ok_t) && is_ok(result: ok_f)
        && is_err(result: err_l) && is_err(result: err_e) && is_err(result: err_g)
}
