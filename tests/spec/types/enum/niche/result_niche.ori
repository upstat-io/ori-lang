// Spec: Annex E §Representation Optimization.
// Regression: Equal-byte Result payload arms preserve every semantic value.

use std.testing { assert_eq }

@test_result_ok_true tests @result_ok_true () -> void = {
    assert_eq(actual: result_ok_true(), expected: "ok:true")
}

@result_ok_true () -> str = {
    let $x: Result<bool, Ordering> = Ok(true);
    match x {
        Ok(v) -> `ok:{v}`,
        Err(e) -> match e {
            Less -> "err:Less",
            Equal -> "err:Equal",
            Greater -> "err:Greater"
        }
    }
}

@test_result_ok_false tests @result_ok_false () -> void = {
    assert_eq(actual: result_ok_false(), expected: "ok:false")
}

@result_ok_false () -> str = {
    let $x: Result<bool, Ordering> = Ok(false);
    match x {
        Ok(v) -> `ok:{v}`,
        Err(e) -> match e {
            Less -> "err:Less",
            Equal -> "err:Equal",
            Greater -> "err:Greater"
        }
    }
}

@test_result_err_less tests @result_err_less () -> void = {
    assert_eq(actual: result_err_less(), expected: "err:Less")
}

@result_err_less () -> str = {
    let $x: Result<bool, Ordering> = Err(Less);
    match x {
        Ok(v) -> `ok:{v}`,
        Err(e) -> match e {
            Less -> "err:Less",
            Equal -> "err:Equal",
            Greater -> "err:Greater"
        }
    }
}

@test_result_err_equal tests @result_err_equal () -> void = {
    assert_eq(actual: result_err_equal(), expected: "err:Equal")
}

@result_err_equal () -> str = {
    let $x: Result<bool, Ordering> = Err(Equal);
    match x {
        Ok(v) -> `ok:{v}`,
        Err(e) -> match e {
            Less -> "err:Less",
            Equal -> "err:Equal",
            Greater -> "err:Greater"
        }
    }
}

@test_result_err_greater tests @result_err_greater () -> void = {
    assert_eq(actual: result_err_greater(), expected: "err:Greater")
}

@result_err_greater () -> str = {
    let $x: Result<bool, Ordering> = Err(Greater);
    match x {
        Ok(v) -> `ok:{v}`,
        Err(e) -> match e {
            Less -> "err:Less",
            Equal -> "err:Equal",
            Greater -> "err:Greater"
        }
    }
}

@test_result_ordering_bool_ok_greater tests @result_ordering_bool_ok_greater () -> void = {
    assert_eq(actual: result_ordering_bool_ok_greater(), expected: "ok:Greater")
}

@result_ordering_bool_ok_greater () -> str = {
    let $x: Result<Ordering, bool> = Ok(Greater);
    match x {
        Ok(o) -> match o {
            Less -> "ok:Less",
            Equal -> "ok:Equal",
            Greater -> "ok:Greater"
        },
        Err(v) -> `err:{v}`
    }
}

@test_result_map_err_bool_to_ordering_preserves_greater tests @result_map_err_bool_to_ordering_preserves_greater () -> void = {
    assert_eq(actual: result_map_err_bool_to_ordering_preserves_greater(), expected: Err(Greater))
}

@result_map_err_bool_to_ordering_preserves_greater () -> Result<bool, Ordering> = {
    let x: Result<bool, bool> = Err(true);
    x.map_err((v: bool) -> Ordering = if v then Greater else Less)
}

@test_result_map_bool_to_ordering_preserves_greater tests @result_map_bool_to_ordering_preserves_greater () -> void = {
    assert_eq(actual: result_map_bool_to_ordering_preserves_greater(), expected: Ok(Greater))
}

@result_map_bool_to_ordering_preserves_greater () -> Result<Ordering, bool> = {
    let x: Result<bool, bool> = Ok(true);
    x.map((v: bool) -> Ordering = if v then Greater else Less)
}

// Every value uses its expected Result arm.

@test_result_values_use_expected_arm tests @result_values_use_expected_arm () -> void = {
    assert_eq(actual: result_values_use_expected_arm(), expected: true)
}

@result_values_use_expected_arm () -> bool = {
    let $ok_t: Result<bool, Ordering> = Ok(true);
    let $ok_f: Result<bool, Ordering> = Ok(false);
    let $err_l: Result<bool, Ordering> = Err(Less);
    let $err_e: Result<bool, Ordering> = Err(Equal);
    let $err_g: Result<bool, Ordering> = Err(Greater);
    is_ok(result: ok_t) && is_ok(result: ok_f)
        && is_err(result: err_l) && is_err(result: err_e) && is_err(result: err_g)
}
