// Spec: 14-expressions.md:1224-1228 — annotated empty list clears type ambiguity.
// Matrix: B=str dimension (element type) × C=push+len usage × D=annotated.

use std.testing { assert_eq }

@test_empty_list_element_str tests @empty_list_element_str () -> void = {
    assert_eq(actual: empty_list_element_str(), expected: 1)
}

@empty_list_element_str () -> int = {
    let names: [str] = [];
    names = names.push(value: "hello");
    names.len()
}
