// BUG-04-084 NEGATIVE PIN: unannotated parameter used only via `.is_empty()`
// does not constrain the element type. The parameter's signature-position var
// stays unresolved — it's outside the empty-literal defaulting scope, so
// E2005 fires on the ambiguous signature hole.

#compile_fail(code: "E2005")

@is_empty_of (xs) -> bool = xs.is_empty();

@main () -> int = if is_empty_of(xs: []) then 1 else 0;
