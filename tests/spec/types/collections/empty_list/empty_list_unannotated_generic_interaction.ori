// Matrix item 15 POSITIVE PIN: unannotated empty list passed to a generic free
// function. The end-of-body defaulting (Rust !-fallback analog) defaults the
// call-site instantiation var to Never, so `T` resolves to Never, the generic
// call type-checks cleanly, and `.len()` returns the expected zero. At the call
// site `T` is an instantiation var (not a rigid var), so the empty-literal
// defaulting reaches it. The genuine E2005 signature-hole negatives live in the
// unannotated-signature-param cells (len-only, is_empty-only, and the four
// body-pass negatives).

use std.testing { assert_eq }

@generic_wrap<T> (xs: [T]) -> int = xs.len();

@test_unannotated_generic_empty tests _ () -> void = {
    assert_eq(actual: generic_wrap(xs: []), expected: 0)
}
