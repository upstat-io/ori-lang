// Item 17 — Fault tolerance: multi-error compile-fail.
// Two distinct functions each with an unannotated param consumed via
// `.len()`. The type checker MUST report E2005 for both holes, not just
// the first.
// Spec-file #compile_fail pins the code but cannot prove BOTH fired —
// the Rust-side companion test `validate_body_types_emits_one_e2005_per_unbound_var`
// in compiler/ori_types/src/check/validators/tests.rs already asserts
// `diagnostics.len() == 2` for the dual-hole case (T13 in §05.1.2).

#compile_fail(code: "E2005")
@empty_list_multiple_unannotated tests _ () -> void = { () }

@count_first (xs) -> int = xs.len();

@count_second (ys) -> int = ys.len();

@main () -> int = {
    let $a = count_first(xs: []);
    let $b = count_second(ys: []);
    a + b
}
