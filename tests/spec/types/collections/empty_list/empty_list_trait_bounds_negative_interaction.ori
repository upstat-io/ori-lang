// Matrix §05.2 item 16a NEGATIVE PIN: unannotated empty list passed to a
// generic function with a trait bound (`T: Printable`) leaves `T` unbound
// at the call site. The trait-bound check cannot proceed without a
// resolved `T`; empty-literal propagation does not reach the bounded
// signature position, so the bodies-pass validator fires E2005 on the
// ambiguous signature hole BEFORE bound-check can run. Companion to the
// positive §05.2 item 16 pin — together they clamp the bound-check×
// empty-literal boundary.

#compile_fail(code: "E2005")

@print_all<T: Printable> (xs: [T]) -> int = xs.len();

@main () -> int = print_all(xs: []);
