// Spec: 08-declarations.md § Method-level Generics + 16-control-flow.md § Match
// BUG-02-023 §03 Cross-feature — const-generic method called inside match arm
//
// Verifies const-arg propagation through match-arm body lowering. Pre-fix: panics at
// runtime with `undefined variable: N` from the call site inside the arm. Post-fix:
// canon's mono_const_args_can side-table is keyed by the arm's call-site MonoInstanceId,
// so const args resolve identically across arm bodies.

use std.testing { assert_eq }

type Vec<T> = { items: [T] }

impl<T> Vec<T> {
    @first_n<$N: int> (self) -> [T, max N] = self.items.take(count: N).to_fixed<$N>();
}

type Pick = Small | Large;

#skip("BUG-02-023: const-generic method inside match-arm body — awaits canon side-table propagation through arm lowering")
@test_const_in_match_arm tests _ () -> void = {
    let v = Vec { items: [1, 2, 3, 4, 5, 6] };
    let pick = Small;
    let result = match pick {
        Small -> {
            let two: [int, max 2] = v.first_n();
            two.len()
        },
        Large -> {
            let four: [int, max 4] = v.first_n();
            four.len()
        }
    };
    assert_eq(actual: result, expected: 2)
}
