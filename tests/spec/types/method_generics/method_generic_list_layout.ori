use std.testing { assert_eq }

// Method-level generic that USES T's layout (returns [T]): codegen needs a
// recorded MonoInstance so it substitutes T -> int for the returned list.
type Boxer = { tag: int }

impl Boxer {
    @wrap<T> (self, item: T) -> [T] = [item];
}

@t tests @wrap () -> void = {
    let b = Boxer { tag: 1 };
    let $r = b.wrap(item: 5);
    assert_eq(actual: r[0], expected: 5)
}
