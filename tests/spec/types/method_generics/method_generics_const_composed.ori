// Spec: 08-types.md § 8.3.1 Const Generic Parameters
// Distinct const values must produce distinct monomorphized instances.

use std.testing { assert_eq }

type Vec<T> = { items: [T] }

impl<T> Vec<T> {
    @first_n<$N: int> (self) -> [T, max N] = self.items.take(count: N).to_fixed<$N>();
}

@test_const_two_call_sites tests _ () -> void = {
    let v = Vec { items: [10, 20, 30, 40, 50, 60, 70, 80] };
    let three: [int, max 3] = v.first_n();
    let five: [int, max 5] = v.first_n();
    assert_eq(actual: three.len(), expected: 3);
    assert_eq(actual: five.len(), expected: 5);
    assert_eq(actual: three[0], expected: 10);
    assert_eq(actual: five[4], expected: 50)
}
