// Spec: 08-declarations.md § Method-level Generics
// Proposal: docs/ori_lang/proposals/approved/method-generics-grammar-alignment-proposal.md
// BUG-01-002 §03 Cross-type coverage — mixed type + const <T, $N: int>

use std.testing { assert_eq }

type Stream<U> = { items: [U] }

impl<U> Stream<U> {
    @batch<T, $N: int> (self, transform: (U) -> T) -> [T, max N] =
        self.items.take(count: N).map(transform).to_fixed<$N>();
}

#skip("BUG-02-023 + BUG-01-004: const-generic value flow (BUG-02-023) AND method-call turbofish parser disambiguation (BUG-01-004) — both must land for this fixture to green")
@test_mixed_type_const tests _ () -> void = {
    let s = Stream { items: [1, 2, 3, 4] };
    let r: [int, max 2] = s.batch(transform: x -> x * 2);
    assert_eq(actual: r.len(), expected: 2);
    assert_eq(actual: r[0], expected: 2);
    assert_eq(actual: r[1], expected: 4)
}
