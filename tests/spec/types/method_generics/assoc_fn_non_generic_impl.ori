// Spec: 08-declarations.md § Method-level Generics
//
// Boundary clamp: a single associated function (no self) on a NON-generic impl
// resolves through the immediate-emit path (`compile_impls` / `register_method`),
// not the generic mono-collection path (`collect_mono_functions`). This case
// passes on both backends — it pins the boundary so the generic-impl
// mono-collection fix does not regress single-impl non-generic dispatch. The
// body transforms its input (+100) so a mis-resolution would compute a wrong
// number, clamping owner-correct dispatch for the single-impl shape.
// (The TWO-impl name-collision cross-dispatch on this same non-generic path is a
// distinct immediate-emit defect tracked separately; it is NOT this fix's scope.)

use std.testing { assert_eq }

type Apple = { a: int }
type FruitA = { x: int }

impl FruitA {
    @make (v: int) -> Apple = Apple { a: v + 100 };
}

@test_assoc_fn_non_generic_impl tests _ () -> void = {
    let a: Apple = FruitA.make(v: 1);
    assert_eq(actual: a.a, expected: 101)
}
