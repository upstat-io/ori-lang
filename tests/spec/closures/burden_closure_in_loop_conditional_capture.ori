// Closure-inside-loop with conditional capture: each loop iteration builds an
// owned heap str, captures it into a closure, and CONDITIONALLY invokes the
// closure (even iterations call it; odd iterations create-but-drop it unused).
// The unused-closure path is the over-elimination shape — the capture's inc
// must stay paired with its scope-exit dec (no double-free).
// Spec: Annex E §AIMS TF-7 / TF-13 (closure capture) + DP-2 / DP-3 elimination.
//
// Positive-pin: assert the summed length of even-iteration closure invocations
// with no leak/double-free under ORI_CHECK_LEAKS (interpreter + LLVM parity).

use std.testing { assert_eq };

@sum_even_capture_lens (n: int) -> int = {
    let lens = for i in 0..n yield {
        let s = `cap-{i}`;
        let f = () -> s.len();
        if i % 2 == 0 then f() else 0
    };
    lens.fold(initial: 0, op: (acc, x) -> acc + x)
}

@test_closure_in_loop_conditional_capture tests @sum_even_capture_lens () -> void = {
    // n=4: i=0 -> "cap-0" len 5 (even, f() called); i=1 -> 0 (odd, closure unused);
    // i=2 -> "cap-2" len 5 (even); i=3 -> 0 (odd). Sum = 5 + 5 = 10.
    let total = sum_even_capture_lens(n: 4);
    assert_eq(actual: total, expected: 10)
};
