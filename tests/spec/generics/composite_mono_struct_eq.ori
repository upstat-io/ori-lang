// Regression: generic composite types not monomorphized in the
// type pool. A `#derive(Eq)` generic struct instantiated at concrete args must
// materialize concrete field types so the derived `equals` resolves per-field
// (int/str) on BOTH backends. Pre-fix: interp PASS, LLVM E5001 (dual-exec
// divergence). Dual-backend (interpreter + LLVM).
use std.testing { assert }

#derive(Eq) type P3Pair<A, B> = { a: A, b: B }

@p3_eq (p: P3Pair<int, str>, q: P3Pair<int, str>) -> bool = p == q;

@test_p3_eq_equal tests _ () -> void = {
    let $p = P3Pair { a: 1, b: "hi" };
    let $q = P3Pair { a: 1, b: "hi" };
    assert(cond: p3_eq(p: p, q: q))
}

@test_p3_eq_unequal tests _ () -> void = {
    let $p = P3Pair { a: 1, b: "hi" };
    let $q = P3Pair { a: 1, b: "bye" };
    assert(cond: !p3_eq(p: p, q: q))
}
