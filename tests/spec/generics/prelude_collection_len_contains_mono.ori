// Regression: prelude collection len()/contains() AOT monomorphization arms
// (tuple .len, range .len/.count + .contains(value:), map .contains(key:)) were
// missing from try_emit_builtin_method's dispatch tables (collections/mod.rs +
// compound_traits.rs + set_builtins.rs), so calls fell through to
// try_emit_builtin_associated and emitted the misnamed "missing mono instance?"
// / "unresolved function (len|contains) in apply" diagnostic — LLVM codegen
// failed the whole module while the interpreter computed the value, a
// dual-execution parity break. range len/count/contains are backed by the
// ori_range_len / ori_range_contains C-ABI runtime fns.
// Dual-backend (interpreter + LLVM).

use std.testing { assert_eq };

// --- tuple .len(): compile-time arity of a fixed-shape product type ---
@test_tuple_len_mono tests _ () -> void = {
    assert_eq(actual: (1, 2, 3).len(), expected: 3)
}

@test_tuple_len_pair_mono tests _ () -> void = {
    assert_eq(actual: ("a", "b").len(), expected: 2)
}

// --- range .len() / .count(): element count, step-aware ---
@test_range_len_mono tests _ () -> void = {
    assert_eq(actual: (0..10).len(), expected: 10)
}

@test_range_count_mono tests _ () -> void = {
    assert_eq(actual: (0..10).count(), expected: 10)
}

@test_range_len_step_mono tests _ () -> void = {
    assert_eq(actual: (0..10 by 2).len(), expected: 5)
}

@test_range_len_inclusive_mono tests _ () -> void = {
    assert_eq(actual: (0..=10).len(), expected: 11)
}

// --- range .contains(value:): step-aligned membership ---
@test_range_contains_present_mono tests _ () -> void = {
    assert_eq(actual: (0..10).contains(value: 5), expected: true)
}

@test_range_contains_misaligned_mono tests _ () -> void = {
    assert_eq(actual: (0..10 by 3).contains(value: 7), expected: false)
}

@test_range_contains_out_of_bounds_mono tests _ () -> void = {
    assert_eq(actual: (5..10).contains(value: 3), expected: false)
}

// --- map .contains(key:): key membership ---
@test_map_contains_present_mono tests _ () -> void = {
    assert_eq(actual: {"a": 1, "b": 2}.contains(key: "a"), expected: true)
}

@test_map_contains_absent_mono tests _ () -> void = {
    assert_eq(actual: {"a": 1, "b": 2}.contains(key: "z"), expected: false)
}
