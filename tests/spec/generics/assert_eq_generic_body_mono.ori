// Regression: AOT monomorphization of a generic stdlib function whose body
// calls trait methods on its own rigid type param. `assert_eq<T: Eq + Debug>`
// (library/std/testing.ori) calls `equals(T)` (via `!=`) and `debug(T)` (on
// the panic branch) on its OWN rigid `T`. When the concrete `T` arrives through
// an INDIRECTION the recorder types against rigid/error `T` instead of the
// concrete instantiation — an associated-type projection (`Self.Item`), a
// trait-method return, or a generic-function result — the `assert_eq<T>` mono
// instance is recorded with `Idx::ERROR` for `T` (not the concrete `int`/`str`).
// At LLVM/AOT codegen the dispatch path (`apply.rs:resolve_callee` ->
// `lookup_mono_dispatch`) supplies `mono_instance_id = None`, the arg-type
// fallback structural-matches the recorded `Idx::ERROR` param against the
// concrete-`int` arg, the match fails, and emission aborts with
// `unresolved function 'assert_eq' in apply -- missing mono instance?` (which
// cascades to `unresolved function 'debug' in invoke`).
//
// Pre-fix: interp PASS (dynamic dispatch resolves nested calls at runtime);
// LLVM/AOT compile FAIL (missing mono instance). The dual-exec divergence IS
// the regression guard. The fix normalizes the associated-type projection to
// the impl's concrete `type Item =` binding in the type checker, so the nested
// generic/trait calls resolve per concrete instantiation at the dispatch site.
//
// Dual-backend (interpreter + LLVM): the spec corpus pins the construct, and
// `ori test` drives it end-to-end with construction + trait dispatch + assert_eq.

use std.testing { assert_eq }

// --- Cell 1: associated-type-resolved T (the cleanest field-function-free,
// module-alias-free trigger). `b.first()` returns `Option<Self.Item>` with
// `Self.Item = int`; `.unwrap()` yields concrete int; `assert_eq<int>` must
// collect its own + nested `equals`/`debug` instances. ---
trait Container {
    type Item
    @first (self) -> Option<Self.Item>
}

type IntBox = { value: int }

impl IntBox: Container {
    type Item = int;
    @first (self) -> Option<Self.Item> = Some(self.value);
}

type StrBox = { text: str }

impl StrBox: Container {
    type Item = str;
    @first (self) -> Option<Self.Item> = Some(self.text);
}

@test_assert_eq_assoc_type_int tests @first () -> void = {
    let $b = IntBox { value: 42 };
    let $result = b.first();
    assert_eq(actual: result.unwrap(), expected: 42)
}

@test_assert_eq_assoc_type_str tests @first () -> void = {
    let $b = StrBox { text: "hello" };
    let $result = b.first();
    assert_eq(actual: result.unwrap(), expected: "hello")
}

// --- Cell 2: trait-method-returned T fed straight into assert_eq (no
// intermediate let — exercises the call-as-argument dispatch shape). ---
@test_assert_eq_trait_return_direct tests @first () -> void = {
    let $b = IntBox { value: 7 };
    assert_eq(actual: b.first().unwrap(), expected: 7)
}
