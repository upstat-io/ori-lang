// Regression: derived `Hashable` on a generic struct instantiation.
// Field hashes must resolve concretely (int/str), not on the generic param: equal
// values hash equal, unequal values differ. Dual-backend.
use std.testing { assert }

#derive(Eq, Hashable) type P3Pair<A, B> = { a: A, b: B }

@p3_hash (p: P3Pair<int, str>) -> int = p.hash();

@test_p3_hash_equal tests _ () -> void = {
    let $p = P3Pair { a: 1, b: "k" };
    let $q = P3Pair { a: 1, b: "k" };
    assert(cond: p3_hash(p: p) == p3_hash(p: q))
}

@test_p3_hash_distinguishes tests _ () -> void = {
    let $p = P3Pair { a: 1, b: "k" };
    let $r = P3Pair { a: 2, b: "k" };
    assert(cond: p3_hash(p: p) != p3_hash(p: r))
}
