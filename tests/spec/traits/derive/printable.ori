// Spec: 07-properties-of-types.md § Printable + Derive
// Formal semantics: TypeName(val1, val2) for structs; VariantName(val1, ...) for sum types
//
// §3.15: Derived Traits Formal Semantics

use std.testing { assert_eq }

// --- Types ---

#[derive(Printable)]
type Point = { x: int, y: int }

#[derive(Printable)]
type Single = { value: str }

#[derive(Printable)]
type Nested = { origin: Point, label: str }

#[derive(Printable)]
type Color = Red | Green | Blue;

#[derive(Printable)]
type Shape = Circle(radius: int) | Rectangle(w: int, h: int);

// --- Struct to_str ---

@test_struct_basic tests @struct_basic () -> void = {
    assert_eq(actual: Point { x: 10, y: 20 }.to_str(), expected: "Point(10, 20)")
}
@struct_basic () -> str = Point { x: 10, y: 20 }.to_str();

@test_struct_str_field tests @str_field () -> void = {
    assert_eq(actual: Single { value: "hello" }.to_str(), expected: "Single(hello)")
}
@str_field () -> str = Single { value: "hello" }.to_str();

@test_struct_nested tests @nested () -> void = {
    let n = Nested { origin: Point { x: 1, y: 2 }, label: "test" };
    assert_eq(actual: n.to_str(), expected: "Nested(Point(1, 2), test)")
}
@nested () -> str = Nested { origin: Point { x: 1, y: 2 }, label: "test" }.to_str();

// --- Payloadless variant to_str ---

@test_variant_payloadless tests @pl_variant () -> void = {
    assert_eq(actual: Red.to_str(), expected: "Red");
    assert_eq(actual: Green.to_str(), expected: "Green");
    assert_eq(actual: Blue.to_str(), expected: "Blue")
}
@pl_variant () -> str = Red.to_str();

// --- Variant with payload ---

@test_variant_payload tests @payload_variant () -> void = {
    assert_eq(actual: Circle(radius: 5).to_str(), expected: "Circle(5)")
}
@payload_variant () -> str = Circle(radius: 5).to_str();

@test_variant_multi_payload tests @multi_variant () -> void = {
    assert_eq(actual: Rectangle(w: 3, h: 4).to_str(), expected: "Rectangle(3, 4)")
}
@multi_variant () -> str = Rectangle(w: 3, h: 4).to_str();

// --- Char field renders as the character, not the i32 codepoint ---
// Regression: derive_codegen field path previously rendered char fields via
// ori_str_from_int ("65"), diverging from the evaluator ("A"). Both struct
// and enum-payload field paths route through emit_field_to_string.

#[derive(Printable)]
type Letter = { ch: char }

#[derive(Printable)]
type Token = Sym(ch: char) | Pair(a: char, b: char);

@test_struct_char_field tests @struct_char () -> void = {
    assert_eq(actual: Letter { ch: 'A' }.to_str(), expected: "Letter(A)")
}
@struct_char () -> str = Letter { ch: 'A' }.to_str();

@test_variant_char_field tests @variant_char () -> void = {
    assert_eq(actual: Sym(ch: 'x').to_str(), expected: "Sym(x)");
    assert_eq(actual: Pair(a: 'a', b: 'b').to_str(), expected: "Pair(a, b)")
}
@variant_char () -> str = Sym(ch: 'x').to_str();

// Regression: a byte field renders as hex (0x41) for Printable too, matching
// the evaluator — NOT the raw decimal codepoint.
#[derive(Printable)]
type ByteBox = { b: byte }

#[derive(Printable)]
type ByteTok = BSym(b: byte) | BPair(a: byte, b: byte);

@test_struct_byte_field tests @struct_byte () -> void = {
    assert_eq(actual: ByteBox { b: 65 as byte }.to_str(), expected: "ByteBox(0x41)")
}
@struct_byte () -> str = ByteBox { b: 65 as byte }.to_str();

@test_variant_byte_field tests @variant_byte () -> void = {
    assert_eq(actual: BSym(b: 65 as byte).to_str(), expected: "BSym(0x41)")
}
@variant_byte () -> str = BSym(b: 65 as byte).to_str();
