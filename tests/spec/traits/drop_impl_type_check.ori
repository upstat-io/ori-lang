// Spec: drop-trait-proposal.md — a user `impl Type: Drop` type-checks once `Drop`
// is a declared prelude trait (Spec: drop-trait-proposal.md).
// Pre-fix `Drop` was NOT declared in library/std/prelude.ori, so `register_impl`
// resolved its trait_idx to an unregistered Named idx and `validate_assoc_types`
// ICE'd (debug_assert at ori_types/check/registration/impls.rs:445). This pins the
// Drop-declaration half: the impl type-checks + the type is usable. (Eval ignores
// the user @drop body; AOT drop-unwind codegen is a separate concern, out of scope here.)

use std.testing { assert_eq }

type Resource = { id: int }

impl Resource: Drop {
    @drop (self) -> void = ();
}

@drop_impl_type_checks tests _ () -> void = {
    let $r = Resource { id: 42 };

    assert_eq(actual: r.id, expected: 42)
}

// (Generic `impl<T> Box<T>: Drop` cell removed: it type-checks fine, but building
// ANY generic struct — even with no Drop impl — trips a pre-existing, orthogonal
// LLVM codegen bug: ori_rc_dec(i64, ...) malformed on a scalar monomorphized field.
// Re-add this cell once that codegen bug is fixed. Drop registration
// + the generic self_type type-check path are unaffected.)

// Newtype subject: trait_idx resolves; no ICE.
type Handle = int;

impl Handle: Drop {
    @drop (self) -> void = ();
}

@newtype_drop_impl_type_checks tests _ () -> void = {
    let $h = Handle(99);

    assert_eq(actual: h.unwrap(), expected: 99)
}
