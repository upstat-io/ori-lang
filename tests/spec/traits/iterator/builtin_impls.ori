// Spec: Section 3.8 — Iterator Traits (Built-in Iterable Implementations)
// Tests for Option<T> implementing Iterable via .iter().

use std.testing { assert, assert_eq }

// =============================================================================
// Option<T>.iter() — Some yields the inner value
// =============================================================================

@option_some_iter () -> [int] = {
    Some(42).iter().collect()
}

@test_option_some_iter tests @option_some_iter () -> void = {
    assert_eq(actual: option_some_iter(), expected: [42])
}

// Option<T>.iter() — None yields nothing
@option_none_iter () -> [int] = {
    let x: Option<int> = None;
    x.iter().collect()
}

@test_option_none_iter tests @option_none_iter () -> void = {
    assert_eq(actual: option_none_iter(), expected: [])
}

// =============================================================================
// Option.iter() with adapters
// =============================================================================

// Some + map
@option_iter_map () -> [int] = {
    Some(10).iter().map(transform: x -> x * 2).collect()
}

@test_option_iter_map tests @option_iter_map () -> void = {
    assert_eq(actual: option_iter_map(), expected: [20])
}

// Some + filter (keeps)
@option_iter_filter_keep () -> [int] = {
    Some(5).iter().filter(predicate: x -> x > 3).collect()
}

@test_option_iter_filter_keep tests @option_iter_filter_keep () -> void = {
    assert_eq(actual: option_iter_filter_keep(), expected: [5])
}

// Some + filter (removes)
@option_iter_filter_remove () -> [int] = {
    Some(1).iter().filter(predicate: x -> x > 3).collect()
}

@test_option_iter_filter_remove tests @option_iter_filter_remove () -> void = {
    assert_eq(actual: option_iter_filter_remove(), expected: [])
}

// =============================================================================
// Option.iter() consumers
// =============================================================================

// count
@option_some_count () -> int = {
    Some("hello").iter().count()
}

@test_option_some_count tests @option_some_count () -> void = {
    assert_eq(actual: option_some_count(), expected: 1)
}

@option_none_count () -> int = {
    let x: Option<str> = None;
    x.iter().count()
}

@test_option_none_count tests @option_none_count () -> void = {
    assert_eq(actual: option_none_count(), expected: 0)
}

// fold
@option_some_fold () -> int = {
    Some(7).iter().fold(initial: 0, op: (acc, x) -> acc + x)
}

@test_option_some_fold tests @option_some_fold () -> void = {
    assert_eq(actual: option_some_fold(), expected: 7)
}

// any/all
@option_some_any () -> bool = {
    Some(42).iter().any(predicate: x -> x == 42)
}

@test_option_some_any tests @option_some_any () -> void = {
    assert(cond: option_some_any())
}

@option_none_any () -> bool = {
    let x: Option<int> = None;
    x.iter().any(predicate: x -> x == 42)
}

@test_option_none_any tests @option_none_any () -> void = {
    assert(cond: !option_none_any())
}

// =============================================================================
// Option.iter() with string values
// =============================================================================

@option_str_iter () -> [str] = {
    Some("world").iter().collect()
}

@test_option_str_iter tests @option_str_iter () -> void = {
    assert_eq(actual: option_str_iter(), expected: ["world"])
}

// =============================================================================
// Option.iter() chained with other iterators
// =============================================================================

@option_chain () -> [int] = {
    Some(1).iter().chain(other: [2, 3].iter()).collect()
}

@test_option_chain tests @option_chain () -> void = {
    assert_eq(actual: option_chain(), expected: [1, 2, 3])
}

@option_zip () -> [(int, str)] = {
    Some(1).iter().zip(other: ["a"].iter()).collect()
}

@test_option_zip tests @option_zip () -> void = {
    assert_eq(actual: option_zip(), expected: [(1, "a")])
}

// =============================================================================
// Regression: hygiene-full §04.N TPR — heap string RC retention
// Option.iter() memcpy's payload into a new buffer. For RC-backed inner types
// (heap strings >23 bytes), the inner RC must be incremented to prevent
// double-free when both the original Option and the iterator are dropped.
// =============================================================================

@option_heap_str_iter () -> [str] = {
    Some("this is a heap-allocated string that exceeds SSO").iter().collect()
}

@test_option_heap_str_iter tests @option_heap_str_iter () -> void = {
    assert_eq(actual: option_heap_str_iter(), expected: ["this is a heap-allocated string that exceeds SSO"])
}

@option_heap_str_count () -> int = {
    Some("another heap string that is definitely not SSO sized").iter().count()
}

@test_option_heap_str_count tests @option_heap_str_count () -> void = {
    assert_eq(actual: option_heap_str_count(), expected: 1)
}

// Option survives after .iter() — both hold references to the same RC data
@option_heap_str_iter_then_use () -> bool = {
    let opt = Some("heap string payload used after iter call");
    let count = opt.iter().count();
    let still_some = opt.is_some();
    count == 1 && still_some
}

@test_option_heap_str_iter_then_use tests @option_heap_str_iter_then_use () -> void = {
    assert_eq(actual: option_heap_str_iter_then_use(), expected: true)
}

// None with heap-string type — no RC work needed
@option_none_heap_str_iter () -> [str] = {
    let x: Option<str> = None;
    x.iter().collect()
}

@test_option_none_heap_str_iter tests @option_none_heap_str_iter () -> void = {
    assert_eq(actual: option_none_heap_str_iter(), expected: [])
}

// Option<[int]> — list payload is also RC-managed
@option_list_iter () -> [[int]] = {
    Some([1, 2, 3]).iter().collect()
}

@test_option_list_iter tests @option_list_iter () -> void = {
    assert_eq(actual: option_list_iter(), expected: [[1, 2, 3]])
}
