// Spec: Section 3.8 — Iterator Traits (Phase 2)
// Tests for iterator consumer methods and lazy adapter methods.
use std.testing { assert, assert_eq }

// =============================================================================
// Consumer Methods
// =============================================================================
// fold: accumulate values
@iter_fold () -> int = {
    [1, 2, 3].iter().fold(initial: 0, op: (acc, x) -> acc + x)
}

// count: number of elements
@iter_count () -> int = { [1, 2, 3].iter().count() }

// find: first matching element
@iter_find () -> int = {
    let result = [1, 2, 3].iter().find(predicate: x -> x > 1);
    match result {
        Some(v) -> v,
        None -> -1,
    }
}

// find: no match returns None
@iter_find_none () -> bool = {
    let result = [1, 2, 3].iter().find(predicate: x -> x > 10);
    match result {
        Some(_) -> false,
        None -> true,
    }
}

// any: true if any element matches
@iter_any_true () -> bool = { [1, 2, 3].iter().any(predicate: x -> x == 2) }

// any: false if no element matches
@iter_any_false () -> bool = { [1, 2, 3].iter().any(predicate: x -> x == 10) }

// all: true if all match
@iter_all_true () -> bool = { [1, 2, 3].iter().all(predicate: x -> x > 0) }

// all: false if any fails
@iter_all_false () -> bool = { [1, 2, 3].iter().all(predicate: x -> x > 1) }

// for_each: verify it runs and returns void
@iter_for_each () -> void = { [1, 2, 3].iter().for_each(f: x -> x + 1) }

// collect: gather all elements into a list
@iter_collect () -> [int] = { [1, 2, 3].iter().collect() }

// =============================================================================
// Lazy Adapter Methods
// =============================================================================
// map: transform each element
@iter_map () -> [int] = { [1, 2, 3].iter().map(transform: x -> x * 2).collect() }

// filter: keep only matching elements
@iter_filter () -> [int] = {
    [1, 2, 3, 4, 5].iter().filter(predicate: x -> x > 2).collect()
}

// take: limit to first N elements
@iter_take () -> [int] = { [1, 2, 3, 4, 5].iter().take(count: 3).collect() }

// take more than available: yields all
@iter_take_excess () -> [int] = { [1, 2].iter().take(count: 10).collect() }

// skip: skip first N elements
@iter_skip () -> [int] = { [1, 2, 3, 4, 5].iter().skip(count: 2).collect() }

// skip more than available: yields empty
@iter_skip_excess () -> [int] = { [1, 2].iter().skip(count: 10).collect() }

// =============================================================================
// Chained Adapters
// =============================================================================
// filter + map + collect
@iter_chain_filter_map () -> [int] = {
    [1, 2, 3, 4, 5].iter().filter(predicate: x -> x > 2).map(
        transform: x -> x * 10,
    ).collect()
}

// filter + map + fold
@iter_chain_fold () -> int = {
    [1, 2, 3, 4, 5].iter().filter(predicate: x -> x > 2).map(
        transform: x -> x * 10,
    ).fold(
        initial: 0,
        op: (acc, x) -> acc + x,
    )
}

// take + skip combined
@iter_skip_take () -> [int] = { [1, 2, 3, 4, 5].iter().skip(count: 1).take(count: 3).collect() }

// map + count
@iter_map_count () -> int = {
    [1, 2, 3].iter().map(transform: x -> x * 2).count()
}

// filter + any
@iter_filter_any () -> bool = {
    [1, 2, 3, 4, 5].iter().filter(predicate: x -> x > 3).any(
        predicate: x -> x == 5,
    )
}

// =============================================================================
// Empty Iterator Edge Cases
// =============================================================================
// empty list iterator
@iter_empty_count () -> int = {
    let empty = [];
    empty.iter().count()
}

@iter_empty_collect () -> [int] = {
    let empty = [];
    empty.iter().collect()
}

@iter_empty_any () -> bool = {
    let empty = [];
    empty.iter().any(predicate: x -> x > 0)
}

@iter_empty_all () -> bool = {
    let empty = [];
    empty.iter().all(predicate: x -> x > 0)
}

// =============================================================================
// Range Iterator Methods
// =============================================================================
// Range collect via iterator
@range_iter_collect () -> [int] = { (0..5).iter().collect() }

// Range map via iterator
@range_iter_map () -> [int] = {
    (1..=3).iter().map(transform: x -> x * x).collect()
}

// Range filter via iterator
@range_iter_filter () -> [int] = {
    (0..10).iter().filter(predicate: x -> x % 2 == 0).collect()
}

// Range fold via iterator
@range_iter_fold () -> int = {
    (1..=10).iter().fold(initial: 0, op: (acc, x) -> acc + x)
}

// =============================================================================
// String Iterator Methods
// =============================================================================
@str_iter_collect () -> [char] = { "abc".iter().collect() }

@str_iter_count () -> int = { "hello".iter().count() }

// =============================================================================
// Phase 2C/2D — enumerate, zip, chain, flatten, flat_map, cycle
// =============================================================================
// enumerate: pair each item with its 0-based index
@iter_enumerate () -> [(int, int)] = { [10, 20, 30].iter().enumerate().collect() }

// enumerate: empty list
@iter_enumerate_empty () -> [(int, int)] = {
    let empty = [];
    empty.iter().enumerate().collect()
}

// zip: equal length
@iter_zip_equal () -> [(int, int)] = {
    let a = [1, 2, 3].iter();
    let b = [4, 5, 6].iter();

    a.zip(other: b).collect()
}

// zip: unequal length — stops at shorter
@iter_zip_unequal () -> [(int, int)] = {
    let a = [1, 2].iter();
    let b = [10, 20, 30].iter();

    a.zip(other: b).collect()
}

// zip: empty
@iter_zip_empty () -> [(int, int)] = {
    let empty = [];
    let b = [1, 2].iter();

    empty.iter().zip(other: b).collect()
}

// chain: basic
@iter_chain () -> [int] = {
    let a = [1, 2].iter();
    let b = [3, 4, 5].iter();

    a.chain(other: b).collect()
}

// chain: empty first
@iter_chain_empty_first () -> [int] = {
    let empty = [];
    let b = [1, 2].iter();

    empty.iter().chain(other: b).collect()
}

// chain: empty second
@iter_chain_empty_second () -> [int] = {
    let a = [1, 2].iter();
    let empty = [];

    a.chain(other: empty.iter()).collect()
}

// chain + filter
@iter_chain_filter () -> [int] = {
    let a = [1, 2, 3].iter();
    let b = [4, 5, 6].iter();

    a.chain(other: b).filter(predicate: x -> x > 2).collect()
}

// flatten: list of lists via map + flatten
@iter_flatten () -> [int] = {
    [[1, 2], [3], [4, 5]].iter().map(transform: sub -> sub.iter()).flatten().collect()
}

// flatten: empty outer
@iter_flatten_empty () -> [int] = {
    let empty = [];
    empty.iter().map(transform: sub -> sub.iter()).flatten().collect()
}

// flatten: empty inner lists
@iter_flatten_empty_inner () -> [int] = {
    let empty1 = [];
    let empty2 = [];

    [empty1, [1], empty2, [2]].iter().map(transform: sub -> sub.iter()).flatten().collect()
}

// flat_map: expand each item
@iter_flat_map () -> [int] = {
    [1, 2, 3].iter().flat_map(transform: x -> [x, x * 10].iter()).collect()
}

// flat_map: empty
@iter_flat_map_empty () -> [int] = {
    let empty = [];
    empty.iter().flat_map(transform: x -> [x, x].iter()).collect()
}

// cycle + take
@iter_cycle_take () -> [int] = { [1, 2, 3].iter().cycle().take(count: 7).collect() }

// cycle: empty yields nothing
@iter_cycle_empty () -> [int] = {
    let empty = [];
    empty.iter().cycle().take(count: 5).collect()
}

// =============================================================================
// flatten / flat_map — inner-element-size matrix (BUG-04-076)
// =============================================================================
// Regression tests pinning the inner-element-size invariant for ori_iter_flatten.
// The runtime contract is: outer source yields 8-byte iterator handles; the
// inner_elem_size argument is sizeof(inner element type), not sizeof(handle).
// Pre-fix, codegen passed sizeof(handle) (8 B), masking the bug for int but
// silently miscompiling for bool/byte/char/tuples/aggregates. See
// codegen-rules.md §IT-2 and the canonical iter_flatten/iter_flat_map tests above.
// flatten: bool (1 B) inner — primary failing case, the one that motivated the fix
@flatten_with_bool_inner () -> [bool] = {
    [[true, false], [true]].iter().map(transform: sub -> sub.iter()).flatten().collect()
}

// flatten: byte (1 B) inner — SKIPPED until byte literals (b'x') ship per parse.md
// "Known lexer gaps". The bool cell already covers 1-byte stride.
// flatten: char (4 B) inner — intermediate stride between 1 B and 8 B
@flatten_with_char_inner () -> [char] = {
    [['a', 'b'], ['c']].iter().map(transform: sub -> sub.iter()).flatten().collect()
}

// flatten: (int, bool) tuple (16 B Direct ABI) — matches handle size; sret threshold
@flatten_with_tuple_inner () -> [(int, bool)] = {
    [[(1, true)], [(2, false)]].iter().map(transform: sub -> sub.iter()).flatten().collect()
}

// flatten: (int, int, int) tuple (24 B Indirect/sret) — exercises sret-passing per AB-3
@flatten_with_wide_tuple_inner () -> [(int, int, int)] = {
    [[(1, 2, 3)], [(4, 5, 6)]].iter().map(transform: sub -> sub.iter()).flatten().collect()
}

// flatten: DoubleEndedIterator inner via .iter().rev() — SKIPPED due to monomorphization
// issues with .rev() on bool inner; deferred to follow-up bug. The is_iterator() predicate
// is a `matches!(Self::Iterator | Self::DoubleEndedIterator)` so coverage is dominated by
// the Iterator arm exercised by the bool/char/tuple/wide-tuple cells above.
// flat_map: bool inner — closure returns Iterator<bool> via .iter()
@flat_map_with_bool_inner () -> [bool] = {
    [1, 2, 3].iter().flat_map(transform: x -> [x > 0, x > 1].iter()).collect()
}

// flat_map: byte inner — SKIPPED until byte literals (b'x') and int→byte cast ship.
// flat_map: char inner — closure returns Iterator<char> via .iter()
@flat_map_with_char_inner () -> [char] = {
    ['a', 'b'].iter().flat_map(transform: c -> [c, c].iter()).collect()
}

// flat_map: (int, bool) tuple inner — closure returns Iterator<(int, bool)>
@flat_map_with_tuple_inner () -> [(int, bool)] = {
    [1, 2].iter().flat_map(transform: x -> [(x, true), (x, false)].iter()).collect()
}

// flat_map: (int, int, int) tuple inner (24 B sret) — closure returns Iterator<(int, int, int)>
@flat_map_with_wide_tuple_inner () -> [(int, int, int)] = {
    [1, 2].iter().flat_map(
        transform: x -> [(x, x, x), (x * 2, x * 2, x * 2)].iter(),
    ).collect()
}

@test_iter_fold tests @iter_fold () -> void = { assert_eq(actual: iter_fold(), expected: 6) }

@test_iter_count tests @iter_count () -> void = { assert_eq(actual: iter_count(), expected: 3) }

@test_iter_find tests @iter_find () -> void = { assert_eq(actual: iter_find(), expected: 2) }

@test_iter_find_none tests @iter_find_none () -> void = { assert(cond: iter_find_none()) }

@test_iter_any_true tests @iter_any_true () -> void = { assert(cond: iter_any_true()) }

@test_iter_any_false tests @iter_any_false () -> void = { assert(cond: !iter_any_false()) }

@test_iter_all_true tests @iter_all_true () -> void = { assert(cond: iter_all_true()) }

@test_iter_all_false tests @iter_all_false () -> void = { assert(cond: !iter_all_false()) }

@test_iter_for_each tests @iter_for_each () -> void = { iter_for_each() }

