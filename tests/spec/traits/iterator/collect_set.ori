// Spec: Clause 8.13 — Collect Trait (type-directed collect to Set)
// Tests for bidirectional `collect()` inference to `Set<T>`.
use std.testing { assert, assert_eq }

@test_collect_to_set tests _ () -> void = {
    let values: Set<str> = ["alpha", "beta", "gamma"].iter().collect();
    assert(
        cond: values.len() == 3 && values.contains("alpha") && values.contains("beta")
        && values.contains("gamma"),
    )
}

@test_collect_set_dedup tests _ () -> void = {
    let values: Set<int> = [1, 2, 1, 3, 2, 1].iter().collect();
    assert_eq(actual: values.len(), expected: 3)
}

@test_collect_empty_set tests _ () -> void = {
    let values: Set<int> = [].iter().collect();
    assert(cond: values.is_empty())
}

@test_filter_collect_set tests _ () -> void = {
    let values: Set<int> = [1, 2, 3, 4, 5, 6].iter().filter(
        predicate: value -> value % 2 == 0,
    ).collect();
    assert(
        cond: values.len() == 3 && values.contains(2) && values.contains(4) && values.contains(6),
    )
}

@test_map_collect_set tests _ () -> void = {
    let values: Set<int> = [1, 2, 3, 4].iter().map(transform: value -> value % 2).collect();
    assert(cond: values.len() == 2 && values.contains(0) && values.contains(1))
}

@test_range_collect_set tests _ () -> void = {
    let values: Set<int> = (0..6).iter().collect();
    assert(
        cond: values.len() == 6 && values.contains(0) && values.contains(5) && !values.contains(6),
    )
}
