// Positive pin P4 — load-bearing A2 case from Plan TPR Round 0.
// Closure body always panics and returns `Tag::Never`. Per
// (`Never` absorbs unification with any type), divergent closures are
// legitimate flat_map input — the new shape check MUST silently accept
// `Tag::Never` and bind the result iterator's element type to Never.
// Without the A2 fix this test would fail with a spurious E2001.
//
// Methodology: an explicitly typed empty input forces the closure through
// type checking without invoking it at runtime. The helper's `() -> [int]`
// return type pins .collect()'s target collection (avoiding the orthogonal
// collect-target ambiguity that fires E2005 on an unconstrained collect).

use std.testing { assert_eq, assert_panics };

@flat_map_divergent_ok_helper () -> [int] = {
    [].iter()
        .flat_map(transform: (x: int) -> panic(msg: "empty input must not invoke transform"))
        .collect()
}

@flat_map_divergent_ok tests _ () -> void = {
    assert_eq(actual: flat_map_divergent_ok_helper(), expected: [])
}

@flat_map_divergent_panics () -> [int] = {
    [1].iter()
        .flat_map(transform: (x: int) -> panic(msg: "divergent transform invoked"))
        .collect()
}

@flat_map_divergent_nonempty_panics tests _ () -> void = {
    assert_panics(f: () -> flat_map_divergent_panics())
}
