// Spec: Section 3.8 — DoubleEndedIterator
// Tests for .next_back() on double-ended iterators.

use std.testing { assert, assert_eq }

// =============================================================================
// List — next_back() basic
// =============================================================================

@list_next_back_first () -> int = {
    let iter = [10, 20, 30].iter();
    match iter.next_back() {
        (Some(x), _) -> x,
        _ -> -1
    }
}

@test_list_next_back_first tests @list_next_back_first () -> void = {
    assert_eq(actual: list_next_back_first(), expected: 30)
}

// Exhaust list backwards: 3, 2, 1
@list_next_back_all () -> [int] = {
    let iter = [1, 2, 3].iter();
    let result = [];
    match iter.next_back() {
        (Some(v1), iter2) -> match iter2.next_back() {
            (Some(v2), iter3) -> match iter3.next_back() {
                (Some(v3), _) -> [v1, v2, v3],
                _ -> []
            },
            _ -> []
        },
        _ -> []
    }
}

@test_list_next_back_all tests @list_next_back_all () -> void = {
    assert_eq(actual: list_next_back_all(), expected: [3, 2, 1])
}

// =============================================================================
// List — interleaved next() and next_back()
// =============================================================================

@list_interleaved () -> (int, int) = {
    let iter = [1, 2, 3, 4, 5].iter();
    match iter.next() {
        (Some(front), iter2) -> match iter2.next_back() {
            (Some(back), _) -> (front, back),
            _ -> (-1, -1)
        },
        _ -> (-1, -1)
    }
}

@test_list_interleaved tests @list_interleaved () -> void = {
    let (front, back) = list_interleaved();
    assert_eq(actual: front, expected: 1);
    assert_eq(actual: back, expected: 5)
}

// Interleave until meeting in middle
@list_interleaved_full () -> [int] = {
    let iter = [1, 2, 3, 4, 5].iter();
    let result = [];
    // front: 1
    match iter.next() {
        (Some(f1), iter2) -> match iter2.next_back() { // back: 5
            (Some(b1), iter3) -> match iter3.next() { // front: 2
                (Some(f2), iter4) -> match iter4.next_back() { // back: 4
                    (Some(b2), iter5) -> match iter5.next() { // middle: 3
                        (Some(m), _) -> [f1, b1, f2, b2, m],
                        _ -> []
                    },
                    _ -> []
                },
                _ -> []
            },
            _ -> []
        },
        _ -> []
    }
}

@test_list_interleaved_full tests @list_interleaved_full () -> void = {
    assert_eq(actual: list_interleaved_full(), expected: [1, 5, 2, 4, 3])
}

// =============================================================================
// Range — next_back()
// =============================================================================

@range_next_back () -> int = {
    let iter = (0..5).iter();
    match iter.next_back() {
        (Some(x), _) -> x,
        _ -> -1
    }
}

@test_range_next_back tests @range_next_back () -> void = {
    assert_eq(actual: range_next_back(), expected: 4)
}

// Interleaved range: front=0, back=4, front=1, back=3
@range_interleaved () -> [int] = {
    let iter = (0..5).iter();
    match iter.next() {
        (Some(f1), iter2) -> match iter2.next_back() {
            (Some(b1), iter3) -> match iter3.next() {
                (Some(f2), iter4) -> match iter4.next_back() {
                    (Some(b2), _) -> [f1, b1, f2, b2],
                    _ -> []
                },
                _ -> []
            },
            _ -> []
        },
        _ -> []
    }
}

@test_range_interleaved tests @range_interleaved () -> void = {
    assert_eq(actual: range_interleaved(), expected: [0, 4, 1, 3])
}

// =============================================================================
// String — next_back()
// =============================================================================

@str_next_back () -> char = {
    let iter = "hello".iter();
    match iter.next_back() {
        (Some(ch), _) -> ch,
        _ -> 'x'
    }
}

@test_str_next_back tests @str_next_back () -> void = {
    assert_eq(actual: str_next_back(), expected: 'o')
}

// Interleaved string: front='h', back='o'
@str_interleaved () -> (char, char) = {
    let iter = "hello".iter();
    match iter.next() {
        (Some(front), iter2) -> match iter2.next_back() {
            (Some(back), _) -> (front, back),
            _ -> ('x', 'x')
        },
        _ -> ('x', 'x')
    }
}

@test_str_interleaved tests @str_interleaved () -> void = {
    let (front, back) = str_interleaved();
    assert_eq(actual: front, expected: 'h');
    assert_eq(actual: back, expected: 'o')
}

// =============================================================================
// Empty iterator — next_back() returns None
// =============================================================================

@empty_list_next_back () -> bool = {
    let iter = [].iter();
    match iter.next_back() {
        (None, _) -> true,
        _ -> false
    }
}

@test_empty_list_next_back tests @empty_list_next_back () -> void = {
    assert(condition: empty_list_next_back())
}

// =============================================================================
// Mapped adapter — next_back() with transform
// =============================================================================

@mapped_next_back () -> int = {
    let iter = [1, 2, 3].iter().map(x -> x * 10);
    match iter.next_back() {
        (Some(x), _) -> x,
        _ -> -1
    }
}

@test_mapped_next_back tests @mapped_next_back () -> void = {
    assert_eq(actual: mapped_next_back(), expected: 30)
}

// Interleaved on mapped: front=10, back=30
@mapped_interleaved () -> (int, int) = {
    let iter = [1, 2, 3].iter().map(x -> x * 10);
    match iter.next() {
        (Some(front), iter2) -> match iter2.next_back() {
            (Some(back), _) -> (front, back),
            _ -> (-1, -1)
        },
        _ -> (-1, -1)
    }
}

@test_mapped_interleaved tests @mapped_interleaved () -> void = {
    let (front, back) = mapped_interleaved();
    assert_eq(actual: front, expected: 10);
    assert_eq(actual: back, expected: 30)
}

// =============================================================================
// Filtered adapter — next_back() with predicate
// =============================================================================

@filtered_next_back () -> int = {
    let iter = [1, 2, 3, 4, 5, 6].iter().filter(x -> x % 2 == 0);
    // Even numbers: 2, 4, 6 — next_back should yield 6
    match iter.next_back() {
        (Some(x), _) -> x,
        _ -> -1
    }
}

@test_filtered_next_back tests @filtered_next_back () -> void = {
    assert_eq(actual: filtered_next_back(), expected: 6)
}

// Interleaved on filtered: front=2, back=6
@filtered_interleaved () -> (int, int) = {
    let iter = [1, 2, 3, 4, 5, 6].iter().filter(x -> x % 2 == 0);
    match iter.next() {
        (Some(front), iter2) -> match iter2.next_back() {
            (Some(back), _) -> (front, back),
            _ -> (-1, -1)
        },
        _ -> (-1, -1)
    }
}

@test_filtered_interleaved tests @filtered_interleaved () -> void = {
    let (front, back) = filtered_interleaved();
    assert_eq(actual: front, expected: 2);
    assert_eq(actual: back, expected: 6)
}

@test_next_back_result_types tests _ () -> void = {
    let (list_back_raw, _) = [1].iter().next_back();
    let list_back: Option<int> = list_back_raw;
    assert_eq(actual: list_back, expected: Some(1));
    let (list_front_raw, _) = [1].iter().next();
    let list_front: Option<int> = list_front_raw;
    assert_eq(actual: list_front, expected: Some(1));
    let empty_values: [int] = [];
    let (empty_back_raw, _) = empty_values.iter().next_back();
    let empty_back: Option<int> = empty_back_raw;
    assert_eq(actual: empty_back, expected: None);
    let (range_back_raw, _) = (0..2).iter().next_back();
    let range_back: Option<int> = range_back_raw;
    assert_eq(actual: range_back, expected: Some(1));
    let (range_front_raw, _) = (0..2).iter().next();
    let range_front: Option<int> = range_front_raw;
    assert_eq(actual: range_front, expected: Some(0));
    let (str_back_raw, _) = "ab".iter().next_back();
    let str_back: Option<char> = str_back_raw;
    assert_eq(actual: str_back, expected: Some('b'));
    let (str_front_raw, _) = "ab".iter().next();
    let str_front: Option<char> = str_front_raw;
    assert_eq(actual: str_front, expected: Some('a'));
    let (mapped_back_raw, _) = [1, 2].iter().map(x -> x * 10).next_back();
    let mapped_back: Option<int> = mapped_back_raw;
    assert_eq(actual: mapped_back, expected: Some(20));
    let (filtered_back_raw, _) = [1, 2].iter().filter(x -> x % 2 == 0).next_back();
    let filtered_back: Option<int> = filtered_back_raw;
    assert_eq(actual: filtered_back, expected: Some(2));
    let (filtered_front_raw, _) = [1, 2].iter().filter(x -> x % 2 == 0).next();
    let filtered_front: Option<int> = filtered_front_raw;
    assert_eq(actual: filtered_front, expected: Some(2))
}
