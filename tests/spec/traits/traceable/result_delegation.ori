// Spec: 07-properties-of-types.md § Traceable
// Result delegates Traceable to inner Error

use std.testing { assert_eq, assert }

// Helpers bind Result<int, Error> via function return type
@mk_ok (v: int) -> Result<int, Error> = Ok(v);
@mk_err (msg: str) -> Result<int, Error> = Err(Error(msg));

// Setup: Result with a traced error
@fail () -> Result<int, Error> =
    Err(Error("fail"));

@traced () -> Result<int, Error> = {
    let x = fail()?;
    Ok(x)
}

// Result.has_trace() delegates. The post-`?` trace-DATA (has_trace() == true)
// is interpreter-only: the AOT backend has no `?`-hop trace-injection machinery
// yet. The traceless delegation dispatch IS covered in AOT (the Ok-path +
// fresh-Err tests below stay dual-exec).
#skip(backend: "llvm", reason: "AOT has no ?-hop trace injection yet")
@test_has tests @has () -> void = {
    let r = traced();
    assert(cond: r.has_trace())
}

@has () -> bool = {
    let r = traced();
    r.has_trace()
}

// Result.trace() delegates — post-`?` trace-DATA, interpreter-only.
#skip(backend: "llvm", reason: "AOT has no ?-hop trace injection yet")
@test_trace tests @trace () -> void = {
    let r = traced();
    assert(cond: r.trace() != "")
}

@trace () -> bool = {
    let r = traced();
    r.trace() != ""
}

// Result.trace_entries() delegates — post-`?` trace-DATA, interpreter-only.
#skip(backend: "llvm", reason: "AOT has no ?-hop trace injection yet")
@test_entries tests @entries () -> void = {
    let r = traced();
    assert_eq(
        actual: r.trace_entries().len(),
        expected: 1,
    )
}

@entries () -> int = {
    let r = traced();
    r.trace_entries().len()
}

// Ok has no trace
@test_ok_has tests @ok_has () -> void = {
    let r = mk_ok(v: 42);
    assert_eq(
        actual: r.has_trace(),
        expected: false,
    )
}

@ok_has () -> bool = {
    let r = mk_ok(v: 42);
    r.has_trace()
}

@test_ok_trace tests @ok_trace () -> void = {
    let r = mk_ok(v: 42);
    assert_eq(actual: r.trace(), expected: "")
}

@ok_trace () -> str = {
    let r = mk_ok(v: 42);
    r.trace()
}

@test_ok_entries tests @ok_entries () -> void =
    {
        let r = mk_ok(v: 42);
        assert_eq(
            actual: r.trace_entries().len(),
            expected: 0,
        )
    }

@ok_entries () -> int = {
    let r = mk_ok(v: 42);
    r.trace_entries().len()
}

// Fresh Err (no ?) has no trace
@test_fresh tests @fresh () -> void = {
    let r = mk_err(msg: "fresh");
    assert_eq(
        actual: r.has_trace(),
        expected: false,
    )
}

@fresh () -> bool = {
    let r = mk_err(msg: "fresh");
    r.has_trace()
}
