// Spec: 07-properties-of-types.md § Traceable
// Trait is defined, methods accessible

use std.testing { assert_eq, assert }

// Helpers bind Result<T, Error> via function return type so Ok-side E is inferable
@mk_err (msg: str) -> Result<int, Error> = Err(Error(msg));
@mk_ok (v: int) -> Result<int, Error> = Ok(v);

// Error type works with Err()
@err_result_reports_is_err tests @err () -> void = {
    let r = mk_err(msg: "hello");
    assert(cond: r.is_err())
}

@err () -> bool = {
    let r = mk_err(msg: "hello");
    r.is_err()
}

// has_trace callable on Result<T, Error>
@err_result_has_no_trace tests @has () -> void = {
    let r = mk_err(msg: "test");
    assert_eq(
        actual: r.has_trace(),
        expected: false,
    )
}

@has () -> bool = {
    let r = mk_err(msg: "test");
    r.has_trace()
}

// trace() callable on Result<T, Error>
@err_result_trace_is_empty tests @trace () -> void = {
    let r = mk_err(msg: "test");
    assert_eq(
        actual: r.trace(),
        expected: "",
    )
}

@trace () -> str = {
    let r = mk_err(msg: "test");
    r.trace()
}

// trace_entries() callable
@err_result_has_zero_trace_entries tests @entries () -> void = {
    let r = mk_err(msg: "test");
    assert_eq(
        actual: r.trace_entries().len(),
        expected: 0,
    )
}

@entries () -> int = {
    let r = mk_err(msg: "test");
    r.trace_entries().len()
}

// All methods work on Ok variant
@ok_variant_has_no_trace tests @ok () -> void = {
    let r = mk_ok(v: 42);
    assert_eq(
        actual: r.has_trace(),
        expected: false,
    );
    assert_eq(
        actual: r.trace(),
        expected: "",
    );
    assert_eq(
        actual: r.trace_entries().len(),
        expected: 0,
    )
}

@ok () -> bool = {
    let r = mk_ok(v: 42);
    r.has_trace() == false
}
