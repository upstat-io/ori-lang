// Spec: 07-properties-of-types.md § Traceable
// Regression: a non-scalar Traceable accessor (`trace_entries() -> [TraceEntry]`)
// on the `Error` payload `e`, as the TAIL value of a `match` arm, emitted
// malformed LLVM IR (E5001) — the poisoned scalar was fed into the aggregate
// {i64, i64, ptr} match phi. Interp succeeded; LLVM build failed (L9 parity).

use std.testing { assert_eq }

@fail () -> Result<int, Error> = Err(Error("fail"));

@one_hop () -> Result<int, Error> = {
    let x = fail()?;
    Ok(x)
}

// Variant 1: the non-scalar accessor is the arm's tail value; the arm result
// type is the aggregate list `[TraceEntry]`.
@entries_via_match () -> [TraceEntry] = {
    match one_hop() {
        Ok(_) -> [],
        Err(e) -> e.trace_entries(),
    }
}

#skip("BUG-04-277: JIT test-worker SIGSEGV — any [T]-returning match consumed via .len() chained inline crashes the LLVM test-worker; unrelated to Traceable dispatch, reproduces with a plain [int]")
@test_entries_list tests @entries_via_match () -> void = {
    assert_eq(
        actual: entries_via_match().len(),
        expected: 1,
    )
}
