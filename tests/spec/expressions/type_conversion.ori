// Spec: 14-expressions.md § Conversion Expressions
// Infallible `as` conversions, dual-backend (interpreter + LLVM).
//
// Fallible `as?` conversions and str-parse conversions (str as int,
// str as float, value as str) have no LLVM emission path yet — those
// cells are tracked and land with the cast-runtime surface.

use std.testing { assert, assert_eq };

// int -> float (sitofp)

@test_int_as_float_positive_converts tests _ () -> void = {
    let f = 42 as float;

    assert(cond: f > 41.9);
    assert(cond: f < 42.1)
}

@test_int_as_float_zero_converts tests _ () -> void = {
    let f = 0 as float;

    assert_eq(actual: f, expected: 0.0)
}

@test_int_as_float_negative_converts tests _ () -> void = {
    let f = -100 as float;

    assert(cond: f < -99.9);
    assert(cond: f > -100.1)
}

// float -> int (saturating: truncates toward zero; NaN -> 0;
// out-of-range clamps to int MIN/MAX)

@test_float_as_int_truncates_toward_zero tests _ () -> void = {
    assert_eq(actual: 3.99 as int, expected: 3);
    assert_eq(actual: -3.99 as int, expected: -3)
}

@test_float_as_int_nan_saturates_to_zero tests _ () -> void = {
    let nan = 0.0 / 0.0;

    assert_eq(actual: nan as int, expected: 0)
}

@test_float_as_int_infinities_clamp tests _ () -> void = {
    let pos_inf = 1.0 / 0.0;
    let neg_inf = -1.0 / 0.0;
    let int_max = 9223372036854775807;

    assert_eq(actual: pos_inf as int, expected: int_max);
    assert_eq(actual: neg_inf as int, expected: -int_max - 1)
}

@test_float_as_int_out_of_range_clamps tests _ () -> void = {
    let huge = 1.0e30;
    let neg_huge = -1.0e30;
    let int_max = 9223372036854775807;

    assert_eq(actual: huge as int, expected: int_max);
    assert_eq(actual: neg_huge as int, expected: -int_max - 1)
}

// int -> byte (range-checked 0..=255; panics out of range)

@test_int_as_byte_boundary_values_round_trip tests _ () -> void = {
    let lo = 0 as byte;
    let hi = 255 as byte;
    let mid = 200 as byte;

    assert_eq(actual: lo as int, expected: 0);
    assert_eq(actual: hi as int, expected: 255);
    assert_eq(actual: mid as int, expected: 200)
}

#fail("out of range for byte")
@test_int_as_byte_above_range_panics tests _ () -> void = {
    let b = 256 as byte;

    assert_eq(actual: b as int, expected: 0)
}

#fail("out of range for byte")
@test_int_as_byte_negative_panics tests _ () -> void = {
    let b = -1 as byte;

    assert_eq(actual: b as int, expected: 0)
}

// char -> int (zext of the Unicode scalar value)

@test_char_as_int_yields_codepoint tests _ () -> void = {
    assert_eq(actual: 'A' as int, expected: 65);
    assert_eq(actual: '0' as int, expected: 48)
}

// int -> char (validity-checked Unicode scalar; panics on invalid)

@test_int_as_char_ascii_converts tests _ () -> void = {
    assert_eq(actual: 65 as char, expected: 'A');
    assert_eq(actual: 97 as char, expected: 'a')
}

@test_int_as_char_scalar_boundaries_round_trip tests _ () -> void = {
    // Last codepoint below the surrogate gap, first above it, and the
    // maximum Unicode scalar value.
    assert_eq(actual: (55295 as char) as int, expected: 55295);
    assert_eq(actual: (57344 as char) as int, expected: 57344);
    assert_eq(actual: (1114111 as char) as int, expected: 1114111)
}

#fail("not a valid Unicode codepoint")
@test_int_as_char_low_surrogate_panics tests _ () -> void = {
    let c = 55296 as char;

    assert_eq(actual: c as int, expected: 0)
}

#fail("not a valid Unicode codepoint")
@test_int_as_char_high_surrogate_panics tests _ () -> void = {
    let c = 57343 as char;

    assert_eq(actual: c as int, expected: 0)
}

#fail("not a valid Unicode codepoint")
@test_int_as_char_above_max_scalar_panics tests _ () -> void = {
    let c = 1114112 as char;

    assert_eq(actual: c as int, expected: 0)
}

#fail("not a valid Unicode codepoint")
@test_int_as_char_negative_panics tests _ () -> void = {
    let c = -1 as char;

    assert_eq(actual: c as int, expected: 0)
}

// Values whose low 32 bits form a valid codepoint must still be
// rejected — 4294967361 is 2^32 + 65; truncating before validation
// would wrongly produce 'A'.
#fail("not a valid Unicode codepoint")
@test_int_as_char_beyond_u32_panics tests _ () -> void = {
    let c = 4294967361 as char;

    assert_eq(actual: c as int, expected: 0)
}

// byte -> int (zext)

@test_byte_as_int_max_round_trips tests _ () -> void = {
    let b = 255 as byte;

    assert_eq(actual: b as int, expected: 255)
}

// Identity conversion (no-op)

@test_int_as_int_is_identity tests _ () -> void = {
    assert_eq(actual: 42 as int, expected: 42)
}

// Precedence: `as` binds tighter than arithmetic

@test_as_binds_tighter_than_addition tests _ () -> void = {
    let result = 10 as float + 5.0;

    assert(cond: result > 14.9);
    assert(cond: result < 15.1)
}

@test_parenthesized_sum_converts tests _ () -> void = {
    let sum = (10 + 20) as float;

    assert(cond: sum > 29.9);
    assert(cond: sum < 30.1)
}

// Chained conversion through arithmetic

@test_char_arithmetic_round_trips_through_int tests _ () -> void = {
    let next = ('A' as int + 1) as char;

    assert_eq(actual: next, expected: 'B')
}
