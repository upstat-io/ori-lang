// Spec: 09-expressions.md § Index Access
// Negative indices are out of bounds; use `# - n` for from-the-end indexing.

#fail("out of bounds")
@test_list_negative_index tests @list_negative_index () -> void = {
    let _ = list_negative_index();
    ()
}

@list_negative_index () -> int = [10, 20, 30][-1];

#fail("out of bounds")
@test_str_negative_index tests @str_negative_index () -> void = {
    let _ = str_negative_index();
    ()
}

@str_negative_index () -> str = "hello"[-1];
