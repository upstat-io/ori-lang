// Negative pin: unsupported arithmetic operators must be rejected.
// These tests verify the type checker queries the registry for operator support.
// Spec: 09-expressions.md § Operator Type Constraints

// Str only supports + (concatenation), not other arithmetic ops.
#compile_fail("Sub")
@str_sub () -> str = "hello" - "world";

#compile_fail("Mul")
@str_mul () -> str = "hello" * "world";

#compile_fail("Div")
@str_div () -> str = "hello" / "world";

// List only supports + (concatenation), not other arithmetic ops.
#compile_fail("Sub")
@list_sub () -> [int] = [1, 2] - [3, 4];

#compile_fail("Mul")
@list_mul () -> [int] = [1, 2] * [3, 4];
