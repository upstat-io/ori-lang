@test_list_destructure_rest_slice_no_leak tests @list_destructure_rest_slice_no_leak () -> void = {
    assert_eq(actual: list_destructure_rest_slice_no_leak(), expected: 2)
}

@list_destructure_rest_slice_no_leak () -> int = {
