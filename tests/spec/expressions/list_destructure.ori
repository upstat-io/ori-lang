}

@list_destructure_str () -> int = {
    let [$a, $b, ..rest] = ["hello", "world", "extra"];
    a.length() + b.length()
}

@test_list_destructure_bool tests @list_destructure_bool () -> void = {
    assert_eq(actual: list_destructure_bool(), expected: true)
}

@list_destructure_bool () -> bool = {
    let [$x, $y] = [true, false];
    x && !y
}

