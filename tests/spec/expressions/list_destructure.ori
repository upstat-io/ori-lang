// Spec: 10-patterns.md § List Destructuring;;
// Regression: BUG-04-086 — LLVM list-pattern destructuring used field
// projection on the fat-pointer struct {len, cap, data} instead of __index
// protocol calls. Same root cause appears in let-binding lowering
// (lower/patterns/mod.rs::CanBindingPattern::List) and in match decision-tree
// lowering (decision_tree/emit.rs::PathInstruction::ListElement). Plan dir:
//

use std.testing { assert, assert_eq, assert_ne }

type Point = { x: int, y: int }

// =============================================================================
// Length axis — heads count varies, with/without rest
// =============================================================================

@test_list_destructure_single_head_no_rest tests @list_destructure_single_head_no_rest () -> void = {
    assert_eq(actual: list_destructure_single_head_no_rest(), expected: 42)
}

@list_destructure_single_head_no_rest () -> int = {
    let [$a] = [42];
    a
}

@test_list_destructure_single_head_with_rest tests @list_destructure_single_head_with_rest () -> void = {
    assert_eq(actual: list_destructure_single_head_with_rest(), expected: 12)
}

@list_destructure_single_head_with_rest () -> int = {
    let [$a, ..rest] = [10, 20, 30];
    a + rest.len()
}

@test_list_destructure_three_heads_no_rest tests @list_destructure_three_heads_no_rest () -> void = {
    assert_eq(actual: list_destructure_three_heads_no_rest(), expected: 123)
}

@list_destructure_three_heads_no_rest () -> int = {
    let [$a, $b, $c] = [1, 2, 3];
    a * 100 + b * 10 + c
}

@test_list_destructure_three_heads_with_rest tests @list_destructure_three_heads_with_rest () -> void = {
    assert_eq(actual: list_destructure_three_heads_with_rest(), expected: 8)
}

@list_destructure_three_heads_with_rest () -> int = {
    let [$a, $b, $c, ..rest] = [1, 2, 3, 4, 5];
    a + b + c + rest.len()
}

@test_list_destructure_rest_only tests @list_destructure_rest_only () -> void = {
    assert_eq(actual: list_destructure_rest_only(), expected: 3)
}

@list_destructure_rest_only () -> int = {
    let [..rest] = [1, 2, 3];
    rest.len()
}

@test_list_destructure_empty_list_with_rest_only tests @list_destructure_empty_list_with_rest_only () -> void = {
    assert_eq(actual: list_destructure_empty_list_with_rest_only(), expected: 0)
}

@list_destructure_empty_list_with_rest_only () -> int = {
    let items: [int] = [];
    let [..rest] = items;
    rest.len()
}

