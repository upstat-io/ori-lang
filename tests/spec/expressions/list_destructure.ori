// =============================================================================
// Semantic + negative pins — match-based for CF-3 future-proofing
// =============================================================================
// Match-based pins remain valid post-CF-3 (typeck.md §CF-3 only restricts
// `let` patterns; `match` permits refutable patterns). Once BUG-02-022 lands,
// the let-binding cells above migrate to #compile_fail("E2001"); these
// match-based pins remain the permanent regression guard.

@test_list_destructure_semantic_pin_via_match tests @list_destructure_semantic_pin_via_match () -> void = {
    let items = [1, 2, 3];
    let result = match items {
        [first, second, ..rest] -> first + second,
        _ -> -1
    };
    assert_eq(actual: result, expected: 3)
}

@list_destructure_semantic_pin_via_match () -> int = {
    let items = [1, 2, 3];
    match items {
        [first, second, ..rest] -> first + second,
        _ -> -1
    }
}

@test_list_destructure_negative_pin_via_match tests @list_destructure_negative_pin_via_match () -> void = {
    let items = [1, 2, 3];
    let result = match items {
        [first, second, ..rest] -> first + second,
        _ -> -1
    };
    assert_ne(actual: result, unexpected: 6)
}

@list_destructure_negative_pin_via_match () -> int = {
    let items = [1, 2, 3];
    match items {
        [first, second, ..rest] -> first + second,
        _ -> -1
    }
}

// =============================================================================
// Reference / always-passing-pre-fix
// =============================================================================
// These tests pass under current code AND under the fix; they pin behavior
// the fix MUST preserve. A regression in the fix would convert them to RED.

@test_match_list_too_short_falls_through_to_wildcard tests @match_list_too_short_falls_through_to_wildcard () -> void = {
    assert_eq(actual: match_list_too_short_falls_through_to_wildcard(), expected: 0)
}

@match_list_too_short_falls_through_to_wildcard () -> int = {
    match [42] {
        [a, b] -> a + b,
        _ -> 0
    }
}

#fail("out of bounds")
@test_direct_indexing_oob_panics tests @direct_indexing_oob_panics () -> void = {
    let _ = direct_indexing_oob_panics();
    ()
}

@direct_indexing_oob_panics () -> int = {
    let xs = [42];
    xs[1]
}

// =============================================================================
// Transient let-form OOB — DEFERRED pending parity + CF-3
// =============================================================================
// Cell `test_list_destructure_let_too_short_*` originally pinned the runtime
// OOB panic of `let [$a, $b] = [42]`. Cannot be expressed as a single
// `#fail("...")` substring because the interpreter and post-fix LLVM
// diverge on the panic message:
//   - Interpreter (`ori_eval/.../control_flow.rs`): "list pattern too long
//     for value" — pre-indexing length check.
//   - LLVM post-BUG-04-086-fix: "index out of bounds" — `ori_list_get`
//     bounds check at indexing time.
// Cross-backend divergence in error messages is a dual-execution-parity bug
// distinct from BUG-04-086's value-correctness invariant. Filed separately.
// Once BUG-02-022 (CF-3 enforcement) lands, this case becomes
// `#compile_fail("E2001")` and the runtime divergence becomes unreachable.
// Direct-indexing OOB parity is already pinned by
// `test_direct_indexing_oob_panics` (uniform across backends via the
// indexing protocol).
