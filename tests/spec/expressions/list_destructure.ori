// =============================================================================
// Match-path parity — decision_tree/emit.rs::PathInstruction::ListElement fix
// =============================================================================

@test_match_list_two_heads tests @match_list_two_heads () -> void = {
    assert_eq(actual: match_list_two_heads(), expected: 210)
}

@match_list_two_heads () -> int = {
    match [10, 20, 30] {
        [a, b, ..rest] -> a + b * 10,
        _ -> 0
    }
}

@test_match_list_three_heads_no_rest tests @match_list_three_heads_no_rest () -> void = {
    assert_eq(actual: match_list_three_heads_no_rest(), expected: 6)
}

@match_list_three_heads_no_rest () -> int = {
    match [1, 2, 3] {
        [a, b, c] -> a + b + c,
        _ -> 0
    }
}

@test_match_list_str_elements tests @match_list_str_elements () -> void = {
    assert_eq(actual: match_list_str_elements(), expected: "xy")
}

@match_list_str_elements () -> str = {
    match ["x", "y", "z"] {
        [a, b, ..rest] -> a + b,
        _ -> ""
    }
}

