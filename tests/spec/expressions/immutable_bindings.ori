// Spec: 05-variables.md § Destructuring, grammar.ebnf § binding_pattern
// Tests for $ (immutable) prefix in destructuring binding patterns.

use std.testing { assert_eq }

// =============================================================================
// Simple immutable binding (should already work)
// =============================================================================

@test_simple_immutable tests @simple_immutable () -> void = {
    assert_eq(actual: simple_immutable(), expected: 42)
}

@simple_immutable () -> int = {
    let $x = 42;
    x
}

// =============================================================================
// Tuple destructuring with $ prefix
// =============================================================================

@test_tuple_immutable tests @tuple_immutable () -> void = {
    assert_eq(actual: tuple_immutable(), expected: 3)
}

@tuple_immutable () -> int = {
    let ($a, $b) = (1, 2);
    a + b
}

// =============================================================================
// Struct destructuring with $ prefix
// =============================================================================

type Point = { x: int, y: int }

@test_struct_immutable tests @struct_immutable () -> void = {
    assert_eq(actual: struct_immutable(), expected: 30)
}

@struct_immutable () -> int = {
    let p = Point { x: 10, y: 20 };
    let { $x, $y } = p;
    x + y
}

// =============================================================================
// Struct destructuring with mixed mutability
// =============================================================================

@test_struct_mixed tests @struct_mixed () -> void = {
    assert_eq(actual: struct_mixed(), expected: 30)
}

@struct_mixed () -> int = {
    let p = Point { x: 10, y: 20 };
    let { $x, y } = p;
    x + y
}

// =============================================================================
// List destructuring — refutable `let` rejected (CF-3)
//
// Spec 15.4 + 15-patterns.md:276-281: the irrefutability-context table marks
// `let` and `for` binders as MUST-be-irrefutable. A multi-element list pattern
// against `[T]` (dynamic length) is refutable and produces E2001.
//
// Migrates the BUG-04-086 transient `@test_list_immutable` (which exercised
// `let [$first, $second, ..rest] = items`) to a `#compile_fail` negative pin
// on the same surface, plus a sibling positive test that preserves the
// original "sum first two of a 3-list" intent through the spec-conformant
// `match` binding path.
// =============================================================================

#compile_fail(code: "E2001", message: "refutable pattern in let-binding")
@test_list_immutable_refutable_let_rejects tests _ () -> void = {
    let items = [1, 2, 3];
    let [$first, $second, ..rest] = items
}

@test_list_immutable_via_match tests _ () -> void = {
    let items = [1, 2, 3];
    let result = match items {
        [first, second, ..rest] -> first + second,
        _ -> panic(msg: "expected non-empty list"),
    };
    assert_eq(actual: result, expected: 3)
}

// =============================================================================
// Struct destructuring with rename and $ prefix
// =============================================================================

@test_struct_rename_immutable tests @struct_rename_immutable () -> void = {
    assert_eq(actual: struct_rename_immutable(), expected: 30)
}

@struct_rename_immutable () -> int = {
    let p = Point { x: 10, y: 20 };
    let { x: $px, y: $py } = p;
    px + py
}
