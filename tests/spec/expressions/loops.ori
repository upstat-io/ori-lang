// Spec: 09-expressions.md § For Expression, § Loop Expression
// Spec: 19-control-flow.md § Loop Control, § Labeled Loops
// Tests for for/do, for/yield, loop {}, break, continue, labels

use std.testing { assert, assert_eq }

// For-Do Basic

@test_for_do_basic tests @for_do_basic () -> void = {
    let sum = 0;
    for x in [1, 2, 3] do sum = sum + x;
    assert_eq(actual: sum, expected: 6)
}

@for_do_basic () -> int = {
    let sum = 0;
    for x in [1, 2, 3] do sum = sum + x;
    sum
}

@test_for_do_empty tests @for_do_empty () -> void = {
    let called = false;
    let empty: [int] = [];
    for x in empty do called = true;
    assert(cond: !called)
}

@for_do_empty () -> bool = {
    let called = false;
    let empty: [int] = [];
    for x in empty do called = true;
    called
}

@test_for_do_returns_void tests _ () -> void = {
    let sum = 0;
    let result: void = for x in [1, 2, 3] do sum = sum + x;
    assert_eq(actual: sum, expected: 6);
    result
}

// For-Do with Guard

@test_for_do_with_guard tests @for_do_with_guard () -> void = {
    let sum = 0;
    for x in [1, 2, 3, 4, 5] if x % 2 == 0 do sum = sum + x;
    assert_eq(actual: sum, expected: 6) // 2 + 4
}

@for_do_with_guard () -> int = {
    let sum = 0;
    for x in [1, 2, 3, 4, 5] if x % 2 == 0 do sum = sum + x;
    sum
}

@test_for_do_guard_all_filtered tests @for_do_guard_all_filtered () -> void = {
    let count = 0;
    for x in [1, 3, 5] if x % 2 == 0 do count = count + 1;
    assert_eq(actual: count, expected: 0)
}

@for_do_guard_all_filtered () -> int = {
    let count = 0;
    for x in [1, 3, 5] if x % 2 == 0 do count = count + 1;
    count
}

// For-Yield Basic

@test_for_yield_basic tests @for_yield_basic () -> void = {
    let result = for x in [1, 2, 3] yield x * 2;
    assert_eq(actual: result, expected: [2, 4, 6])
}

@for_yield_basic () -> [int] = for x in [1, 2, 3] yield x * 2;

@test_for_yield_empty tests @for_yield_empty () -> void = {
    let empty: [int] = [];
    let result = for x in empty yield x * 2;
    assert_eq(actual: result, expected: [])
}

@for_yield_empty () -> [int] = {
    let empty: [int] = [];
    for x in empty yield x * 2
}

@test_for_yield_identity tests @for_yield_identity () -> void = {
    let result = for x in [1, 2, 3] yield x;
    assert_eq(actual: result, expected: [1, 2, 3])
}

@for_yield_identity () -> [int] = for x in [1, 2, 3] yield x;

// For-Yield with Guard

@test_for_yield_with_guard tests @for_yield_with_guard () -> void = {
    let result = for x in [1, 2, 3, 4, 5] if x % 2 == 0 yield x;
    assert_eq(actual: result, expected: [2, 4])
}

@for_yield_with_guard () -> [int] = for x in [1, 2, 3, 4, 5] if x % 2 == 0 yield x;

@test_for_yield_guard_transform tests @for_yield_guard_transform () -> void = {
    let result = for x in [1, 2, 3, 4, 5] if x > 2 yield x * 10;
    assert_eq(actual: result, expected: [30, 40, 50])
}

@for_yield_guard_transform () -> [int] = for x in [1, 2, 3, 4, 5] if x > 2 yield x * 10;

// For with Destructuring

@test_for_tuple_destructure tests @for_tuple_destructure () -> void = {
    let pairs = [(1, "a"), (2, "b"), (3, "c")];
    let sum = 0;
    for (n, _) in pairs do sum = sum + n;
    assert_eq(actual: sum, expected: 6)
}

@for_tuple_destructure () -> int = {
    let pairs = [(1, "a"), (2, "b")];
    let sum = 0;
    for (n, _) in pairs do sum = sum + n;
    sum
}

type Point = { x: int, y: int }

@test_for_struct_destructure tests @for_struct_destructure () -> void = {
    let points = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }];
    let xs = for p in points yield p.x;
    assert_eq(actual: xs, expected: [1, 3])
}

@for_struct_destructure () -> [int] = {
    let points = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }];
    for p in points yield p.x
}

// Nested For

@test_nested_for_do tests @nested_for_do () -> void = {
    let sum = 0;
    for x in [1, 2] do
        for y in [10, 20] do
            sum = sum + x * y;
    assert_eq(actual: sum, expected: 90) // 1*10 + 1*20 + 2*10 + 2*20
}

@nested_for_do () -> int = {
    let sum = 0;
    for x in [1, 2] do
        for y in [10, 20] do
            sum = sum + x * y;
    sum
}

@test_nested_for_yield tests @nested_for_yield () -> void = {
    let result = for x in [1, 2] yield for y in [10, 20] yield x + y;
    assert_eq(actual: result, expected: [[11, 21], [12, 22]])
}

@nested_for_yield () -> [[int]] = for x in [1, 2] yield for y in [10, 20] yield x + y;

// Loop Basic

@test_loop_with_break tests @loop_with_break () -> void = {
    let count = 0;
    loop {
        count = count + 1;
        if count >= 5 then break
    };
    assert_eq(actual: count, expected: 5)
}

@loop_with_break () -> int = {
    let count = 0;
    loop {
        count = count + 1;
        if count >= 5 then break
    };
    count
}

@test_loop_break_value tests @loop_break_value () -> void = {
    let result = loop {
        let x = 42;
        break x
    };
    assert_eq(actual: result, expected: 42)
}

@loop_break_value () -> int = loop {
    let x = 42;
    break x
}

@test_loop_conditional_break tests @loop_conditional_break () -> void = {
    let n = 0;
    let result = loop {
        n = n + 1;
        if n > 10 then break n * 2
    };
    assert_eq(actual: result, expected: 22) // 11 * 2
}

@loop_conditional_break () -> int = {
    let n = 0;
    loop {
        n = n + 1;
        if n > 10 then break n * 2
    }
}

// Loop with Continue

@test_loop_continue tests @loop_continue () -> void = {
    let count = 0;
    let sum = 0;
    loop {
        count = count + 1;
        if count > 10 then break;
        if count % 2 == 0 then continue; // Skip even numbers
        sum = sum + count
    };
    assert_eq(actual: sum, expected: 25) // 1 + 3 + 5 + 7 + 9
}

@loop_continue () -> int = {
    let count = 0;
    let sum = 0;
    loop {
        count = count + 1;
        if count > 10 then break;
        if count % 2 == 0 then continue;
        sum = sum + count
    };
    sum
}

// For with Break

@test_for_do_break tests @for_do_break () -> void = {
    let sum = 0;
    for x in [1, 2, 3, 4, 5] do {
        if x == 4 then break;
        sum = sum + x
    };
    assert_eq(actual: sum, expected: 6) // 1 + 2 + 3
}

@for_do_break () -> int = {
    let sum = 0;
    for x in [1, 2, 3, 4, 5] do {
        if x == 4 then break;
        sum = sum + x
    };
    sum
}

@test_for_yield_break tests @for_yield_break () -> void = {
    let result = for x in [1, 2, 3, 4, 5] yield {
        if x == 4 then break;
        x * 2
    };
    assert_eq(actual: result, expected: [2, 4, 6])
}

@for_yield_break () -> [int] = for x in [1, 2, 3, 4, 5] yield {
    if x == 4 then break;
    x * 2
}

@test_for_yield_break_value tests @for_yield_break_value () -> void = {
    let result = for x in [1, 2, 3, 4, 5] yield {
        if x == 4 then break 99;
        x
    };
    // Break adds final element
    assert_eq(actual: result, expected: [1, 2, 3, 99])
}

@for_yield_break_value () -> [int] = for x in [1, 2, 3, 4, 5] yield {
    if x == 4 then break 99;
    x
}

// For with Continue

@test_for_do_continue tests @for_do_continue () -> void = {
    let sum = 0;
    for x in [1, 2, 3, 4, 5] do {
        if x == 3 then continue;
        sum = sum + x
    };
    assert_eq(actual: sum, expected: 12) // 1 + 2 + 4 + 5
}

@for_do_continue () -> int = {
    let sum = 0;
    for x in [1, 2, 3, 4, 5] do {
        if x == 3 then continue;
        sum = sum + x
    };
    sum
}

@test_for_yield_continue tests @for_yield_continue () -> void = {
    let result = for x in [1, 2, 3, 4, 5] yield {
        if x == 3 then continue;
        x
    };
    assert_eq(actual: result, expected: [1, 2, 4, 5])
}

@for_yield_continue () -> [int] = for x in [1, 2, 3, 4, 5] yield {
    if x == 3 then continue;
    x
}

@test_for_yield_continue_value tests @for_yield_continue_value () -> void = {
    let result = for x in [1, 2, 3, 4, 5] yield {
        if x == 3 then continue 0;
        x
    };
    assert_eq(actual: result, expected: [1, 2, 0, 4, 5])
}

@for_yield_continue_value () -> [int] = for x in [1, 2, 3, 4, 5] yield {
    if x == 3 then continue 0;
    x
}

// Labeled Loops (NOT YET IMPLEMENTED)

// Note: Labeled loops (loop:name, for:name, break:name, continue:name) are
// specified but not yet implemented in the compiler. These tests are
// commented out until the feature is available.

// When implemented, tests should cover:
// - loop:name with break:name
// - loop:name with break:name value
// - for:name with continue:name
// - Nested labeled loops

// Loop Type Inference

@test_loop_void tests @loop_void () -> void = {
    let count = 0;
    loop {
        count = count + 1;
        if count >= 3 then break
    };
    // No value from break, loop is void
    assert_eq(actual: count, expected: 3)
}

@loop_void () -> void = {
    let count = 0;
    loop {
        count = count + 1;
        if count >= 3 then break
    }
}

@test_loop_int tests @loop_int () -> void = {
    let result: int = loop {break 42};
    assert_eq(actual: result, expected: 42)
}

@loop_int () -> int = loop {break 42}

// Complex Patterns
//
// Regression: labeled `break:outer value` from a nested BARE inner `loop`
// propagates to the outer labeled `loop` (Spec: Clause 16.3.3). Nested bare
// loops carry NO iterator/accumulator, so this pins the label-routing
// value-correctness on BOTH backends with no abandon-path RC surface — the
// permanent regression guard for the ControlAction.label (eval) + LoopContext
// stack (ARC) threading. Fails if the fix is reverted (innermost consumes
// `break:outer`, never reaching the outer loop).
@test_nested_loop_labeled_break tests @nested_loop_labeled_break () -> void = {
    assert_eq(actual: nested_loop_labeled_break(), expected: 2)
}

@nested_loop_labeled_break () -> int = {
    loop:outer {
        loop {
            break:outer 2
        }
    }
}

// Regression: nested labeled `break:outer` from an inner `for` propagates to
// the outer labeled `loop` (Spec: Clause 16.3.3). The label is threaded through
// evaluator control actions and the compiled loop-context stack. The compiled
// abandon path must also clean up the inner iterator when the labeled break
// skips its normal exit.
@test_find_first tests @find_first () -> void = {
    assert_eq(actual: find_first(), expected: 8)
}

@find_first () -> int = {
    let items = [1, 3, 5, 8, 10];
    loop:outer {
        for x in items do {
            if x % 2 == 0 then break:outer x
        };
        break 0
    }
}

// Regression: a labeled continue that abandons an inner iterator must run the
// same iterator cleanup as a labeled break before resuming the outer loop.
@test_labeled_continue_cleanup tests @labeled_continue_cleanup () -> void = {
    assert_eq(actual: labeled_continue_cleanup(), expected: 3)
}

@labeled_continue_cleanup () -> int = {
    let rounds = 0;
    loop:outer {
        rounds += 1;
        if rounds >= 3 then break rounds;
        for _ in [1, 2] do {
            continue:outer
        }
    }
}

@test_flatten_with_break tests @flatten_with_break () -> void = {
    let matrix = [[1, 2], [3, 4], [5, 6]];
    let count = 0;
    for row in matrix do {
        for x in row do {
            if x == 4 then break;
            count = count + x
        }
    };
    // Breaks inner loop at 4, continues to next row
    // 1 + 2 + 3 + 5 + 6 = 17
    assert_eq(actual: count, expected: 17)
}

@flatten_with_break () -> int = {
    let matrix = [[1, 2], [3, 4], [5, 6]];
    let count = 0;
    for row in matrix do {
        for x in row do {
            if x == 4 then break;
            count = count + x
        }
    };
    count
}

@test_accumulate_until tests @accumulate_until () -> void = {
    let sum = 0;
    let limit = 10;
    let i = 0;
    loop {
        sum = sum + i;
        i = i + 1;
        if sum >= limit then break
    };
    // 0 + 1 + 2 + 3 + 4 = 10 >= 10, break
    assert(cond: sum >= limit)
}

@accumulate_until () -> int = {
    let sum = 0;
    let i = 0;
    loop {
        sum = sum + i;
        i = i + 1;
        if sum >= 10 then break
    };
    sum
}

// Break in for-do with mutable variables (SSA exit block params)

// Break in for-range preserves mutable variable values at point of break.
@test_for_range_break_with_mutation tests @for_range_break_mutation () -> void = {
    assert_eq(actual: for_range_break_mutation(), expected: 10)
}

@for_range_break_mutation () -> int = {
    let count = 0;
    for i in 0..100 do {
        if i == 10 then break;
        count = count + 1;
    };
    count
}

// Break in for-range with multiple mutable variables.
@test_for_range_break_multi_mutation tests @for_range_break_multi () -> void = {
    assert_eq(actual: for_range_break_multi(), expected: 111)
}

@for_range_break_multi () -> int = {
    let steps = 0;
    let val = 27;
    for _ in 0..10000 do {
        if val == 1 then break;
        if val % 2 == 0 then val = val / 2
        else val = val * 3 + 1;
        steps = steps + 1;
    };
    steps  // Collatz sequence for 27 takes 111 steps
}

// Break in for-iterator (list iteration) preserves mutations.
@test_for_iter_break_with_mutation tests @for_iter_break_mutation () -> void = {
    assert_eq(actual: for_iter_break_mutation(), expected: 10)
}

@for_iter_break_mutation () -> int = {
    let xs = for i in 0..20 yield i;
    let sum = 0;
    for x in xs do {
        if x >= 5 then break;
        sum = sum + x;
    };
    sum  // 0 + 1 + 2 + 3 + 4 = 10
}

// Continue in for-range with mutations (already worked, verifying).
@test_for_range_continue_with_mutation tests @for_range_continue_mutation () -> void = {
    assert_eq(actual: for_range_continue_mutation(), expected: 25)
}

@for_range_continue_mutation () -> int = {
    let sum = 0;
    for i in 0..10 do {
        if i % 2 == 0 then continue;
        sum = sum + i;
    };
    sum  // 1 + 3 + 5 + 7 + 9 = 25
}

// Break + continue combined in same for-do with mutations.
@test_for_break_continue_combined tests @for_break_continue_combined () -> void = {
    assert_eq(actual: for_break_continue_combined(), expected: 9)
}

@for_break_continue_combined () -> int = {
    let sum = 0;
    for i in 0..100 do {
        if i >= 7 then break;
        if i % 2 == 0 then continue;
        sum = sum + i;
    };
    sum  // 1 + 3 + 5 = 9
}

// Break in for-do with no mutable variables (edge case: exit params are just break value).
@test_for_break_no_mutation tests @for_break_no_mutation () -> void = {
    assert_eq(actual: for_break_no_mutation(), expected: 42)
}

@for_break_no_mutation () -> int = {
    for i in 0..100 do {
        if i == 5 then break;
    };
    42
}

// Regression: for-loop GUARD-position break/continue
// `infer_for` pushed the loop context AFTER inferring the guard, so a
// guard-position break/continue resolved against the ENCLOSING loop while the
// for canon-desugar places the guard per-iteration inside the for's own loop —
// ARC then double-terminated a block (ICE "block N already terminated"). Fix
// pushes push_loop_context before guard inference (mirror of infer_while) and
// routes for-loop guard-branch lowering through a shared is_terminated guard.
// Spec: 16-control-flow.md § Loop Control — the guard runs per-iteration inside
// the for, so a guard-position break/continue targets the for, not an enclosing
// loop.

// Semantic pin (list/iterator): guard-position break targets the FOR. Builds +
// runs (pre-fix: ARC ICE at build). x=1,2 run the body; x=3 breaks the for.
@test_for_guard_break_targets_for tests @for_guard_break_targets_for () -> void = {
    assert_eq(actual: for_guard_break_targets_for(), expected: 2)
}

@for_guard_break_targets_for () -> int = {
    let count = 0;
    loop {
        for x in [1, 2, 3, 4, 5] if (if x == 3 then break else true) do count = count + 1;
        break
    };
    count
}

// Semantic pin (range): same, range iterable shape.
@test_for_guard_break_range tests @for_guard_break_range () -> void = {
    assert_eq(actual: for_guard_break_range(), expected: 2)
}

@for_guard_break_range () -> int = {
    let count = 0;
    loop {
        for x in 1..6 if (if x == 3 then break else true) do count = count + 1;
        break
    };
    count
}

// Semantic pin (continue): guard-position continue skips to the next FOR
// iteration. x=2,4 skipped via guard continue; body runs for x=1,3,5.
@test_for_guard_continue_targets_for tests @for_guard_continue_targets_for () -> void = {
    assert_eq(actual: for_guard_continue_targets_for(), expected: 3)
}

@for_guard_continue_targets_for () -> int = {
    let count = 0;
    loop {
        for x in [1, 2, 3, 4, 5] if (if x % 2 == 0 then continue else true) do count = count + 1;
        break
    };
    count
}

// Semantic pin (for-yield): guard-position break targets the for-yield, which
// collects the elements yielded before the break.
@test_for_yield_guard_break tests @for_yield_guard_break () -> void = {
    let got = for_yield_guard_break();
    let want = [10, 20];
    assert_eq(actual: got, expected: want)
}

@for_yield_guard_break () -> [int] = {
    loop {
        let ys = for x in [1, 2, 3, 4, 5] if (if x == 3 then break else true) yield x * 10;
        break ys
    }
}

// Negative pin — `break value` in a for-do guard is E0860 (for-do is void-typed).
// Only fires once the loop context is pushed before guard inference (the fix);
// pre-fix the guard resolves against no/the-enclosing context.
#compile_fail(code: "E0860")
@test_for_guard_break_value_rejected tests _ () -> void = {
    let sink = 0;
    for x in [1, 2, 3] if (break 5) do sink = x
}

// Negative pin — `continue value` in a for-do guard is E0861.
#compile_fail(code: "E0861")
@test_for_guard_continue_value_rejected tests _ () -> void = {
    let sink = 0;
    for x in [1, 2, 3] if (continue 5) do sink = x
}

// Positive pin — bare `break` / `continue` in guard position stay valid in any
// for form (the negative pins above must NOT reject the valueless forms).
@test_for_guard_bare_break tests @for_guard_bare_break () -> void = {
    assert_eq(actual: for_guard_bare_break(), expected: 2)
}

@for_guard_bare_break () -> int = {
    // x=1,3 run body (count 1,2); x=2 skipped via guard continue; x=4 breaks.
    let count = 0;
    for x in [1, 2, 3, 4, 5] if (if x > 3 then break else (if x == 2 then continue else true)) do count = count + 1;
    count
}

// Semantic pin (option iterable): guard-position break targets the for-option.
// Some(7): guard breaks the for before the body runs → count stays 0.
@test_for_guard_break_option tests @for_guard_break_option () -> void = {
    assert_eq(actual: for_guard_break_option(), expected: 0)
}

@for_guard_break_option () -> int = {
    let count = 0;
    loop {
        let opt = Some(7);
        for x in opt if (if x == 7 then break else true) do count = count + 1;
        break
    };
    count
}

// Semantic pin (yield-option iterable): guard-position break targets the
// for-yield-option; Some(5) breaks before yield → empty collection.
@test_for_yield_option_guard_break tests @for_yield_option_guard_break () -> void = {
    let got = for_yield_option_guard_break();
    let want: [int] = [];
    assert_eq(actual: got, expected: want)
}

@for_yield_option_guard_break () -> [int] = {
    loop {
        let opt = Some(5);
        let ys = for x in opt if (if x == 5 then break else true) yield x * 10;
        break ys
    }
}

// Non-regression (typeck-only) — a labeled `break:outer` in GUARD position
// type-checks against the LABELED loop, NOT the innermost for (the fix's reorder
// must not break labeled targeting). The labeled branch is dead at run time via
// `go = false` (runtime labeled break-to-outer propagation is a separate
// unimplemented surface); this pins the TYPECK property only,
// mirroring while.ori `labeled_break_outer_from_while`.
@test_for_guard_labeled_break_outer tests @for_guard_labeled_break_outer () -> void = {
    assert_eq(actual: for_guard_labeled_break_outer(), expected: 99)
}

@for_guard_labeled_break_outer () -> int = {
    let go = false;
    loop:outer {
        for x in [1, 2, 3] if (if go then break:outer 7 else true) do ();
        break 99
    }
}

// Guard-CONTINUE counterparts — every iterable shape (clamp: each break cell
// has a continue counterpart). Guard-position continue skips to the next FOR
// iteration; targets the for, not an enclosing loop.

// range continue: x=1,3,5 run body (even skipped) → count=3.
@test_for_guard_continue_range tests @for_guard_continue_range () -> void = {
    assert_eq(actual: for_guard_continue_range(), expected: 3)
}

@for_guard_continue_range () -> int = {
    let count = 0;
    for x in 1..6 if (if x % 2 == 0 then continue else true) do count = count + 1;
    count
}

// option continue: Some(4), 4 even → continue skips → count=0.
@test_for_guard_continue_option tests @for_guard_continue_option () -> void = {
    assert_eq(actual: for_guard_continue_option(), expected: 0)
}

@for_guard_continue_option () -> int = {
    let count = 0;
    let opt = Some(4);
    for x in opt if (if x % 2 == 0 then continue else true) do count = count + 1;
    count
}

// yield continue: odd elements yielded → [10, 30, 50].
@test_for_yield_guard_continue tests @for_yield_guard_continue () -> void = {
    let got = for_yield_guard_continue();
    let want = [10, 30, 50];
    assert_eq(actual: got, expected: want)
}

@for_yield_guard_continue () -> [int] = {
    for x in [1, 2, 3, 4, 5] if (if x % 2 == 0 then continue else true) yield x * 10
}

// yield-option continue: Some(3), 3 odd → yielded → [30].
@test_for_yield_option_guard_continue tests @for_yield_option_guard_continue () -> void = {
    let got = for_yield_option_guard_continue();
    // opt is Some(4): the guard's `continue` FIRES (4 is even), skipping the sole
    // element, so the yield-option continue_block exits with an empty list.
    let want: [int] = [];
    assert_eq(actual: got, expected: want)
}

@for_yield_option_guard_continue () -> [int] = {
    let opt = Some(4);
    for x in opt if (if x % 2 == 0 then continue else true) yield x * 10
}

// Non-regression (typeck-only) — labeled `continue:outer` in GUARD position
// type-checks against the LABELED loop. Dead at run time via `go = false`
// (runtime labeled-continue propagation is the separate unimplemented surface).
@test_for_guard_labeled_continue_outer tests @for_guard_labeled_continue_outer () -> void = {
    assert_eq(actual: for_guard_labeled_continue_outer(), expected: 7)
}

@for_guard_labeled_continue_outer () -> int = {
    let go = false;
    loop:outer {
        for x in [1, 2, 3] if (if go then continue:outer else true) do ();
        break 7
    }
}
