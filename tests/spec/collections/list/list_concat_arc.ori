// list.concat(other:) — ARC correctness matrix (BUG-04-187).
//
// `[T].concat()` is a dual-consuming PrimOp: the runtime owns consuming BOTH
// the receiver and the argument buffers (ARC realization emits no operand dec).
// On the JIT/`--backend=llvm` path a FastISel fat-pointer `cap` mis-load made
// `is_slice_cap(cap1)` read spuriously true, which both forced the slow path
// AND mis-directed `dec_list_buffer`, leaking the receiver. These cells pin:
//   - behavioral correctness (assert_eq result oracle), and
//   - leak-freedom (the --backend=llvm runner reports `ARC leak` per cell).
// They FAIL (leak) on the unfixed JIT path; the interp path is already clean.
//
// Matrix dimensions:
//   element type:  [int] [float] [bool] [str] [[int]] [Option<int>]
//   uniqueness:    unique receiver (fast path on AOT) | shared receiver (slow path both backends)
//   arrangement:   pair | chained | empty operand | literal receiver | slice receiver
// The shared-receiver and real-slice-receiver cells are the CLAMPS: they
// legitimately take the slow path / set is_slice_cap, so they distinguish the
// correct fix (cap loads correctly) from a wrong "force fast path always" fix.

use std.testing { assert_eq }

// =============================================================================
// Type dimension — unique receiver, pair concat (the minimal repro per type)
// =============================================================================

@concat_int () -> [int] = {
    let $a = [1, 2];
    let $b = [3, 4];
    a.concat(other: b)
}

@test_concat_int tests @concat_int () -> void = {
    assert_eq(actual: concat_int(), expected: [1, 2, 3, 4])
}

@concat_float () -> [float] = {
    let $a = [1.0, 2.0];
    let $b = [3.0, 4.0];
    a.concat(other: b)
}

@test_concat_float tests @concat_float () -> void = {
    assert_eq(actual: concat_float(), expected: [1.0, 2.0, 3.0, 4.0])
}

@concat_bool () -> [bool] = {
    let $a = [true, false];
    let $b = [true];
    a.concat(other: b)
}

@test_concat_bool tests @concat_bool () -> void = {
    assert_eq(actual: concat_bool(), expected: [true, false, true])
}

@concat_str () -> [str] = {
    let $a = ["x", "y"];
    let $b = ["z"];
    a.concat(other: b)
}

@test_concat_str tests @concat_str () -> void = {
    assert_eq(actual: concat_str(), expected: ["x", "y", "z"])
}

@concat_nested () -> [[int]] = {
    let $a = [[1, 2], [3]];
    let $b = [[4, 5]];
    a.concat(other: b)
}

@test_concat_nested tests @concat_nested () -> void = {
    assert_eq(actual: concat_nested(), expected: [[1, 2], [3], [4, 5]])
}

@concat_option () -> [Option<int>] = {
    let $a = [Some(1), None];
    let $b = [Some(2)];
    a.concat(other: b)
}

@test_concat_option tests @concat_option () -> void = {
    assert_eq(actual: concat_option(), expected: [Some(1), None, Some(2)])
}

// =============================================================================
// Arrangement dimension
// =============================================================================

// Chained: intermediate concat result becomes the receiver of the next concat.
@concat_chained () -> [int] = {
    let $a = [1, 2];
    let $b = [3, 4];
    let $c = [5, 6];
    a.concat(other: b).concat(other: c)
}

@test_concat_chained tests @concat_chained () -> void = {
    assert_eq(actual: concat_chained(), expected: [1, 2, 3, 4, 5, 6])
}

// Empty argument operand.
@concat_empty_arg () -> [int] = {
    let $a = [1, 2, 3];
    let $empty: [int] = [];
    a.concat(other: empty)
}

@test_concat_empty_arg tests @concat_empty_arg () -> void = {
    assert_eq(actual: concat_empty_arg(), expected: [1, 2, 3])
}

// Empty receiver operand.
@concat_empty_receiver () -> [int] = {
    let $empty: [int] = [];
    let $b = [1, 2, 3];
    empty.concat(other: b)
}

@test_concat_empty_receiver tests @concat_empty_receiver () -> void = {
    assert_eq(actual: concat_empty_receiver(), expected: [1, 2, 3])
}

// Literal receiver (fresh, unique).
@concat_literal_receiver () -> [int] = {
    let $b = [3, 4];
    [1, 2].concat(other: b)
}

@test_concat_literal_receiver tests @concat_literal_receiver () -> void = {
    assert_eq(actual: concat_literal_receiver(), expected: [1, 2, 3, 4])
}

// =============================================================================
// Uniqueness CLAMP — shared receiver forces the slow path on BOTH backends.
// Must remain leak-free: pins that the fix keeps the legitimate slow path
// correct, not merely that it restores the fast path.
// =============================================================================

@concat_shared_receiver () -> [int] = {
    let $a = [1, 2];
    let $first = a.concat(other: [3, 4]);
    let $second = a.concat(other: [5, 6]);
    first.concat(other: second)
}

@test_concat_shared_receiver tests @concat_shared_receiver () -> void = {
    assert_eq(actual: concat_shared_receiver(), expected: [1, 2, 3, 4, 1, 2, 5, 6])
}

// =============================================================================
// Slice-receiver CLAMP — a real seamless slice legitimately sets is_slice_cap
// and legitimately takes the slow path. Must produce the correct result and be
// leak-free: distinguishes the correct fix (cap loads correctly: true for a
// real slice) from a wrong "force fast path always" fix that would break this.
// =============================================================================

@concat_slice_receiver () -> [int] = {
    let $a = [10, 20, 30, 40];
    let $s = a.slice(start: 1, end: 3);
    let $b = [99];
    s.concat(other: b)
}

@test_concat_slice_receiver tests @concat_slice_receiver () -> void = {
    assert_eq(actual: concat_slice_receiver(), expected: [20, 30, 99])
}
