// COW (Copy-on-Write) behavioral equivalence tests for lists.
// Verifies that list mutations produce correct results and
// that shared owners are not affected by COW operations.

use std.testing { assert_eq }

// --- Unique owner (in-place fast path) ---

@push_unique () -> [int] = {
    let list = [1, 2, 3];
    let list = list.push(4);
    let list = list.push(5);
    list
}

@test_push_unique tests @push_unique () -> void = {
    assert_eq(actual: push_unique(), expected: [1, 2, 3, 4, 5])
}

@insert_unique () -> [int] = {
    [1, 3, 4].insert(1, 2)
}

@test_insert_unique tests @insert_unique () -> void = {
    assert_eq(actual: insert_unique(), expected: [1, 2, 3, 4])
}

@remove_unique () -> [int] = {
    [1, 2, 3, 4].remove(1)
}

@test_remove_unique tests @remove_unique () -> void = {
    assert_eq(actual: remove_unique(), expected: [1, 3, 4])
}

@set_unique () -> [int] = {
    [1, 2, 3].set(1, 99)
}

@test_set_unique tests @set_unique () -> void = {
    assert_eq(actual: set_unique(), expected: [1, 99, 3])
}

@reverse_unique () -> [int] = {
    [3, 1, 2].reverse()
}

@test_reverse_unique tests @reverse_unique () -> void = {
    assert_eq(actual: reverse_unique(), expected: [2, 1, 3])
}

@sort_unique () -> [int] = {
    [3, 1, 4, 1, 5].sort()
}

@test_sort_unique tests @sort_unique () -> void = {
    assert_eq(actual: sort_unique(), expected: [1, 1, 3, 4, 5])
}

// --- Shared owner (COW slow path) ---

@push_shared () -> ([int], [int]) = {
    let a = [1, 2, 3];
    let b = a;
    let b = b.push(4);
    (a, b)
}

@test_push_shared tests @push_shared () -> void = {
    let (original, modified) = push_shared();
    assert_eq(actual: original, expected: [1, 2, 3]);
    assert_eq(actual: modified, expected: [1, 2, 3, 4])
}

@insert_shared () -> ([int], [int]) = {
    let a = [1, 3];
    let b = a;
    let b = b.insert(1, 2);
    (a, b)
}

@test_insert_shared tests @insert_shared () -> void = {
    let (original, modified) = insert_shared();
    assert_eq(actual: original, expected: [1, 3]);
    assert_eq(actual: modified, expected: [1, 2, 3])
}

@remove_shared () -> ([int], [int]) = {
    let a = [1, 2, 3];
    let b = a;
    let b = b.remove(1);
    (a, b)
}

@test_remove_shared tests @remove_shared () -> void = {
    let (original, modified) = remove_shared();
    assert_eq(actual: original, expected: [1, 2, 3]);
    assert_eq(actual: modified, expected: [1, 3])
}

@set_shared () -> ([int], [int]) = {
    let a = [1, 2, 3];
    let b = a;
    let b = b.set(0, 99);
    (a, b)
}

@test_set_shared tests @set_shared () -> void = {
    let (original, modified) = set_shared();
    assert_eq(actual: original, expected: [1, 2, 3]);
    assert_eq(actual: modified, expected: [99, 2, 3])
}

@reverse_shared () -> ([int], [int]) = {
    let a = [3, 1, 2];
    let b = a;
    let b = b.reverse();
    (a, b)
}

@test_reverse_shared tests @reverse_shared () -> void = {
    let (original, modified) = reverse_shared();
    assert_eq(actual: original, expected: [3, 1, 2]);
    assert_eq(actual: modified, expected: [2, 1, 3])
}

@sort_shared () -> ([int], [int]) = {
    let a = [3, 1, 2];
    let b = a;
    let b = b.sort();
    (a, b)
}

@test_sort_shared tests @sort_shared () -> void = {
    let (original, modified) = sort_shared();
    assert_eq(actual: original, expected: [3, 1, 2]);
    assert_eq(actual: modified, expected: [1, 2, 3])
}

// --- Multi-fork (3+ references to same backing) ---

@multi_fork () -> ([int], [int], [int], [int]) = {
    let base = [1, 2, 3];
    let f1 = base.push(4);
    let f2 = base.push(5);
    let f3 = base.remove(0);
    (base, f1, f2, f3)
}

@test_multi_fork tests @multi_fork () -> void = {
    let (base, f1, f2, f3) = multi_fork();
    assert_eq(actual: base, expected: [1, 2, 3]);
    assert_eq(actual: f1, expected: [1, 2, 3, 4]);
    assert_eq(actual: f2, expected: [1, 2, 3, 5]);
    assert_eq(actual: f3, expected: [2, 3])
}

// --- Chained operations ---

@chained_ops () -> [int] = {
    [5, 3, 1, 4, 2].sort().reverse().push(0)
}

@test_chained_ops tests @chained_ops () -> void = {
    assert_eq(actual: chained_ops(), expected: [5, 4, 3, 2, 1, 0])
}

// --- Loop accumulation ---

@loop_push () -> [int] = {
    let xs: [int] = [];
    for i in 0..5 do {
        xs = xs.push(i);
    };
    xs
}

@test_loop_push tests @loop_push () -> void = {
    assert_eq(actual: loop_push(), expected: [0, 1, 2, 3, 4])
}

// --- Concat (+ operator) ---

@concat_unique () -> [int] = {
    [1, 2] + [3, 4]
}

@test_concat_unique tests @concat_unique () -> void = {
    assert_eq(actual: concat_unique(), expected: [1, 2, 3, 4])
}

@concat_shared () -> ([int], [int]) = {
    let a = [1, 2];
    let b = a;
    let c = b + [3, 4];
    (a, c)
}

@test_concat_shared tests @concat_shared () -> void = {
    let (original, concatenated) = concat_shared();
    assert_eq(actual: original, expected: [1, 2]);
    assert_eq(actual: concatenated, expected: [1, 2, 3, 4])
}

// --- Nested collections (element size > 8, alignment differs from size) ---

@nested_list_push () -> [[int]] = {
    let snapshots: [[int]] = [];
    let list: [int] = [];
    let i = 0;
    loop {
        if i >= 5 then break;
        snapshots = snapshots.push(list);
        list = list.push(i);
        i = i + 1;
    };
    snapshots
}

@test_nested_list_push tests @nested_list_push () -> void = {
    let snaps = nested_list_push();
    assert_eq(actual: snaps.len(), expected: 5);
    assert_eq(actual: snaps[0], expected: []);
    assert_eq(actual: snaps[1], expected: [0]);
    assert_eq(actual: snaps[2], expected: [0, 1]);
    assert_eq(actual: snaps[3], expected: [0, 1, 2]);
    assert_eq(actual: snaps[4], expected: [0, 1, 2, 3])
}

@nested_str_list_push () -> [[str]] = {
    let groups: [[str]] = [];
    groups = groups.push(["hello", "world"]);
    groups = groups.push(["foo"]);
    groups = groups.push([]);
    groups
}

@test_nested_str_list_push tests @nested_str_list_push () -> void = {
    let g = nested_str_list_push();
    assert_eq(actual: g.len(), expected: 3);
    assert_eq(actual: g[0], expected: ["hello", "world"]);
    assert_eq(actual: g[1], expected: ["foo"]);
    assert_eq(actual: g[2], expected: [])
}
