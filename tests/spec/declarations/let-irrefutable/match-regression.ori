// Axis 5 — Match-path regression guard.
// The fix is BindingPattern-only. Match patterns (MatchPattern) MUST remain
// unaffected — refutable list shapes are valid in match arms per
// Spec/15-patterns.md:276-281.

use std.testing { assert_eq }

// =============================================================================
// Match arm with refutable list pattern — still works
// =============================================================================

@test_match_list_two_heads_still_works tests _ () -> void = {
    let xs = [1, 2, 3];
    let result = match xs {
        [$a, $b, ..rest] -> a + b,
        _ -> 0,
    };
    assert_eq(actual: result, expected: 3)
}

// =============================================================================
// Match arm with multiple refutable shapes — still works
// =============================================================================

@test_match_exhaustive_three_arms_still_works tests _ () -> void = {
    let xs = [1, 2, 3];
    let result = match xs {
        [] -> 0,
        [$a] -> a,
        [$a, $b, ..rest] -> a + b,
    };
    assert_eq(actual: result, expected: 3)
}

// =============================================================================
// Match arm with guard on refutable list pattern — still works
// =============================================================================

@test_match_with_guards_still_works tests _ () -> void = {
    let xs = [3, 1];
    let result = match xs {
        [$a, $b] if a > b -> a,
        _ -> 0,
    };
    assert_eq(actual: result, expected: 3)
}
