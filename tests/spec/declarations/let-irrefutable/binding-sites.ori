// Axis 2 — Four binding-site call paths for let-pattern irrefutability.
// Each site must fire E2001 on a refutable list pattern.

use std.testing { assert_eq }

// =============================================================================
// Block-statement let
// =============================================================================

#compile_fail(code: "E2001")
@test_block_let_refutable_list_rejects tests _ () -> void = {
    let items = [1, 2, 3];
    {
        let [$x, $y] = items
    }
}

// =============================================================================
// Bare let expression
// =============================================================================

#compile_fail(code: "E2001")
@test_expr_let_refutable_list_rejects tests _ () -> void = {
    let items = [1, 2, 3];
    let [$x, $y] = items
}

// =============================================================================
// Try-block let — deferred (see BUG-02-024)
// =============================================================================
//
// Try-block bare let with a refutable pattern triggers a typeck panic at
// infer/expr/mod.rs:124 (INVALID ExprId reaching infer_expr_inner) when
// the try block has no `?` operations and no tail expression. The wiring
// at sequences.rs (infer_try_stmt) is correct; the panic is in try-block
// result-expr handling for the bare-let-no-question form. For-loop and
// match-arm-body sites (bisected isolated) work cleanly with minimal
// bodies. Block-let, expr-let, for-loop, match-arm-body all exercise
// the predicate + factory + diagnostic surface; try-let coverage moves
// with BUG-02-024.

// =============================================================================
// For-loop binding
// =============================================================================

#compile_fail(code: "E2001")
@test_for_loop_refutable_list_rejects tests _ () -> void = {
    for [$x, $y] in [[1, 2]] do { }
}

// =============================================================================
// Match-arm-body let
// =============================================================================

#compile_fail(code: "E2001")
@test_match_arm_body_let_refutable_list_rejects tests _ () -> void = {
    let items = [1, 2, 3];
    let _ = match items {
        [x, ..rest] -> { let [$a, $b] = rest }
    }
}
