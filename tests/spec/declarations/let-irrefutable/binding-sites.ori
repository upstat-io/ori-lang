// Axis 2 — Four binding-site call paths for let-pattern irrefutability.
// Each site must fire E2001 on a refutable list pattern.

use std.testing { assert_eq }

// =============================================================================
// Block-statement let
// =============================================================================

#compile_fail(code: "E2001")
@test_block_let_refutable_list_rejects tests _ () -> void = {
    let items = [1, 2, 3];
    {
        let [$x, $y] = items
    }
}

// =============================================================================
// Bare let expression
// =============================================================================

#compile_fail(code: "E2001")
@test_expr_let_refutable_list_rejects tests _ () -> void = {
    let items = [1, 2, 3];
    let [$x, $y] = items
}

// =============================================================================
// Try-block let
// =============================================================================

#compile_fail(code: "E2001")
@test_try_let_refutable_list_rejects tests _ () -> void = {
    let items = [1, 2, 3];
    let _ = try {
        let [$x, $y] = items
    }
}

// =============================================================================
// For-loop binding
// =============================================================================

#compile_fail(code: "E2001")
@test_for_loop_refutable_list_rejects tests _ () -> void = {
    let nested: [[int]] = [[1, 2], [3]];
    let mut count = 0;
    for [$x, $y] in nested do {
        count = count + x + y
    }
}

// =============================================================================
// Match-arm body let (exercises infer_block path via a different AST context)
// =============================================================================

#compile_fail(code: "E2001")
@test_match_arm_body_let_refutable_list_rejects tests _ () -> void = {
    let items = [1, 2, 3];
    let _ = match items {
        [] -> 0,
        [$x, ..rest] -> {
            let [$a, $b] = rest;
            x + a + b
        }
    }
}
