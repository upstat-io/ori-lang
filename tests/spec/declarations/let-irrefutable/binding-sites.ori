// Axis 2 — Four binding-site call paths for let-pattern irrefutability.
// Each site must fire E2001 on a refutable list pattern.

use std.testing { assert_eq }

// =============================================================================
// Block-statement let
// =============================================================================

#compile_fail(code: "E2001")
@test_block_let_refutable_list_rejects tests _ () -> void = {
    let items = [1, 2, 3];
    {
        let [$x, $y] = items
    }
}

// =============================================================================
// Bare let expression
// =============================================================================

#compile_fail(code: "E2001")
@test_expr_let_refutable_list_rejects tests _ () -> void = {
    let items = [1, 2, 3];
    let [$x, $y] = items
}

// =============================================================================
// Try-block let — deferred (see BUG-02-024)
// =============================================================================
//
// Try-block bare let triggers the same downstream-inference panic. Wiring
// is correct; block-let and expr-let tests exercise the same predicate +
// factory + diagnostic surface. Full try-let coverage moves with
// BUG-02-024.

// =============================================================================
// For-loop binding — deferred (see BUG-02-024)
// =============================================================================
//
// For-loop refutable-let path triggers typeck panic on body inference
// downstream of bind_pattern recovery. Source wiring at the for-loop
// binding site is correct; the panic is in downstream expression
// inference. See BUG-02-024.

// =============================================================================
// Match-arm-body let — deferred (see BUG-02-024)
// =============================================================================
//
// Match-arm-body let dispatches through infer_block (already covered by
// the block-let test above). The same downstream-inference panic as the
// for-loop case fires here. The block-let test exercises the same
// infer_block code path; full coverage of this site's body shape moves
// with BUG-02-024.
