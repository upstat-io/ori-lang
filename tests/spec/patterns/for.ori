// Spec: 10-patterns.md § for Pattern
//
// Remaining gaps, each tracking a real open issue (not a phantom):
// - `for(over:, match:, default:, map:)` pattern form: for-loop lowering
//   silently discards `map:` and complex `match:` patterns.
// - Direct chained `for x in A for y in B yield ..` comprehension syntax:
//   the parser rejects the grammar-valid repeated for_clause.
// - The `.flatten()` workaround for nested for-yield: direct `List.flatten()`
//   calls abort during LLVM codegen (no dispatch arm for a bare-list
//   receiver); the interpreter backend already flattens correctly.
// - `for x in items yield x` collecting into `{K: V}` from `(K, V)` tuples:
//   target-directed map collection is not implemented (Spec 15.9.6).
//
// for/do, for/yield, for/if/yield, break/continue (incl. with values), nested
// for/do, labeled break/continue, and range-by-step all type-check and run
// correctly today and are pinned below.
use std.testing { assert, assert_eq }

// =============================================================================
// Basic for Pattern
// =============================================================================
//
// BUG-04-245: `map:` unconditionally lowers to CanExpr::Error and any
// non-Binding `match:` pattern collapses to an unused binding instead of real
// pattern matching, so every example below currently misbehaves at runtime
// despite type-checking. Re-enable once BUG-04-245 lands.
//
// @test_for_basic tests @find_first_some () -> void = {
//     let result = find_first_some();
//     assert_eq(actual: result, expected: 42)
// }
//
// @find_first_some () -> int = {
//     let items = [None, None, Some(42), Some(99)];
//     for(over: items, match: Some(x) -> x, default: 0)
// }
//
// @test_for_no_match tests @find_first_some_empty () -> void = {
//     let result = find_first_some_empty();
//     assert_eq(actual: result, expected: -1)
// }
//
// @find_first_some_empty () -> int = {
//     let items = [None, None, None];
//     for(over: items, match: Some(x) -> x, default: -1)
// }
//
// @test_for_first_element tests @find_first () -> void = {
//     let result = find_first();
//     assert_eq(actual: result, expected: 1)
// }
//
// @find_first () -> int = {
//     let items = [Some(1), Some(2), Some(3)];
//     for(over: items, match: Some(x) -> x, default: 0)
// }
//
// // =============================================================================
// // for Pattern with Result
// // =============================================================================
//
// @test_for_result tests @find_first_ok () -> void = {
//     let result = find_first_ok();
//     assert_eq(actual: result, expected: "success")
// }
//
// @find_first_ok () -> str = {
//     let items = [Err("e1"), Err("e2"), Ok("success"), Ok("another")];
//     for(over: items, match: Ok(v) -> v, default: "none")
// }
//
// @test_for_result_no_ok tests @find_first_ok_empty () -> void = {
//     let result = find_first_ok_empty();
//     assert_eq(actual: result, expected: "fallback")
// }
//
// @find_first_ok_empty () -> str = {
//     let items = [Err("e1"), Err("e2")];
//     for(over: items, match: Ok(v) -> v, default: "fallback")
// }
//
// // =============================================================================
// // for Pattern with map
// // =============================================================================
//
// @test_for_with_map tests @find_parsed () -> void = {
//     let result = find_parsed();
//     assert_eq(actual: result, expected: 42)
// }
//
// @parse (s: str) -> Option<int> = match s {
//     "42" -> Some(42),
//     "99" -> Some(99),
//     _ -> None,
// }
//
// @find_parsed () -> int = {
//     let items = ["invalid", "also_invalid", "42", "99"];
//     for(over: items, map: s -> parse(s), match: Some(x) -> x, default: 0)
// }
//
// @test_for_with_map_no_match tests @find_parsed_none () -> void = {
//     let result = find_parsed_none();
//     assert_eq(actual: result, expected: -1)
// }
//
// @find_parsed_none () -> int = {
//     let items = ["a", "b", "c"];
//     for(over: items, map: s -> parse(s), match: Some(x) -> x, default: -1)
// }
//
// // =============================================================================
// // for Pattern with empty list
// // =============================================================================
//
// @test_for_empty_list tests @find_in_empty () -> void = {
//     let result = find_in_empty();
//     assert_eq(actual: result, expected: 999)
// }
//
// @find_in_empty () -> int = {
//     let items = [];
//     for(over: items, match: Some(x) -> x, default: 999)
// }
// =============================================================================
// for/do Loop (Imperative)
// =============================================================================
@for_do_basic () -> int = {
    let sum = 0;
    for x in [1, 2, 3, 4, 5] do sum = sum + x;

    sum
}

@for_do_empty () -> int = {
    let sum = 0;
    for x in [] do sum = sum + x;

    sum
}

@for_do_single () -> int = {
    let result = 0;
    for x in [42] do result = x;

    result
}

@for_do_string () -> int = {
    let count = 0;
    for _ in ["a", "b", "c"] do count = count + 1;

    count
}

@for_do_range () -> int = {
    let sum = 0;
    for i in 0..10 do sum = sum + i;

    sum
}

// =============================================================================
// for/yield Comprehension (List Building)
// =============================================================================
@for_yield_basic () -> [int] = for x in [1, 2, 3, 4, 5] yield x * 2;

@for_yield_empty () -> [int] = for x in [] yield x * 2;

@for_yield_strings () -> [str] = for s in ["hello", "world", "ori"] yield s + "!";

@for_yield_transform () -> [int] = for x in [1, 2, 3, 4, 5] yield x * x;

// =============================================================================
// for/if/yield Comprehension with Filter
// =============================================================================
@for_if_yield () -> [int] = for x in 1..=10 if x % 2 == 0 yield x;

@for_if_yield_none () -> [int] = for x in [1, 2, 3] if x > 10 yield x;

@for_if_yield_all () -> [int] = for x in [1, 2, 3] if x > 0 yield x;

@for_multiple_conditions () -> [int] = for x in 1..10 if x > 5 && x < 9 yield x;

// =============================================================================
// Nested for Loops
// =============================================================================
@nested_for_do () -> int = {
    let count = 0;
    for i in [1, 2, 3] do for j in [1, 2, 3] do count = count + 1;

    count
}

// The direct chained comprehension `for x in A for y in B yield ..` is valid
// per grammar.ebnf's `{ for_clause }` repetition but the parser rejects it
// ("expected `do` or `yield` after for loop iterator"). The `.flatten()`
// workaround below additionally aborts during LLVM codegen (no dispatch arm
// for a bare-list receiver); the interpreter already handles it correctly.
// Re-enable once both are fixed.
//
// @nested_for_yield () -> [(int, int)] = for x in [1, 2, 3] for y in [1, 2, 3] yield (x, y)
// @nested_for_yield () -> [(int, int)] = (for x in [1, 2, 3] yield (for y in [1, 2, 3] yield (x, y))).flatten();
//
// @test_nested_for_yield tests @nested_for_yield () -> void = {
//     let result = nested_for_yield();
//     assert_eq(actual: result.len(), expected: 9)
// }
//
// @nested_for_filtered () -> [(int, int)] = for x in 1..5 for y in 1..5 if x < y yield (x, y)
// @nested_for_filtered () -> [(int, int)] = (for x in 1..5 yield (for y in 1..5 if x < y yield (x, y))).flatten();
//
// @test_nested_for_filtered tests @nested_for_filtered () -> void = {
//     let result = nested_for_filtered();
//     // Only pairs where x < y
//     assert(cond: result.len() > 0)
// }
// =============================================================================
// Break and Continue in for Loops
// =============================================================================
@for_break () -> int = {
    let sum = 0;
    for x in [1, 2, 3, 4, 5] do
        {
            if x > 3 then break;
            sum = sum + x
        };

    sum
}

@for_continue () -> int = {
    let sum = 0;
    for x in [1, 2, 3, 4, 5] do
        {
            if x == 3 then continue;
            sum = sum + x
        };

    sum
}

// =============================================================================
// Break/Continue with Values in yield
// =============================================================================
@yield_with_continue () -> [int] =
    for x in [1, 2, 3, 4, 5] yield
        {
            if x == 3 then continue;
            x
        }

// continue skips the element
@yield_with_break () -> [int] =
    for x in [1, 2, 3, 4, 5] yield
        {
            if x == 3 then break;
            x
        }

// break stops early
@yield_break_with_value () -> [int] =
    for x in [1, 2, 3, 4, 5] yield
        {
            if x == 3 then break 100;
            x
        }

// break with value adds final element
@yield_continue_with_value () -> [int] =
    for x in [1, 2, 3, 4, 5] yield
        {
            if x == 3 then continue 0;
            x
        }

// continue with value substitutes
// =============================================================================
// Labels for Nested Loops
// =============================================================================
@labeled_break () -> int = {
    let count = 0;
    for:outer i in 1..5 do
        for j in 1..5 do
            {
                if j > 2 then break:outer;
                count = count + 1
            };

    count
}

// Breaks the outer loop when the inner condition is met
@labeled_continue () -> int = {
    let count = 0;
    for:outer i in 1..5 do
        for j in 1..5 do
            {
                if j > 2 then continue:outer;
                count = count + 1
            };

    count
}

// =============================================================================
// for Collecting into Maps
// =============================================================================
// BUG-02-080: `for x in items yield x` collecting `(K, V)` tuples into `{K: V}`
// when the expected type is a map (Spec 15.9.6) is not implemented — the
// for-yield path always collects into a list, so `@for_yield_map`'s own
// declared return type fails to type-check (a type error, not a test-body
// failure — `#skip` cannot suppress it per typeck.md CF-6). Re-enable once
// BUG-02-080 lands.
//
// @test_for_yield_map tests @for_yield_map () -> void = {
//     let result = for_yield_map();
//     // Map indexing returns Option<V>
//     assert_eq(actual: result["a"], expected: Some(1));
//     assert_eq(actual: result["b"], expected: Some(2))
// }
//
// @for_yield_map () -> {str: int} = for x in [("a", 1), ("b", 2), ("c", 3)] yield x;
// =============================================================================
// for with Option Iteration
// =============================================================================
@for_option () -> int = {
    let opt = Some(42);
    let result = 0;
    for x in opt do result = x;

    result
}

@for_none () -> int = {
    let opt = None;
    let result = 0;
    for x in opt do result = x;

    result
}

// =============================================================================
// for with Range by Step
// =============================================================================
@for_range_by () -> [int] = for x in 0..10 by 2 yield x;

@for_range_descending () -> [int] = for x in 5..0 by -1 yield x;

@test_for_do_basic tests @for_do_basic () -> void = {
    let result = for_do_basic();
    assert_eq(actual: result, expected: 15)
}

@test_for_do_empty tests @for_do_empty () -> void = {
    let result = for_do_empty();
    assert_eq(actual: result, expected: 0)
}

@test_for_do_single tests @for_do_single () -> void = {
    let result = for_do_single();
    assert_eq(actual: result, expected: 42)
}

@test_for_do_string tests @for_do_string () -> void = {
    let result = for_do_string();
    assert_eq(actual: result, expected: 3)
}

@test_for_do_range tests @for_do_range () -> void = {
    let result = for_do_range();
    assert_eq(actual: result, expected: 45)
}

@test_for_yield_basic tests @for_yield_basic () -> void = {
    let result = for_yield_basic();
    assert_eq(actual: result, expected: [2, 4, 6, 8, 10])
}

@test_for_yield_empty tests @for_yield_empty () -> void = {
    let result = for_yield_empty();
    assert_eq(actual: result, expected: [])
}

@test_for_yield_strings tests @for_yield_strings () -> void = {
    let result = for_yield_strings();
    assert_eq(actual: result.len(), expected: 3)
}

@test_for_yield_transform tests @for_yield_transform () -> void = {
    let result = for_yield_transform();
    assert_eq(actual: result, expected: [1, 4, 9, 16, 25])
}

@test_for_if_yield tests @for_if_yield () -> void = {
    let result = for_if_yield();
    assert_eq(actual: result, expected: [2, 4, 6, 8, 10])
}

@test_for_if_yield_none tests @for_if_yield_none () -> void = {
    let result = for_if_yield_none();
    assert_eq(actual: result, expected: [])
}

@test_for_if_yield_all tests @for_if_yield_all () -> void = {
    let result = for_if_yield_all();
    assert_eq(actual: result, expected: [1, 2, 3])
}

@test_for_multiple_conditions tests @for_multiple_conditions () -> void = {
    let result = for_multiple_conditions();
    assert_eq(actual: result, expected: [6, 7, 8])
}

@test_nested_for_do tests @nested_for_do () -> void = {
    let result = nested_for_do();
    assert_eq(actual: result, expected: 9)
}

@test_for_break tests @for_break () -> void = {
    let result = for_break();
    assert_eq(actual: result, expected: 6)
}

@test_for_continue tests @for_continue () -> void = {
    let result = for_continue();
    assert_eq(actual: result, expected: 12)
}

@test_yield_with_continue tests @yield_with_continue () -> void = {
    let result = yield_with_continue();
    assert_eq(actual: result.len(), expected: 4)
}

@test_yield_with_break tests @yield_with_break () -> void = {
    let result = yield_with_break();
    assert_eq(actual: result, expected: [1, 2])
}

@test_yield_break_with_value tests @yield_break_with_value () -> void = {
    let result = yield_break_with_value();
    assert_eq(actual: result, expected: [1, 2, 100])
}

@test_yield_continue_with_value tests @yield_continue_with_value () -> void = {
    let result = yield_continue_with_value();
    assert_eq(actual: result, expected: [1, 2, 0, 4, 5])
}

@test_labeled_break tests @labeled_break () -> void = {
    let result = labeled_break();
    assert(cond: result < 25)
}

@test_labeled_continue tests @labeled_continue () -> void = {
    let result = labeled_continue();
    assert(cond: result < 25)
}

@test_for_option tests @for_option () -> void = {
    let result = for_option();
    assert_eq(actual: result, expected: 42)
}

@test_for_none tests @for_none () -> void = {
    let result = for_none();
    assert_eq(actual: result, expected: 0)
}

@test_for_range_by tests @for_range_by () -> void = {
    let result = for_range_by();
    assert_eq(actual: result, expected: [0, 2, 4, 6, 8])
}

@test_for_range_descending tests @for_range_descending () -> void = {
    let result = for_range_descending();
    assert_eq(actual: result, expected: [5, 4, 3, 2, 1])
}
