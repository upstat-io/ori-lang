// Spec: 20-errors-and-panics.md § Catching Panics
// Tests for the catch(expr: ...) pattern that converts panics to Result<T, str>.

use std.testing { assert_eq, assert }

// =============================================================================
// catch — Panic Recovery
// =============================================================================

// catch returns Ok when expression succeeds
@test_catch_success tests @catch_success () -> void = {
    let result = catch(expr: 42);
    match result {
        Ok(v) -> assert_eq(actual: v, expected: 42),
        Err(_) -> panic(msg: "expected Ok")
    }
}

@catch_success () -> int = 42;

// catch returns Err when expression panics
@test_catch_panic tests @catch_panic () -> void = {
    let result = catch(expr: panic(msg: "test error"));
    match result {
        Err(_) -> (),
        Ok(_) -> panic(msg: "expected Err")
    }
}

@catch_panic () -> int = 1;

// catch captures panic message
@test_catch_message tests @catch_message () -> void = {
    let result = catch(expr: panic(msg: "specific error"));
    match result {
        Err(m) -> assert_eq(
            actual: m,
            expected: "specific error",
        ),
        Ok(_) -> panic(msg: "expected Err")
    }
}

@catch_message () -> str = {
    let result = catch(expr: panic(msg: "specific error"));
    match result {
        Err(m) -> m,
        Ok(_) -> "no error"
    }
}

// catch captures division by zero
@test_catch_div_zero tests @catch_div_zero () -> void = {
    let result = catch(expr: 1 / 0);
    match result {
        Err(_) -> (),
        Ok(_) -> panic(msg: "expected Err from div by zero")
    }
}

@catch_div_zero () -> int = 1;

// catch wraps successful value in Ok
@test_catch_ok_value tests @catch_ok_value () -> void = {
    let result = catch(expr: 10 + 20);
    match result {
        Ok(v) -> assert_eq(
            actual: v,
            expected: 30,
        ),
        Err(_) -> panic(msg: "expected Ok")
    }
}

@catch_ok_value () -> int = 10 + 20;

// catch works with string expressions
@test_catch_string tests @catch_string () -> void = {
    let result = catch(expr: "hello" + " world");
    match result {
        Ok(v) -> assert_eq(actual: v, expected: "hello world"),
        Err(_) -> panic(msg: "expected Ok")
    }
}

@catch_string () -> str = "hello" + " world";

// catch propagates non-panic errors (ControlAction) unchanged
// Nested catch: inner catches inner panic, outer catches outer panic
@test_catch_nested tests @catch_nested () -> void = {
    let outer = catch(
        expr: {
            let inner = catch(expr: panic(msg: "inner"));
            match inner {
                Err(m) -> assert_eq(actual: m, expected: "inner"),
                Ok(_) -> panic(msg: "expected inner Err")
            }
        },
    );
    match outer {
        Ok(_) -> (),
        Err(m) -> panic(msg: "outer should be Ok, got: " + m)
    }
}

@catch_nested () -> int = 1;

// =============================================================================
// catch — May-Panic Builtin Catchability (parity: eval == AOT)
// =============================================================================

// catch captures expect on None with the user message
@test_catch_expect_none tests @catch_expect_none () -> void = {
    let opt: Option<int> = None;
    let result = catch(expr: opt.expect(msg: "expect-none caught message exceeds sso"));
    match result {
        Err(m) -> assert_eq(actual: m, expected: "expect-none caught message exceeds sso"),
        Ok(_) -> panic(msg: "expected Err from expect on None")
    }
}

@catch_expect_none () -> int = 1;

// catch captures unwrap on None
@test_catch_unwrap_none tests @catch_unwrap_none () -> void = {
    let opt: Option<int> = None;
    let result = catch(expr: opt.unwrap());
    match result {
        Err(_) -> (),
        Ok(_) -> panic(msg: "expected Err from unwrap on None")
    }
}

@catch_unwrap_none () -> int = 1;

// catch captures Result.unwrap on Err
@test_catch_result_unwrap_err tests @catch_result_unwrap_err () -> void = {
    let r: Result<int, str> = Err("boom");
    let result = catch(expr: r.unwrap());
    match result {
        Err(_) -> (),
        Ok(_) -> panic(msg: "expected Err from unwrap on Err")
    }
}

@catch_result_unwrap_err () -> int = 1;

// catch captures Result.unwrap_err on Ok
@test_catch_unwrap_err_on_ok tests @catch_unwrap_err_on_ok () -> void = {
    let r: Result<int, str> = Ok(5);
    let result = catch(expr: r.unwrap_err());
    match result {
        Err(_) -> (),
        Ok(_) -> panic(msg: "expected Err from unwrap_err on Ok")
    }
}

@catch_unwrap_err_on_ok () -> int = 1;

// catch captures list index out of bounds
@test_catch_index_oob tests @catch_index_oob () -> void = {
    let xs = [1, 2, 3];
    let result = catch(expr: xs[7]);
    match result {
        Err(_) -> (),
        Ok(_) -> panic(msg: "expected Err from index OOB")
    }
}

@catch_index_oob () -> int = 1;

// catch returns Ok for in-bounds index (hot path unchanged)
@test_catch_index_inbounds tests @catch_index_inbounds () -> void = {
    let xs = [10, 20, 30];
    let result = catch(expr: xs[1]);
    match result {
        Ok(v) -> assert_eq(actual: v, expected: 20),
        Err(_) -> panic(msg: "expected Ok for in-bounds index")
    }
}

@catch_index_inbounds () -> int = 1;

// nested catch: inner catch captures the builtin expect panic
@test_catch_nested_inner_expect tests @catch_nested_inner_expect () -> void = {
    let outer = catch(
        expr: {
            let opt: Option<int> = None;
            let inner = catch(expr: opt.expect(msg: "inner expect message beyond sso width"));

            match inner {
                Err(_) -> 7,
                Ok(_) -> 3
            }
        },
    );
    match outer {
        Ok(v) -> assert_eq(actual: v, expected: 7),
        Err(_) -> panic(msg: "outer should be Ok")
    }
}

@catch_nested_inner_expect () -> int = 1;
