// NEGATIVE PIN — cross-iteration use-after-`drop_early` (E2054).
// The loop body uses `s` then consumes it; on iteration N+1 the use reads
// memory reclaimed in iteration N. Typeck rejects with E2054 (the two-pass
// loop-carried consumed-set catches the cross-iteration use-after-free).
//
// Spec: 13-variables.md §13.7 (Variable Lifetime).

#compile_fail(code: "E2054", message: "after `drop_early` consumed it")
@drop_early_use_after_consume_loop_rejected tests @_anchor () -> void = {
    let $s = "hello";
    for i in 0..3 do {
        print(msg: s);
        drop_early(value: s);
    };
    ()
}

@_anchor () -> bool = true;
