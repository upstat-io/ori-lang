// NEGATIVE PIN — use-after-`drop_early` inside a template-literal interpolation (E2054).
// `` `{s}` `` interpolation is a USE of `s`; after `drop_early` consumed `s` it
// reads reclaimed memory. The validator must descend template-literal parts.
//
// Spec: 13-variables.md §13.7 (Variable Lifetime).

#compile_fail(code: "E2054", message: "after `drop_early` consumed it")
@drop_early_use_after_consume_template_rejected tests @_anchor () -> void = {
    let $s = "hello";
    drop_early(value: s);
    let $m = `value: {s}`;
    ()
}

@_anchor () -> bool = true;
