// Apply-alias Conditional shape (multi-param path-conditional alias) over str
// elements — interpreter parity sibling of the AOT conditional_str cell. Every
// candidate (a, b) is an Owned arg; the un-chosen one is released, the chosen
// one survives through the alias class.

use std.testing { assert_eq };

@select<T> (pick_first: bool, a: T, b: T) -> T = if pick_first then a else b;

@chosen_len () -> int = {
    let x = "first choice";
    let y = "second";
    let chosen = select(pick_first: true, a: x, b: y);
    chosen.len()
}

@test_apply_alias_conditional_str_selects_first tests @chosen_len () -> void = {
    let n = chosen_len();
    assert_eq(actual: n, expected: 12)
};
