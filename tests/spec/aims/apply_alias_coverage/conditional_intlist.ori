// Apply-alias Conditional shape (multi-param path-conditional alias) over
// [int] elements — interpreter parity sibling of the AOT conditional_intlist
// cell.

use std.testing { assert_eq };

@select<T> (pick_first: bool, a: T, b: T) -> T = if pick_first then a else b;

@chosen_len () -> int = {
    let x = [1, 2, 3, 4];
    let y = [9, 8];
    let chosen = select(pick_first: false, a: x, b: y);
    chosen.len()
}

@test_apply_alias_conditional_intlist_selects_second tests @chosen_len () -> void = {
    let n = chosen_len();
    assert_eq(actual: n, expected: 2)
};
