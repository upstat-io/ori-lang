// Apply-alias Conditional shape (multi-param path-conditional alias) over
// Option<str> elements — interpreter parity sibling of the AOT
// conditional_option_str cell.

use std.testing { assert_eq };

@select<T> (pick_first: bool, a: T, b: T) -> T = if pick_first then a else b;

@chosen_len () -> int = {
    let x = Some("alpha");
    let y = Some("beta value");
    let chosen = select(pick_first: true, a: x, b: y);
    match chosen {
        Some(s) -> s.len(),
        None -> 0,
    }
}

@test_apply_alias_conditional_option_str_selects_first tests @chosen_len () -> void = {
    let n = chosen_len();
    assert_eq(actual: n, expected: 5)
};
