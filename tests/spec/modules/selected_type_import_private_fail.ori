// Spec: 18-modules.md § Imports — selected type import (BUG-02-101)
//
// Negative pin: a selected import of a NON-pub type is rejected as a private
// access, mirroring the constant-import private path. FAILS on the unfixed
// compiler (the private type falls into the function bucket and reports
// "function 'Hidden' not found" — no "private" wording); after the fix the type
// namespace is consulted and the visibility check emits a private-access error.

use std.testing { assert_eq }
use "./selected_type_import_lib" { Hidden }

#compile_fail(code: "E2003", message: "private")
@test_private_type_import_rejected tests _ () -> void = {
    assert_eq(actual: 1, expected: 1)
}
