// Spec: 18-modules.md § Imports
// Grammar: import_item = ... | "$" identifier .
//
// Tests for importing evaluated constant/config values using the $ prefix.

use std.testing { assert_eq }

use "../use_imports" { $default_timeout }

@test_const_import tests _ () -> void = {
    assert_eq(actual: $default_timeout, expected: 30)
}
