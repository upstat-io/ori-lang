// Spec: grammar.ebnf `type = type_path [ type_args ]`, `type_path = identifier { "." identifier }`
//
// Generic arguments bind to the terminal segment of a module-qualified type
// path, so `alias.Boxed<int>` is a well-formed annotation. Parsing the args
// before the dotted path is consumed leaves `<` unconsumed and rejects the
// whole annotation, so this pins the argument as both parsed AND applied: the
// type argument must survive to the point where `Boxed<int>` and `Boxed<str>`
// are distinct types, on BOTH backends.

use std.testing { assert_eq }
use "../struct_lib" as geom

@helper () -> int = 42;

// Qualified generic in parameter position.
@unwrap_int (b: geom.Boxed<int>) -> int = b.item;

// Qualified generic in return position.
@make_int () -> geom.Boxed<int> = geom.Boxed { item: 9 };

// Qualified generic at a second instantiation, proving the argument is carried.
@make_str () -> geom.Boxed<str> = geom.Boxed { item: "carried" };

@test_qualified_generic_round_trips tests @helper () -> void = {
    let b = make_int();

    assert_eq(actual: unwrap_int(b: b), expected: 9)
}

@test_qualified_generic_annotation_in_let tests @helper () -> void = {
    let $b: geom.Boxed<int> = geom.Boxed { item: 4 };

    assert_eq(actual: b.item, expected: 4)
}

@test_qualified_generic_distinct_arguments tests @helper () -> void = {
    let s = make_str();

    assert_eq(actual: s.item, expected: "carried")
}
