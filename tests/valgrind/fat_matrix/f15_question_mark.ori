// Valgrind fat matrix: F15 — ? propagation with fat pointer types.
// Verifies early return cleanup and Option/Result type handling.

@get_length (opt: Option<str>) -> Option<int> = {
    let s = opt?;
    Some(s.length())
}

@get_list_len (opt: Option<[int]>) -> Option<int> = {
    let xs = opt?;
    Some(xs.length())
}

@chain_options (a: Option<int>, b: Option<int>) -> Option<int> = {
    let x = a?;
    let y = b?;
    Some(x + y)
}

@main () -> int = {
    // T4: Option<str> Some with ?
    let ok1 = match get_length(opt: Some("hello")) {
        Some(n) -> n == 5,
        None -> false,
    };

    // T16: Option<str> None with ?
    let none_str: Option<str> = None;
    let ok2 = match get_length(opt: none_str) {
        Some(_) -> false,
        None -> true,
    };

    // T6: Option<[int]> Some with ?
    let ok3 = match get_list_len(opt: Some([1, 2, 3])) {
        Some(n) -> n == 3,
        None -> false,
    };

    // Chain multiple ? with fat values in scope
    let ok4 = match chain_options(a: Some(10), b: Some(20)) {
        Some(n) -> n == 30,
        None -> false,
    };

    // ? on None — cleanup with fat value in scope
    let ok5 = match chain_options(a: Some(10), b: None) {
        Some(_) -> false,
        None -> true,
    };

    if ok1 && ok2 && ok3 && ok4 && ok5
        then 0 else 1
}
