// Valgrind fat matrix: F09 — Accumulating fat values across loop iterations.
// Verifies phi node RC correctness and mutable bindings with fat types.

type Named = { name: str, id: int }

@main () -> int = {
    // Scalar accumulation from fat elements
    let total = 0;
    for s in ["hello", "world", "test"] do {
        total = total + s.length();
    };
    let ok1 = total == 14;

    // List length accumulation
    let total2 = 0;
    for xs in [[1, 2], [3, 4, 5], [6]] do {
        total2 = total2 + xs.length();
    };
    let ok2 = total2 == 6;

    // Map value accumulation
    let total3 = 0;
    let m = {"a": 10, "b": 20, "c": 30};
    for entry in m do {
        let (k, v) = entry;
        total3 = total3 + v;
    };
    let ok3 = total3 == 60;

    // Function calls on fat values in loop
    let total4 = 0;
    let structs = [Named { name: "alice", id: 1 }, Named { name: "bob", id: 2 }];
    for n in structs do {
        total4 = total4 + n.name.length() + n.id;
    };
    let ok4 = total4 == 11;

    if ok1 && ok2 && ok3 && ok4
        then 0 else 1
}
