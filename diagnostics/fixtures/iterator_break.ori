// Diagnostic fixture: iterator early exit and cleanup.
// Exercises iterator drop, remaining element cleanup on break,
// continue skip semantics — the #1 ARC debugging pain point.

@main () -> int = {
    // Full iteration (no break) — baseline RC balance
    let total1 = 0;
    for s in ["alpha", "beta", "gamma"] do {
        total1 = total1 + s.length();
    };
    let ok1 = total1 == 14;

    // Break on first element — all remaining must be dropped
    let count1 = 0;
    for s in ["hello", "world", "test"] do {
        if s == "hello" then break;
        count1 = count1 + 1;
    };
    let ok2 = count1 == 0;

    // Break on middle element
    let count2 = 0;
    for s in ["one", "two", "three", "four"] do {
        if s == "three" then break;
        count2 = count2 + 1;
    };
    let ok3 = count2 == 2;

    // Continue skipping elements — RC must handle skipped values
    let total2 = 0;
    for s in ["hi", "hello", "ok", "world"] do {
        if s.length() <= 2 then continue;
        total2 = total2 + s.length();
    };
    let ok4 = total2 == 10;

    // Break with inner fat value in scope — must drop inner + remaining
    let result = 0;
    for i in [1, 2, 3, 4, 5] do {
        let inner_str = "abcdefghijklmnopqrstuvwxyz1234";
        if i == 3 then break;
        result = result + inner_str.length();
    };
    let ok5 = result == 60;

    // Continue with inner fat value in scope
    let result2 = 0;
    for i in [1, 2, 3, 4, 5] do {
        let inner_list = [10, 20, 30];
        if i == 3 then continue;
        result2 = result2 + inner_list.length();
    };
    let ok6 = result2 == 12;

    if ok1 && ok2 && ok3 && ok4 && ok5 && ok6
        then 0 else 1
}
