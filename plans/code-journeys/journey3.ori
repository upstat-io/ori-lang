// Journey 3: "I am recursive"
// Features: recursion, equality (==), boolean (&&), division
// Expected: fib(10) + gcd(48, 18) = 55 + 6 = 61

@fib (n: int) -> int =
    if n <= 1 then n
    else fib(n - 1) + fib(n - 2);

@gcd (a: int, b: int) -> int =
    if b == 0 then a
    else gcd(b, a % b);

@main () -> int = {
    let f = fib(10);        // = 55
    let g = gcd(48, 18);    // = 6
    f + g                   // = 61
}
