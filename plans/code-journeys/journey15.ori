// Journey 15: COW Map Operations
// Tests: map creation, insert (COW in-place when unique),
// lookup, length, iteration over map entries
// Expected: 3 + 10 + 20 + 30 = 63
// map.length() after 3 inserts = 3
// sum of values: 10 + 20 + 30 = 60
// total = 63

@main () -> int = {
    let m = {"a": 10, "b": 20};
    let m = m.insert(key: "c", value: 30);
    let $size = m.length();

    let total = 0;
    for entry in m do {
        total += entry.1;
    };

    total + size
}
