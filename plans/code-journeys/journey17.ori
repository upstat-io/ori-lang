// Journey 17: COW Slice + Combined Operations
// Tests: list slicing (seamless zero-copy), string substring,
// and chained COW operations across multiple collection types
// Expected: slice_len + sub_len + chain_len = 2 + 3 + 5 = 10

@main () -> int = {
    let $nums = [10, 20, 30, 40, 50];
    let $slice = nums.take(count: 2);
    let slice_sum = 0;
    for x in slice do {
        slice_sum += x;
    };
    // slice_sum = 10 + 20 = 30... too big for exit code
    // Use length-based checks instead
    let $slice_len = slice.length();

    let $greeting = "hello world";
    let $sub = greeting.substring(start: 0, end: 3);
    let $sub_len = sub.length();

    let chain = [1, 2, 3];
    let chain = chain.push(4);
    let chain = chain.push(5);
    let $chain_len = chain.length();

    slice_len + sub_len + chain_len
}
